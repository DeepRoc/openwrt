config 'global'
	option	anon_swap	'0'
	option	anon_mount	'0'
	option	auto_swap	'1'
	option	auto_mount	'1'
	option	delay_root	'5'
	option	check_fs	'0'

config 'mount'
	option	target	'/boot'
        option  label   'kernel'
	option	enabled	'0'

config 'mount'
	option	target	'/overlay'
        option  label   'overlay'
        option  fstype  'btrfs'
        option  options 'compress=zstd'
	option	enabled	'1'
