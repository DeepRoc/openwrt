diff --git a/drivers/usb/typec/tcpm/fusb302.c b/drivers/usb/typec/tcpm/fusb302.c
index 5b1f2750cfc3..63a0bdcdd420 100644
--- a/drivers/usb/typec/tcpm/fusb302.c
+++ b/drivers/usb/typec/tcpm/fusb302.c
@@ -1343,36 +1343,52 @@ static int fusb302_handle_togdone_src(struct fusb302_chip *chip,
 	if (ret < 0)
 		return ret;
 
-	/* determine polarity based on the status of both pins */
-	if (cc1 == TYPEC_CC_RD &&
-			(cc2 == TYPEC_CC_OPEN || cc2 == TYPEC_CC_RA)) {
-		cc_polarity = TYPEC_POLARITY_CC1;
-	} else if (cc2 == TYPEC_CC_RD &&
-		    (cc1 == TYPEC_CC_OPEN || cc1 == TYPEC_CC_RA)) {
+	if (cc1 == TYPEC_CC_OPEN && cc2 == TYPEC_CC_OPEN) {
+		fusb302_log(chip, "CC lines open during togdone, restarting toggling");
+		return fusb302_set_toggling(chip, toggling_mode);
+	}
+
+	/* 2. Resolve polarity based on which CC line holds Rd or Ra */
+	if (cc2 == TYPEC_CC_RD || (cc1 == TYPEC_CC_RA && cc2 == TYPEC_CC_RD) ||
+	    (cc1 == TYPEC_CC_OPEN && cc2 == TYPEC_CC_RA)) {
+		/* REVERSED orientation */
 		cc_polarity = TYPEC_POLARITY_CC2;
+		cc1 = TYPEC_CC_OPEN;
+		cc2 = TYPEC_CC_RD;
+	} else if (cc1 == TYPEC_CC_RD || (cc1 == TYPEC_CC_RD && cc2 == TYPEC_CC_RA) ||
+		   (cc1 == TYPEC_CC_RA && cc2 == TYPEC_CC_OPEN)) {
+		/* NORMAL orientation */
+		cc_polarity = TYPEC_POLARITY_CC1;
+		cc1 = TYPEC_CC_RD;
+		cc2 = TYPEC_CC_OPEN;
 	} else {
+		/* Catch-all for ambiguous transient noise -> restart toggling */
 		fusb302_log(chip, "unexpected CC status cc1=%s, cc2=%s, restarting toggling",
-			    typec_cc_status_name[cc1],
-			    typec_cc_status_name[cc2]);
+			    typec_cc_status_name[cc1], typec_cc_status_name[cc2]);
 		return fusb302_set_toggling(chip, toggling_mode);
 	}
-	/* set polarity and pull_up, pull_down */
+
 	ret = fusb302_set_cc_polarity_and_pull(chip, cc_polarity, true, false);
 	if (ret < 0) {
 		fusb302_log(chip, "cannot set cc polarity %s, ret=%d",
 			    cc_polarity_name[cc_polarity], ret);
 		return ret;
 	}
-	/* update tcpm with the new cc value */
+
 	if ((chip->cc1 != cc1) || (chip->cc2 != cc2)) {
 		chip->cc1 = cc1;
 		chip->cc2 = cc2;
 		tcpm_cc_change(chip->tcpm_port);
 	}
+
 	/* set MDAC to Rd threshold, and unmask I_COMP for unplug detection */
 	ret = fusb302_i2c_write(chip, FUSB_REG_MEASURE, rd_mda);
 	if (ret < 0)
 		return ret;
+
+	/* Let CC line voltage settle before unmasking comparator interrupt */
+	usleep_range(10000, 15000);
+
 	/* unmask comp_chng interrupt */
 	ret = fusb302_i2c_clear_bits(chip, FUSB_REG_MASK,
 				     FUSB_REG_MASK_COMP_CHNG);
