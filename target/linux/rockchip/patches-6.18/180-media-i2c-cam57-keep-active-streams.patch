Subject: [PATCH] media: i2c: cam57: stop the sensor only after the last stream

CAM57 RGB and IR share the sensor streaming register. Closing
either capture currently stops the sensor even when the other
stream is still enabled.

Track the enabled stream mask and stop the sensor only when it
becomes empty. Update the mask only after successful sensor
operations so failed starts or stops do not leave the driver state
inconsistent with the V4L2 core.

Preserve the existing sensor initialization, formats, routing and controls.

---
diff --git a/drivers/media/i2c/econ-cam57.c b/drivers/media/i2c/econ-cam57.c
--- a/drivers/media/i2c/econ-cam57.c
+++ b/drivers/media/i2c/econ-cam57.c
@@ -1298,6 +1298,7 @@
 	struct v4l2_ctrl_handler ctrls;
 	const struct cam57_mode *current_mode;
 	u16 gain, gain_ir;
+	u64 enabled_streams;
 	bool streaming;
 
 	/* Deferred initialization work and status flags */
@@ -2200,6 +2201,7 @@
 		cam->streaming = true;
 	}
 
+	cam->enabled_streams |= streams_mask;
 	return 0;
 }
 
@@ -2208,12 +2210,18 @@
 				  u32 pad, u64 streams_mask)
 {
 	struct cam57_dev *cam = to_cam57(sd);
-
-	if (cam->streaming) {
-		cam57_sensor_write_reg(cam, 0x0100, 0x00);
+	u64 enabled_streams = cam->enabled_streams & ~streams_mask;
+	int ret;
+
+	/* RGB and IR share the sensor's global streaming control. */
+	if (!enabled_streams && cam->streaming) {
+		ret = cam57_sensor_write_reg(cam, 0x0100, 0x00);
+		if (ret)
+			return ret;
 		cam->streaming = false;
 	}
 
+	cam->enabled_streams = enabled_streams;
 	return 0;
 }
 
