+/* -----------------------------------------------------------------------------
+ * Driver Probe & Runtime PM
+ * -----------------------------------------------------------------------------
+ */
+
+static const struct regmap_config ox05b1s_regmap_config = {
+	.reg_bits = 16,
+	.val_bits = 8,
+	.max_register = 0xffff,
+};
+
+static int ox05b1s_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct ox05b1s_dev *sensor;
+	int ret;
+
+	sensor = devm_kzalloc(dev, sizeof(*sensor), GFP_KERNEL);
+	if (!sensor)
+		return -ENOMEM;
+
+	sensor->client = client;
+
+	sensor->regmap = devm_regmap_init_i2c(client, &ox05b1s_regmap_config);
+	if (IS_ERR(sensor->regmap))
+		return PTR_ERR(sensor->regmap);
+	/* Get MFP4 Reset GPIO (mapped from MAX96717 gpio controller in DT) */
+	sensor->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(sensor->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(sensor->reset_gpio),
+				     "Failed to get reset GPIO\n");
+
+        ret = oax4000_power_on(sensor);
+        if (ret)
+		return ret;
+
+	v4l2_i2c_subdev_init(&sensor->sd, client, &ox05b1s_subdev_ops);
+	sensor->sd.internal_ops = &ox05b1s_internal_ops;
+	sensor->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+
+        /* Enable Multiplexed Streams flag for RGB/IR streams */
+	sensor->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE | V4L2_SUBDEV_FL_STREAMS;
+
+	/* Initialize internal subdevice state for multi-stream support */
+	if (ret)
+		goto err_power_off;
+	sensor->pad.flags = MEDIA_PAD_FL_SOURCE;
+	sensor->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+
+	ret = ox05b1s_init_controls(sensor);
+        if (ret) {
+		dev_err(dev, "Failed to initialize V4L2 controls: %d\n", ret);
+		goto err_entity_cleanup;
+	}
+
+	/* Bind control handler to subdevice */
+	sensor->sd.ctrl_handler = &sensor->ctrls;
+
+	ret = media_entity_pads_init(&sensor->sd.entity, 1, &sensor->pad);
+	if (ret)
+		return ret;
+
+	ret = v4l2_subdev_init_finalize(&sensor->sd);
+	if (ret)
+		goto err_power_off;
+
+	ret = v4l2_async_register_subdev(&sensor->sd);
+	if (ret)
+		goto err_subdev_cleanup;
+
+	dev_info(dev, "OX05B1S ISP / STURDeCAM57 probed successfully\n");
+	return 0;
+
+err_subdev_cleanup:
+	v4l2_subdev_cleanup(&sensor->sd);
+err_power_off:
+	oax4000_power_off(sensor);
+err_entity_cleanup:
+	media_entity_cleanup(&sensor->sd.entity);
+	return ret;
+}
+
+static void ox05b1s_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct ox05b1s_dev *sensor = to_ox05b1s(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	oax4000_power_off(sensor);
+	media_entity_cleanup(&sd->entity);
+}
+
+static const struct of_device_id ox05b1s_of_match[] = {
+	{ .compatible = "ovti,ox05b1s" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, ox05b1s_of_match);
+
+static struct i2c_driver ox05b1s_i2c_driver = {
+	.driver = {
+		.name = "ox05b1s",
+		.of_match_table = ox05b1s_of_match,
+	},
+	.probe = ox05b1s_probe,
+	.remove = ox05b1s_remove,
+};
+module_i2c_driver(ox05b1s_i2c_driver);
+
+MODULE_DESCRIPTION("OmniVision OAX4000/OX05B1S ISP Mainline Driver");
+MODULE_LICENSE("GPL");
