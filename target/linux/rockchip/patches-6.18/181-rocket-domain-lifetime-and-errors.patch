+	mutex_lock(&rdev->pm_lock);
+	if (rocket_active_hz && !rdev->active_cores) {
+		err = rocket_enter_active(core);
+		if (err) {
+			/* Restore the GPLL path before genpd can turn off registers. */
+			int rollback = rocket_enter_idle(core);
+
+			dev_err(dev, "NPU voltage/rate change failed %d, rollback %d\n", err, rollback);
+			if (rollback) {
+				/* Returning an error here would let genpd power off an
+				 * unconfirmed PVTPLL state. Keep this core powered,
+				 * reject jobs, and prevent unload until suspend can
+				 * successfully restore the idle clock.
+				 */
+				rdev->clock_fault = err;
+				__module_get(THIS_MODULE);
+				rdev->clock_fault_pinned = true;
+				rdev->active_cores |= BIT(index);
+				mutex_unlock(&rdev->pm_lock);
+				return 0;
+			}
+			mutex_unlock(&rdev->pm_lock);
+			clk_bulk_disable_unprepare(ARRAY_SIZE(core->clks), core->clks);
+			return err;
+		}
+	}
+	rdev->active_cores |= BIT(index);
+	mutex_unlock(&rdev->pm_lock);
 	return 0;
 }
 
