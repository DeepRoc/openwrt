 static struct platform_device *drm_dev;
 static struct rocket_device *rdev;
 
+/* Opt-in shared voltage/frequency policy; zero preserves the DT state. */
+unsigned long rocket_active_hz;
+module_param_named(active_hz, rocket_active_hz, ulong, 0444);
+MODULE_PARM_DESC(active_hz, "0 for DT state, 600000000 Hz / 800 mV, or 800000000 Hz / 850 mV");
+
+/* Called only while genpd still supplies power and the register-access clocks. */
+static int rocket_set_powered_rate(struct rocket_core *core, unsigned long hz)
+{
+	struct clk *clk = core->clks[ROCKET_NPU_CLK].clk;
+	unsigned long actual;
+	int ret;
+
+	if (hz != ROCKET_IDLE_HZ && regulator_get_voltage(core->rdev->supply) != core->rdev->active_uv)
+		return -EINVAL;
+	ret = clk_set_rate(clk, hz);
+	if (ret)
+		return ret;
+	actual = clk_get_rate(clk);
+	if (actual != hz) {
+		dev_err(core->dev, "NPU clock requested %lu but reports %lu\n", hz, actual);
+		return -EIO;
+	}
+	return 0;
+}
+
+/* regulator_set_voltage waits for the regulator driver's ramp/settling time. */
+static int rocket_set_voltage(struct rocket_core *core, unsigned long uv)
+{
+	struct regulator *supply = core->rdev->supply;
+	int ret, actual;
+
+	ret = regulator_set_voltage(supply, uv, uv);
+	if (ret)
+		return ret;
+	actual = regulator_get_voltage(supply);
+	if (actual != uv) {
+		dev_err(core->dev, "NPU voltage requested %lu but reports %d\n", uv, actual);
+		return actual < 0 ? actual : -EIO;
+	}
+	return 0;
+}
+
+/* All transitions are serialized by pm_lock, while genpd is still powered. */
+static int rocket_enter_active(struct rocket_core *core)
+{
+	int ret = rocket_set_voltage(core, core->rdev->active_uv);
+
+	if (ret)
+		return ret;
+	return rocket_set_powered_rate(core, rocket_active_hz);
+}
+
+static int rocket_enter_idle(struct rocket_core *core)
+{
+	int ret = rocket_set_powered_rate(core, ROCKET_IDLE_HZ);
+
+	if (ret)
+		return ret; /* Never lower voltage before confirming the idle clock. */
+	return rocket_set_voltage(core, core->rdev->idle_uv);
+}
+
 static void
 rocket_iommu_domain_destroy(struct kref *kref)
 {
 	struct rocket_iommu_domain *domain = container_of(kref, struct rocket_iommu_domain, kref);
 
+	drm_mm_takedown(&domain->mm);
+	mutex_destroy(&domain->mm_lock);
 	iommu_domain_free(domain->domain);
 	domain->domain = NULL;
 	kfree(domain);
+	module_put(THIS_MODULE);
 }
 
