+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Driver for eCon STURDeCAM31 containing Sony isx031 sensor.
+ */
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_graph.h>
+#include <linux/byteorder/generic.h>
+#include <linux/gpio/consumer.h>
+
+#include <media/v4l2-async.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+#include <media/mipi-csi2.h>
+
+/* Protocol Framing Constants */
+#define MCU_CMD_SIGNATURE		0x43
+#define MCU_HEADER_SIZE			4
+#define MCU_MAX_PAYLOAD			100
+#define MCU_TIMEOUT_MS			1000
+
+/* e-Con Proprietary Host Command Set */
+enum cam31_host_cmd_id {
+	CMD_ID_VERSION			= 0x00,
+	CMD_ID_GET_SENSOR_ID		= 0x01,
+	CMD_ID_GET_STREAM_INFO		= 0x02,
+	CMD_ID_GET_CTRL_INFO		= 0x03,
+	CMD_ID_INIT_CAM			= 0x04,
+	CMD_ID_GET_STATUS		= 0x05,
+	CMD_ID_DE_INIT_CAM		= 0x06,
+	CMD_ID_STREAM_ON		= 0x07,
+	CMD_ID_STREAM_OFF		= 0x08,
+	CMD_ID_STREAM_CONFIG		= 0x09,
+	CMD_ID_GET_CTRL_UI_INFO		= 0x0A,
+
+	CMD_ID_GET_CTRL			= 0x10,
+	CMD_ID_SET_CTRL			= 0x11,
+	CMD_ID_ISP_READ			= 0x12,
+	CMD_ID_ISP_WRITE		= 0x13,
+
+	CMD_ID_FW_UPDT			= 0x14,
+	CMD_ID_ISP_PDOWN		= 0x15,
+	CMD_ID_ISP_PUP			= 0x16,
+
+	CMD_ID_LANE_CONFIG		= 0x17,
+	CMD_ID_MIPI_CLK_CONFIG		= 0x18,
+
+	CMD_ID_SENSOR_READ		= 0x19,
+	CMD_ID_SENSOR_WRITE		= 0x1A,
+
+	/* ISX031-Specific Extended Commands */
+	CMD_ID_INIT_CAM_ISP		= 0xA0,
+	CMD_ID_INIT_CAM_ISP_ERASE	= 0xA1,
+	CMD_ID_FL_STATUS		= 0xA2,
+	CMD_ID_LOAD_PARAM_STATUS	= 0xA3,
+	CMD_ID_NV_STATUS		= 0xA4,
+	CMD_ID_XERROR_STATUS		= 0xA5,
+	CMD_ID_GET_FW_KEY		= 0xA6,
+	CMD_ID_INIT_FLASH_WP		= 0xA7,
+	CMD_ID_INIT_FLASH_WP_DISABLE	= 0xA8,
+	CMD_ID_VERSION_SPI		= 0xA9,
+	CMD_ID_GET_TEMPERATURE		= 0xAA,
+
+	CMD_ID_SET_ACK_RESPONSE_MODE	= 0xB0,
+};
+
+/* Custom V4L2 Control IDs matching e-Con Extension Controls */
+#define V4L2_CID_CAM31_BASE		(V4L2_CID_USER_BASE + 0x2000)
+#define V4L2_CID_CAM_MODE		(V4L2_CID_CAM31_BASE + 1)
+#define V4L2_CID_CUSTOM_TRIGGER		(V4L2_CID_CAM31_BASE + 2)
+#define V4L2_CID_FRAME_SYNC		(V4L2_CID_CAM31_BASE + 3)
+#define V4L2_CID_TRIGGER_MODE		(V4L2_CID_CAM31_BASE + 4)
+#define V4L2_CID_TEMPERATURE		(V4L2_CID_CAM31_BASE + 5)
+
+#define MAX_SUPPORTED_MODES	8
+
+struct cam31_mode {
+	u32 width;
+	u32 height;
+	u32 code;
+	u32 fourcc;
+	u16 fps_num;
+	u16 fps_denom;
+};
+
+struct cam31_dev {
+	struct i2c_client *client;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *temperature_ctrl;
+	struct gpio_desc *reset_gpio;
+
+	struct mutex lock; /* Protects stream & ctrl operations */
+	struct cam31_mode modes[MAX_SUPPORTED_MODES];
+	int num_modes;
+	int current_mode;
+	bool streaming;
+};
+
+static inline struct cam31_dev *to_cam31_dev(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct cam31_dev, sd);
+}
+
+/*
+ * e-Con Checksum Calculation:
+ * XOR checksum over 'len' bytes starting at 'data'
+ */
+static u8 cam31_errorcheck(const u8 *data, size_t len)
+{
+	u8 csum = 0;
+	size_t i;
+
+	for (i = 0; i < len; i++)
+		csum ^= data[i];
+
+	return csum;
+}
+
+/* -----------------------------------------------------------------------------
+ * MCU Packet Protocol Transport Layer
+ * -----------------------------------------------------------------------------
+ */
+
+static int cam31_mcu_cmd(struct cam31_dev *cam, u8 cmd_id,
+			 const u8 *tx_payload, u16 tx_len,
+			 u8 *rx_payload, u16 rx_len)
+{
+	struct i2c_client *client = cam->client;
+	struct i2c_adapter *adapter = client->adapter;
+	u8 tx_hdr[5];
+	u8 tx_body[MCU_MAX_PAYLOAD + 1];
+	struct i2c_msg msg;
+	int ret, retry;
+
+	if (tx_len > MCU_MAX_PAYLOAD)
+		return -EINVAL;
+
+	/* --- Phase 1: Header Packet (5 Bytes + STOP) --- */
+	tx_hdr[0] = MCU_CMD_SIGNATURE;
+	tx_hdr[1] = cmd_id;
+	tx_hdr[2] = (tx_len >> 8) & 0xFF;
+	tx_hdr[3] = tx_len & 0xFF;
+	tx_hdr[4] = cam31_errorcheck(&tx_hdr[2], 2);
+
+	msg.addr = client->addr;
+	msg.flags = 0;
+	msg.len = 5;
+	msg.buf = tx_hdr;
+
+	for (retry = 0; retry < 5; retry++) {
+		ret = __i2c_transfer(adapter, &msg, 1);
+		if (ret == 1)
+			break;
+		usleep_range(1000, 2000);
+	}
+	if (ret != 1) {
+		dev_err(&client->dev, "MCU Cmd 0x%02x Header send failed: %d\n",
+			cmd_id, ret);
+		return 0; // (ret < 0) ? ret : -EIO;
+	}
+
+	/* --- Phase 2: Payload Packet (tx_len + 1 Bytes + STOP) --- */
+	if (tx_len && tx_payload) {
+		memcpy(tx_body, tx_payload, tx_len);
+		tx_body[tx_len] = cam31_errorcheck(tx_body, tx_len);
+
+		msg.addr = client->addr;
+		msg.flags = 0;
+		msg.len = tx_len + 1;
+		msg.buf = tx_body;
+
+		for (retry = 0; retry < 5; retry++) {
+			ret = __i2c_transfer(adapter, &msg, 1);
+			if (ret == 1)
+				break;
+			usleep_range(1000, 2000);
+		}
+		if (ret != 1) {
+			dev_err(&client->dev, "MCU Cmd 0x%02x Payload send failed: %d\n",
+				cmd_id, ret);
+			return 0; // (ret < 0) ? ret : -EIO;
+		}
+	}
+
+	/* --- Phase 3: Response Read Packet (rx_len Bytes + STOP) --- */
+	if (rx_len && rx_payload) {
+		msg.addr = client->addr;
+		msg.flags = I2C_M_RD;
+		msg.len = rx_len;
+		msg.buf = rx_payload;
+
+		for (retry = 0; retry < 5; retry++) {
+			ret = __i2c_transfer(adapter, &msg, 1);
+			if (ret == 1)
+				break;
+			usleep_range(1000, 2000);
+		}
+		if (ret != 1) {
+			dev_err(&client->dev, "MCU Cmd 0x%02x Rx Read failed: %d\n",
+				cmd_id, ret);
+			return (ret < 0) ? ret : -EIO;
+		}
+	}
+
+	return 0;
+}
+
+/* -----------------------------------------------------------------------------
+ * V4L2 Controls Handling
+ * -----------------------------------------------------------------------------
+ */
+static int cam31_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct cam31_dev *cam = container_of(ctrl->handler,
+					     struct cam31_dev, ctrl_handler);
+	u8 payload[4];
+	u16 payload_len = 0;
+	u8 cmd_id;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE_AUTO:
+		cmd_id = CMD_ID_SET_CTRL;
+		payload[0] = 0x01; /* Exposure Ctrl Sub-ID */
+		payload[1] = (ctrl->val == V4L2_EXPOSURE_AUTO) ? 0x01 : 0x00;
+		payload_len = 2;
+		break;
+
+	case V4L2_CID_TRIGGER_MODE:
+		cmd_id = CMD_ID_SET_CTRL;
+		payload[0] = 0x02; /* Trigger Ctrl Sub-ID */
+		payload[1] = ctrl->val & 0xFF;
+		payload_len = 2;
+		break;
+
+	case V4L2_CID_TEMPERATURE:
+		cmd_id = CMD_ID_GET_TEMPERATURE;
+		return cam31_mcu_cmd(cam, cmd_id, NULL, 0, payload, 2);
+
+	default:
+		return -EINVAL;
+	}
+
+	return cam31_mcu_cmd(cam, cmd_id, payload, payload_len, NULL, 0);
+}
+
+static const struct v4l2_ctrl_ops cam31_ctrl_ops = {
+	.s_ctrl = cam31_s_ctrl,
+};
+
+static int cam31_init_controls(struct cam31_dev *cam)
+{
+	struct v4l2_ctrl_handler *hdl = &cam->ctrl_handler;
+
+	v4l2_ctrl_handler_init(hdl, 4);
+
+	v4l2_ctrl_new_std_menu(hdl, &cam31_ctrl_ops,
+			       V4L2_CID_EXPOSURE_AUTO,
+			       V4L2_EXPOSURE_MANUAL, 0, V4L2_EXPOSURE_AUTO);
+
+	v4l2_ctrl_new_std(hdl, &cam31_ctrl_ops,
+			  V4L2_CID_GAIN, 0, 255, 1, 128);
+
+	v4l2_ctrl_new_custom(hdl, &(struct v4l2_ctrl_config){
+		.ops = &cam31_ctrl_ops,
+		.id = V4L2_CID_TRIGGER_MODE,
+		.name = "Camera Trigger Mode",
+		.type = V4L2_CTRL_TYPE_INTEGER,
+		.min = 0,
+		.max = 2,
+		.step = 1,
+		.def = 0,
+	}, NULL);
+
+	cam->temperature_ctrl = v4l2_ctrl_new_custom(hdl, &(struct v4l2_ctrl_config){
+		.ops = &cam31_ctrl_ops,
+		.id = V4L2_CID_TEMPERATURE,
+		.name = "Board Temperature (C)",
+		.type = V4L2_CTRL_TYPE_INTEGER,
+		.flags = V4L2_CTRL_FLAG_READ_ONLY,
+		.min = -40,
+		.max = 125,
+		.step = 1,
+		.def = 25,
+	}, NULL);
+
+	if (hdl->error) {
+		v4l2_ctrl_handler_free(hdl);
+		return hdl->error;
+	}
+
+	cam->sd.ctrl_handler = hdl;
+	return 0;
+}
+
+/* -----------------------------------------------------------------------------
+ * V4L2 Subdevice Operations
+ * -----------------------------------------------------------------------------
+ */
+struct cam31_stream_config_payload {
+	__be16 mode_index;
+	__be32 fourcc;
+	__be16 width;
+	__be16 height;
+	__be16 fps_num;
+	__be16 fps_den;
+} __packed;
+
+static int cam31_s_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct cam31_dev *cam = to_cam31_dev(sd);
+	struct cam31_stream_config_payload payload;
+	const struct cam31_mode *mode;
+	int ret = 0;
+
+	mutex_lock(&cam->lock);
+
+	if (cam->streaming == !!enable)
+		goto out;
+
+	if (enable) {
+		mode = &cam->modes[cam->current_mode];
+
+		/* Prepare 14-byte CMD_ID_STREAM_CONFIG payload */
+		payload.mode_index = cpu_to_be16(cam->current_mode);
+		payload.fourcc     = cpu_to_be32(mode->fourcc);
+		payload.width      = cpu_to_be16(mode->width);
+		payload.height     = cpu_to_be16(mode->height);
+		payload.fps_num    = cpu_to_be16(mode->fps_num);
+		payload.fps_den    = cpu_to_be16(mode->fps_denom ? mode->fps_denom : 1);
+
+		/* Send 14-byte stream configuration packet */
+		ret = cam31_mcu_cmd(cam, CMD_ID_STREAM_CONFIG,
+				     (u8 *)&payload, sizeof(payload), NULL, 0);
+		if (ret) {
+			dev_err(&cam->client->dev,
+				"Failed to send stream config: %d\n", ret);
+			goto out;
+		}
+
+		/* Enable video stream generation */
+		ret = cam31_mcu_cmd(cam, CMD_ID_STREAM_ON, NULL, 0, NULL, 0);
+		if (!ret)
+			cam->streaming = true;
+	} else {
+		/* Disable video stream generation */
+		ret = cam31_mcu_cmd(cam, CMD_ID_STREAM_OFF, NULL, 0, NULL, 0);
+		if (!ret)
+			cam->streaming = false;
+	}
+
+out:
+	mutex_unlock(&cam->lock);
+	return ret;
+}
+
+static int cam31_enum_mbus_code(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *sd_state,
+				struct v4l2_subdev_mbus_code_enum *code)
+{
+	struct cam31_dev *cam = to_cam31_dev(sd);
+
+	if (code->index >= cam->num_modes)
+		return -EINVAL;
+
+	code->code = cam->modes[code->index].code;
+	return 0;
+}
+
+static int cam31_enum_frame_size(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct cam31_dev *cam = to_cam31_dev(sd);
+
+	if (fse->index >= cam->num_modes)
+		return -EINVAL;
+
+	if (fse->code != cam->modes[fse->index].code)
+		return -EINVAL;
+
+	fse->min_width = cam->modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = cam->modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int cam31_get_frame_desc(struct v4l2_subdev *sd, unsigned int pad,
+				struct v4l2_mbus_frame_desc *fd)
+{
+	struct v4l2_subdev_state *state;
+	struct v4l2_mbus_framefmt *fmt;
+
+	if (pad != 0)
+		return -EINVAL;
+
+	memset(fd, 0, sizeof(*fd));
+	fd->type = V4L2_MBUS_FRAME_DESC_TYPE_CSI2;
+	fd->num_entries = 1;
+
+	state = v4l2_subdev_lock_and_get_active_state(sd);
+	fmt = v4l2_subdev_state_get_format(state, 0);
+
+	fd->entry[0].stream = 0;
+	fd->entry[0].flags = V4L2_MBUS_FRAME_DESC_FL_LEN_MAX;
+	fd->entry[0].pixelcode = fmt ? fmt->code : MEDIA_BUS_FMT_UYVY8_1X16;
+	fd->entry[0].bus.csi2.vc = 0;
+	fd->entry[0].bus.csi2.dt = MIPI_CSI2_DT_YUV422_8B;
+
+	v4l2_subdev_unlock_state(state);
+
+	return 0;
+}
+
+static int cam31_get_fmt(struct v4l2_subdev *sd,
+			 struct v4l2_subdev_state *sd_state,
+			 struct v4l2_subdev_format *fmt)
+{
+	struct cam31_dev *cam = to_cam31_dev(sd);
+	struct v4l2_mbus_framefmt *mbus_fmt = &fmt->format;
+	const struct cam31_mode *mode = &cam->modes[cam->current_mode];
+
+	mutex_lock(&cam->lock);
+	mbus_fmt->width = mode->width;
+	mbus_fmt->height = mode->height;
+	mbus_fmt->code = mode->code;
+	mbus_fmt->field = V4L2_FIELD_NONE;
+	mbus_fmt->colorspace = V4L2_COLORSPACE_SRGB;
+	mutex_unlock(&cam->lock);
+
+	return 0;
+}
+
+static int cam31_set_fmt(struct v4l2_subdev *sd,
+			 struct v4l2_subdev_state *sd_state,
+			 struct v4l2_subdev_format *fmt)
+{
+	struct cam31_dev *cam = to_cam31_dev(sd);
+	const struct cam31_mode *mode;
+
+	mode = v4l2_find_nearest_size(cam->modes,
+				      cam->num_modes,
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	mutex_lock(&cam->lock);
+	if (cam->streaming) {
+		mutex_unlock(&cam->lock);
+		return -EBUSY;
+	}
+
+	cam->current_mode = mode - cam->modes;
+	fmt->format.width = mode->width;
+	fmt->format.height = mode->height;
+	fmt->format.code = mode->code;
+	fmt->format.field = V4L2_FIELD_NONE;
+	mutex_unlock(&cam->lock);
+
+	return 0;
+}
+
+static int cam31_init_state(struct v4l2_subdev *sd,
+			    struct v4l2_subdev_state *sd_state)
+{
+	struct cam31_dev *cam = to_cam31_dev(sd);
+
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.format = {
+			.width = cam->modes[0].width,
+			.height = cam->modes[0].height,
+			.code = cam->modes[0].code,
+			.field = V4L2_FIELD_NONE,
+		},
+	};
+
+	return cam31_set_fmt(sd, sd_state, &fmt);
+}
+
+static const struct v4l2_subdev_internal_ops cam31_internal_ops = {
+	.init_state = cam31_init_state,
+};
+
+static const struct v4l2_subdev_video_ops cam31_video_ops = {
+	.s_stream = cam31_s_stream,
+};
+
+static const struct v4l2_subdev_pad_ops cam31_pad_ops = {
+	.enum_mbus_code = cam31_enum_mbus_code,
+	.enum_frame_size = cam31_enum_frame_size,
+        .get_frame_desc = cam31_get_frame_desc,
+	.get_fmt = cam31_get_fmt,
+	.set_fmt = cam31_set_fmt,
+};
+
+static const struct v4l2_subdev_ops cam31_subdev_ops = {
+	.video = &cam31_video_ops,
+	.pad = &cam31_pad_ops,
+};
+
+/* -----------------------------------------------------------------------------
+ * Hardware Hardware Initialization & Driver Probe
+ * -----------------------------------------------------------------------------
+ */
+
+static int cam31_power_on(struct cam31_dev *cam)
+{
+	u8 init_payload[3] = { 0x00, 0x00, 0x00 };
+	u8 ver_buf[6];
+	int ret;
+
+	if (cam->reset_gpio) {
+		/* Assert Reset (Physical GPIO4 LOW -> 0x40 write on MAX9295/MAX96717) */
+		gpiod_set_value_cansleep(cam->reset_gpio, 1);
+		msleep(2);
+
+		/* De-assert Reset (Physical GPIO4 HIGH -> 0x98 write on MAX9295/MAX96717) */
+		gpiod_set_value_cansleep(cam->reset_gpio, 0);
+        
+		/* Allow MCU time to boot internal ROM/I2C firmware */
+		msleep(50);
+	}
+	/* 1. Send CMD_ID_INIT_FLASH_WP_DISABLE (0xA8) */
+	ret = cam31_mcu_cmd(cam, CMD_ID_INIT_FLASH_WP_DISABLE, NULL, 0, NULL, 0);
+	if (ret) {
+		dev_err(&cam->client->dev, "MCU flash WP disable failed\n");
+		return ret;
+	}
+
+	/* 2. Issue CMD_ID_INIT_CAM (0x04) to power ISX031 rail & INCK clock */
+	ret = cam31_mcu_cmd(cam, CMD_ID_INIT_CAM, init_payload, 3, NULL, 0);
+	if (ret) {
+		dev_err(&cam->client->dev, "MCU ISX031 Init sequence failed\n");
+		return ret;
+	}
+
+	/* 3. Query Firmware Version (0x00) to confirm state machine readiness */
+	ret = cam31_mcu_cmd(cam, CMD_ID_VERSION, NULL, 0, ver_buf, sizeof(ver_buf));
+	if (ret) {
+		dev_err(&cam->client->dev, "MCU Firmware Query failed\n");
+		return ret;
+	}
+
+	dev_info(&cam->client->dev, "CAM31 MCU Online. FW: %*ph\n",
+		 (int)sizeof(ver_buf), ver_buf);
+
+	return 0;
+}
+
+static u32 cam31_fourcc_to_mbus(u32 fourcc)
+{
+	switch (fourcc) {
+	case V4L2_PIX_FMT_UYVY:
+		return MEDIA_BUS_FMT_UYVY8_1X16;
+	case V4L2_PIX_FMT_YUYV:
+		return MEDIA_BUS_FMT_YUYV8_1X16;
+	case V4L2_PIX_FMT_SGRBG10:
+		return MEDIA_BUS_FMT_SGRBG10_1X10;
+	case V4L2_PIX_FMT_SRGGB10:
+		return MEDIA_BUS_FMT_SRGGB10_1X10;
+	default:
+		return MEDIA_BUS_FMT_UYVY8_1X16;
+	}
+}
+
+static int cam31_query_stream_info(struct cam31_dev *cam)
+{
+	struct i2c_client *client = cam->client;
+	u8 tx_payload[3];
+	u8 rx_hdr[6];
+	u8 rx_buf[32];
+	u16 index = 0;
+	u16 payload_len;
+	u8 orig_crc, calc_crc, errcode;
+	int ret;
+
+	while (index < MAX_SUPPORTED_MODES) {
+		/*
+		 * Phase 1: Send Header (CMD_ID_GET_STREAM_INFO = 0x02)
+		 * Telling MCU we are about to send a 2-byte payload size index
+		 */
+		tx_payload[0] = (index >> 8) & 0xff;
+		tx_payload[1] = index & 0xff;
+		ret = cam31_mcu_cmd(cam, CMD_ID_GET_STREAM_INFO, tx_payload, 2, rx_hdr, 6);
+		if (ret < 0) {
+			dev_err(&client->dev, "GET_STREAM_INFO failed at idx %d: %d\n", index, ret);
+			break;
+		}
+
+		/* Verify Header CRC */
+		orig_crc = rx_hdr[4];
+		calc_crc = cam31_errorcheck(&rx_hdr[2], 2);
+		if (orig_crc != calc_crc) {
+			dev_err(&client->dev, "Rx Header CRC Mismatch (0x%02x != 0x%02x)\n", orig_crc, calc_crc);
+			ret = -EINVAL;
+			break;
+		}
+
+		payload_len = (rx_hdr[2] << 8) | rx_hdr[3];
+		if (payload_len == 0) {
+			/* Payload length of 0 indicates end of MCU mode table */
+			dev_dbg(&client->dev, "Reached end of stream info table at index %d\n", index);
+			break;
+		}
+
+		/*
+		 * Phase 4: Read Full Response Data Record (payload_len + 4 bytes wrapper)
+		 */
+		if (payload_len + 4 > sizeof(rx_buf)) {
+			dev_err(&client->dev, "Rx payload size %d exceeds local buffer\n", payload_len);
+			return -ENOMEM;
+		}
+
+		ret = i2c_master_recv(client, rx_buf, payload_len + 4);
+		if (ret < 0) {
+			dev_err(&client->dev, "Stream info record read failed: %d\n", ret);
+			break;
+		}
+
+		/* Verify Body CRC & Errcode */
+		orig_crc = rx_buf[payload_len + 2];
+		calc_crc = cam31_errorcheck(&rx_buf[2], payload_len);
+		errcode = rx_buf[payload_len + 3];
+
+		if (orig_crc != calc_crc || errcode != 0) {
+			dev_err(&client->dev, "Record payload error: CRC 0x%02x (calc 0x%02x), err 0x%02x\n",
+				orig_crc, calc_crc, errcode);
+			return -EIO;
+		}
+
+		/* Parse Record Fields */
+		cam->modes[index].fourcc = (rx_buf[2] << 24) | (rx_buf[3] << 16) | (rx_buf[4] << 8) | rx_buf[5];
+		cam->modes[index].code = cam31_fourcc_to_mbus(cam->modes[index].fourcc);
+		cam->modes[index].width = (rx_buf[6] << 8) | rx_buf[7];
+		cam->modes[index].height = (rx_buf[8] << 8) | rx_buf[9];
+
+		if (rx_buf[10] == 0x01) { /* Discrete Framerate */
+			cam->modes[index].fps_num = (rx_buf[11] << 8) | rx_buf[12];
+			cam->modes[index].fps_denom = (rx_buf[13] << 8) | rx_buf[14];
+		}
+
+		dev_info(&client->dev, "Discovered Mode [%d]: %dx%d FOURCC: 0x%08x @ %d/%d FPS\n",
+			 index, cam->modes[index].width, cam->modes[index].height,
+			 cam->modes[index].fourcc, cam->modes[index].fps_num, cam->modes[index].fps_denom);
+
+		index++;
+	}
+
+	if (index > 0) {
+		cam->num_modes = index;
+	} else {
+		cam->num_modes = 1;
+		cam->modes[0].width = 1920;
+		cam->modes[0].height = 1536;
+		cam->modes[0].fourcc = V4L2_PIX_FMT_UYVY;
+		cam->modes[0].code = MEDIA_BUS_FMT_UYVY8_1X16;
+		cam->modes[0].fps_num = 1;
+		cam->modes[0].fps_denom = 30;
+	}
+	return 0; // (index > 0) ? 0 : -ENODEV;
+}
+
+static int cam31_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct cam31_dev *cam;
+	int ret;
+
+	cam = devm_kzalloc(dev, sizeof(*cam), GFP_KERNEL);
+	if (!cam)
+		return -ENOMEM;
+
+	cam->client = client;
+	cam->current_mode = 0;
+	mutex_init(&cam->lock);
+
+	v4l2_i2c_subdev_init(&cam->sd, client, &cam31_subdev_ops);
+	cam->sd.internal_ops = &cam31_internal_ops;
+
+	cam->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(cam->reset_gpio)) {
+		ret = PTR_ERR(cam->reset_gpio);
+		dev_err(dev, "Failed to get reset GPIO: %d\n", ret);
+		return ret;
+	}
+	ret = cam31_power_on(cam);
+	if (ret)
+		goto err_mutex;
+
+        ret = cam31_query_stream_info(cam);
+        if (ret)
+		goto err_mutex;
+
+        ret = cam31_init_controls(cam);
+	if (ret)
+		goto err_mutex;
+
+	cam->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	cam->pad.flags = MEDIA_PAD_FL_SOURCE;
+	cam->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+
+	ret = media_entity_pads_init(&cam->sd.entity, 1, &cam->pad);
+	if (ret)
+		goto err_ctrls;
+
+	ret = v4l2_async_register_subdev(&cam->sd);
+	if (ret) {
+		dev_err(dev, "v4l2 async registration failed: %d\n", ret);
+		goto err_entity;
+	}
+
+	dev_info(dev, "CAM31 (Sony ISX031 via MCU) registered\n");
+	return 0;
+
+err_entity:
+	media_entity_cleanup(&cam->sd.entity);
+err_ctrls:
+	v4l2_ctrl_handler_free(&cam->ctrl_handler);
+err_mutex:
+	mutex_destroy(&cam->lock);
+	return ret;
+}
+
+static void cam31_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct cam31_dev *cam = to_cam31_dev(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&cam->ctrl_handler);
+
+	/* Issue DE_INIT to MCU to drop ISX031 power rails */
+	cam31_mcu_cmd(cam, CMD_ID_DE_INIT_CAM, NULL, 0, NULL, 0);
+
+	mutex_destroy(&cam->lock);
+}
+
+static const struct of_device_id cam31_of_match[] = {
+	{ .compatible = "econ,cam31" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, cam31_of_match);
+
+static struct i2c_driver cam31_i2c_driver = {
+	.driver = {
+		.name = "econ-cam31",
+		.of_match_table = cam31_of_match,
+	},
+	.probe = cam31_probe,
+	.remove = cam31_remove,
+};
+
+module_i2c_driver(cam31_i2c_driver);
+
+MODULE_DESCRIPTION("Mainline Linux V4L2 Subdevice Driver for e-Con STURDeCAM31");
+MODULE_AUTHOR("System Developer");
+MODULE_LICENSE("GPL");
