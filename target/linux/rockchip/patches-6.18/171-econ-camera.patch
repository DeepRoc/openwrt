+static int oax4000_power_on(struct cam57_dev *cam)
+{
+	struct device *dev = &cam->client->dev;
+
+	dev_info(dev, "Resetting OAX4000 ISP...\n");
+
+	ser_gpio_config(cam->client, SER_REG_RESET);
+	ser_gpio_level(cam->client, SER_REG_RESET, false);
+	msleep(10);
+
+	ser_gpio_level(cam->client, SER_REG_RESET, true);
+	msleep(300);
+
+	return 0;
+}
+
+static int oax4000_power_off(struct cam57_dev *cam)
+{
+	ser_gpio_level(cam->client, SER_REG_RESET, false);
+	return 0;
+}
+
+static int oax4000_send_isp_cmd(struct cam57_dev *cam, const u8 *payload, u16 len)
+{
+	int ret;
+
+	for (int i = 0; i < len; i++) {
+		ret = regmap_write(cam->regmap, OAX4000_MAILBOX_BASE + i, payload[i]);
+		if (ret)
+			return ret;
+	}
+
+	ret = regmap_write(cam->regmap, OAX4000_CMD_TRIGGER_REG, 0x01);
+	if (ret)
+		return ret;
+
+	// dev_info(&cam->client->dev, "isp_cmd %*ph\n", len, payload);
+	return oax4000_check_cmd_status(cam);
+}
+
+static int oax4000_read_page(struct cam57_dev *cam,
+                             u8 *buf, size_t size, u32 flash_page)
+{
+	u8 payload[8];
+	unsigned int val;
+	int ret, i;
+
+	if (size > 256)
+		return -EINVAL;
+
+	payload[0] = 0x00;
+	payload[1] = 0x00;
+	payload[2] = 0x00;
+	payload[3] = CMD_SERIAL_FLASH_READ;
+	payload[4] = 0x00;
+	payload[5] = 0x02;
+	payload[6] = (flash_page >> 8) & 0xff;
+	payload[7] = flash_page & 0xff;
+
+	ret = oax4000_send_isp_cmd(cam, payload, sizeof(payload));
+	if (ret)
+		return ret;
+
+	for (i = 0; i < size; i++) {
+		ret = regmap_read(cam->regmap, 0x3C07 + i, &val);
+		if (ret)
+			return ret;
+		buf[i] = val & 0xFF;
+	}
+	return 0;
+}
+
+static int oax4000_write_page(struct cam57_dev *cam,
+                              const u8 *data, size_t size, u32 flash_page)
+{
+	struct i2c_client *client = cam->client;
+	u8 payload[10 + 256] = { 0 };
+	int ret;
+
+	if (size > 256)
+		return -EINVAL;
+
+	if ((flash_page & 15) == 0) {
+		for (int retry = 5; --retry >= 0; ) {
+			payload[0] = 0x00;
+			payload[1] = 0x00;
+			payload[2] = 0x00;
+			payload[3] = CMD_SERIAL_FLASH_ERASE;
+			payload[4] = 0x00;
+			payload[5] = 0x03;
+			payload[6] = 0x01;
+			payload[7] = (flash_page >> 8) & 0xff;
+			payload[8] = flash_page & 0xff;
+			ret = oax4000_send_isp_cmd(cam, payload, 9);
+			if (ret == 0)
+				break;
+			if (ret == OAX4000_STATUS_ERR || ret == OAX4000_STATUS_RESET) {
+				msleep(50);
+				continue;
+			}
+			return ret;
+		}
+		msleep(250);
+	}
+	for (int retry = 5; --retry >= 0; ) {
+		payload[0] = 0x30;
+		payload[1] = 0x00;
+		payload[2] = 0x00;
+		payload[3] = 0x00;
+		payload[4] = 0x00;
+		payload[5] = CMD_SERIAL_FLASH_PAGE_PROGRAM;
+		payload[6] = 0x01;
+		payload[7] = 0x02;
+		payload[8] = (flash_page >> 8) & 0xff;
+		payload[9] = flash_page & 0xff;
+		memcpy(&payload[10], data, size);
+
+		ret = i2c_master_send(client, payload, sizeof(payload));
+		if (ret < sizeof(payload))
+			return -EIO;
+
+		ret = regmap_write(cam->regmap, OAX4000_CMD_TRIGGER_REG, 0x01);
+		if (ret)
+			return ret;
+
+		ret = oax4000_check_cmd_status(cam);
+		if (ret == OAX4000_STATUS_ERR || ret == OAX4000_STATUS_RESET) {
+			msleep(50);
+			continue;
+		}
+		break;
+	}
+	return ret;
+}
+
+static int oax4000_firmware_ok(struct cam57_dev *cam, const struct firmware *fw)
+{
+	struct device *dev = &cam->client->dev;
+	u8 version_size = fw->data[0];
+	u8 version[32];
+	u8 sensor_id;
+	int ret;
+
+	if (version_size != OAX4000_FW_VERSION_LEN) {
+		dev_err(dev, "invalid cam57 version size: %d\n", version_size);
+		return -EINVAL;
+	}
+
+        for (int retry = 4; --retry >= 0; ) {
+                ret = oax4000_read_8b_reg(cam->client, OAX4000_ISP_STATUS_REG, &sensor_id);
+                if (ret == 0 && sensor_id != 0xff)
+                    break;
+                msleep(50);
+        }
+	if (ret) {
+		dev_err(dev, "Cannot read sensor ID\n");
+		return ret;
+	}
+	dev_info(dev, "Sensor ID=0x%02x\n", sensor_id);
+        if (sensor_id == 0x21) {
+            /*
+             * The precise value of these sleeps is important!  Waiting too long makes
+             * the following read_page return all zeros.
+             */
+            msleep(200);
+            ret = oax4000_read_page(cam, version, sizeof(version), OAX4000_FW_VERSION_PAGE);
+            if (ret)
+		dev_warn(dev, "cannot read firmware version: %d\n", ret);
+            else {
+		dev_info(dev, "cam57 version %*ph\n", version_size, version);
+                return 0;
+                /*
+		if (memcmp(version, &fw->data[1], version_size) == 0)
+			return 0;
+                */
+            }
+        }
+	return version_size + 1;
+}
+
+static int oax4000_load_firmware(struct cam57_dev *cam)
+{
+	struct device *dev = &cam->client->dev;
+	const struct firmware *fw;
+	u8 page[256];
+	int ret, errors, header_len;
+	size_t offset, fw_len;
+
+	ret = request_firmware(&fw, CAM57_FIRMWARE_NAME, dev);
+	if (ret) {
+		dev_err(dev, "Failed to load firmware file %s: %d\n",
+			CAM57_FIRMWARE_NAME, ret);
+		return ret;
+	}
+
+	ret = oax4000_firmware_ok(cam, fw);
+	if (ret <= 0) {
+		goto out_release_fw;
+	}
+
+        header_len = ret;
+	fw_len = fw->size - header_len;
+	dev_info(dev, "Programming CAM57 with %ld bytes...\n", fw_len);
+
+	ret = oax4000_update_bootloader(cam->client, BOOT_FW, sizeof(BOOT_FW));
+	if (ret)
+		goto out_release_fw;
+
+	offset = 0;
+	while (offset < fw_len) {
+		size_t page_size = min_t(size_t, 256, fw_len - offset);
+
+		if ((offset & 0x3fff) == 0)
+			dev_info(dev, "   loading ISP at %ld%%\n", offset * 100 / fw_len);
+		ret = oax4000_write_page(cam, fw->data + header_len + offset, page_size, offset / 256);
+		if (ret) {
+			dev_err(dev, "page write failed at %lx\n", offset);
+			goto out_release_fw;
+		}
+		offset += page_size;
+	}
+
+	offset = 0;
+	errors = 0;
+	dev_info(dev, "Verifying CAM57 firmware...\n");
+	while (offset < fw_len) {
+		size_t page_size = min_t(size_t, 256, fw_len - offset);
+
+		if ((offset & 0x3fff) == 0)
+			dev_info(dev, "   verifying ISP at %ld%%\n", offset * 100 / fw_len);
+		ret = oax4000_read_page(cam, page, page_size, offset / 256);
+		if (ret) {
+			dev_err(dev, "page read failed at %lx\n", offset);
+			++errors;
+		}
+		if (memcmp(page, fw->data + header_len + offset, page_size) != 0) {
+			int len = min_t(int, 32, page_size);
+			dev_err(dev, "verify@%04lx: %*ph / %*ph\n", offset / 256,
+				 len, fw->data + header_len + offset, len, page);
+			++errors;
+		}
+		offset += page_size;
+	}
+	if (errors > 0)
+		goto out_release_fw;
+
+	/* Write CAM57 firmware ID to start of last sector in flash */
+
+	ret = oax4000_write_page(cam, &fw->data[1], OAX4000_FW_VERSION_LEN, OAX4000_FW_VERSION_PAGE);
+	if (ret) {
+		dev_err(dev, "writing firmware version failed\n");
+		goto out_release_fw;
+	}
+
+	oax4000_power_on(cam);
+
+        dev_info(dev, "CAM57 firmware programming complete\n");
+
+out_release_fw:
+	release_firmware(fw);
+	return ret;
+}
+
+/* -----------------------------------------------------------------------------
+ * V4L2 Subdev Operations
+ * -----------------------------------------------------------------------------
+ */
+
+static int cam57_s_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct cam57_dev *cam = to_cam57(sd);
+	int ret = 0;
+
+	if (!cam->initialized)
+		return -EAGAIN;
+
+	if (cam->streaming == enable)
+		return 0;
+
+	ret = cam57_sensor_write_reg(cam, 0x0100, enable);
+	if (ret)
+		return ret;
+
+	cam->streaming = enable;
+	return 0;
+}
+
+static int cam57_enum_frame_size(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *sd_state,
+				   struct v4l2_subdev_frame_size_enum *fse)
+{
+	const struct cam57_mode *mode;
+
+	if (fse->index >= ARRAY_SIZE(supported_modes))
+		return -EINVAL;
+
+	mode = &supported_modes[fse->index];
+	
+	if (fse->code != mode->code)
+		return -EINVAL;
+
+	fse->min_width = fse->max_width = mode->width;
+	fse->min_height = fse->max_height = mode->height;
+
+	return 0;
+}
+
+static int cam57_get_fmt(struct v4l2_subdev *sd,
+			 struct v4l2_subdev_state *sd_state,
+			 struct v4l2_subdev_format *fmt)
+{
+	struct cam57_dev *cam = to_cam57(sd);
+	const struct cam57_mode *mode = cam->current_mode;
+
+	fmt->format.code = mode->code;
+	fmt->format.width = mode->width;
+	fmt->format.height = mode->height;
+	fmt->format.field = V4L2_FIELD_NONE;
+	fmt->format.colorspace = V4L2_COLORSPACE_SRGB;
+	return 0;
+}
+
+static int cam57_enum_mbus_code(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *sd_state,
+				struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = supported_modes[0].code;
+	return 0;
+}
+
+static int cam57_get_frame_desc(struct v4l2_subdev *sd, unsigned int pad,
+				struct v4l2_mbus_frame_desc *fd)
+{
+	struct v4l2_subdev_state *state;
+	struct v4l2_subdev_route *route;
+	struct v4l2_mbus_framefmt *fmt;
+
+	if (pad != 0)
+		return -EINVAL;
+
+	memset(fd, 0, sizeof(*fd));
+	fd->type = V4L2_MBUS_FRAME_DESC_TYPE_CSI2;
+
+	state = v4l2_subdev_lock_and_get_active_state(sd);
+
+	for_each_active_route(&state->routing, route) {
+		if (route->source_pad != pad)
+			continue;
+
+		if (fd->num_entries >= V4L2_FRAME_DESC_ENTRY_MAX)
+			break;
+
+		fmt = v4l2_subdev_state_get_format(state, pad, route->source_stream);
+
+		fd->entry[fd->num_entries] = (struct v4l2_mbus_frame_desc_entry){
+			.stream = route->source_stream,
+			.flags = V4L2_MBUS_FRAME_DESC_FL_LEN_MAX,
+			.pixelcode = fmt ? fmt->code : MEDIA_BUS_FMT_UYVY8_1X16,
+			.bus.csi2 = {
+				.vc = route->source_stream,
+				.dt = MIPI_CSI2_DT_YUV422_8B,
+			},
+		};
+		fd->num_entries++;
+	}
+
+	v4l2_subdev_unlock_state(state);
+
+	if (fd->num_entries == 0) {
+		fd->num_entries = 1;
+		fd->entry[0].stream = 0;
+		fd->entry[0].pixelcode = MEDIA_BUS_FMT_UYVY8_1X16;
+		fd->entry[0].bus.csi2.vc = 0;
+		fd->entry[0].bus.csi2.dt = MIPI_CSI2_DT_YUV422_8B;
+	}
+
+	return 0;
+}
+	
+static int cam57_set_fmt(struct v4l2_subdev *sd,
+			 struct v4l2_subdev_state *sd_state,
+			 struct v4l2_subdev_format *fmt)
+{
+	struct cam57_dev *cam = to_cam57(sd);
+	const struct cam57_mode *mode;
+
+	if (fmt->pad > 1)
+		return -EINVAL;
+
+	if (cam->streaming)
+		return -EBUSY;
+
+	mode = v4l2_find_nearest_size(supported_modes,
+				      ARRAY_SIZE(supported_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	cam->current_mode = mode;
+	fmt->format.width = mode->width;
+	fmt->format.height = mode->height;
+	fmt->format.code = mode->code;
+	fmt->format.field = V4L2_FIELD_NONE;
+	fmt->format.colorspace = V4L2_COLORSPACE_SRGB;
+	return 0;
+}
+
+static int cam57_enable_streams(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				u32 pad, u64 streams_mask)
+{
+	struct cam57_dev *cam = to_cam57(sd);
+	int ret = 0;
+
+	if (!cam->initialized)
+		return -EAGAIN;
+
+	if (!cam->streaming) {
+		ret = cam57_set_resolution(cam);
+		if (ret) {
+			dev_err(sd->dev, "Failed to set resolution to %dx%d: %d\n",
+				cam->current_mode->width,
+				cam->current_mode->height,
+				ret);
+			return ret;
+		}
+		ret = cam57_sensor_write_reg(cam, 0x0100, 0x01);
+		if (ret) {
+			dev_err(sd->dev, "Failed to start stream on 0x0100: %d\n", ret);
+			return ret;
+		}
+		cam->streaming = true;
+	}
+
+	return 0;
+}
+
+static int cam57_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  u32 pad, u64 streams_mask)
+{
+	struct cam57_dev *cam = to_cam57(sd);
+
+	if (cam->streaming) {
+		cam57_sensor_write_reg(cam, 0x0100, 0x00);
+		cam->streaming = false;
+	}
+
+	return 0;
+}
+
+static const struct v4l2_mbus_framefmt cam57_def_fmt = {
+	.width = 2592,
+	.height = 1946,
+	.code = MEDIA_BUS_FMT_UYVY8_1X16,
+	.field = V4L2_FIELD_NONE,
+	.colorspace = V4L2_COLORSPACE_SRGB,
+	.ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT,
+	.quantization = V4L2_QUANTIZATION_DEFAULT,
+	.xfer_func = V4L2_XFER_FUNC_DEFAULT,
+};
+
+static int cam57_init_state(struct v4l2_subdev *sd,
+			      struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_route routes[] = {
+		{
+			.sink_pad = 0,
+			.sink_stream = 0,
+			.source_pad = 0,
+			.source_stream = 0,
+			.flags = V4L2_SUBDEV_ROUTE_FL_ACTIVE,
+		},
+		{
+			.sink_pad = 0,
+			.sink_stream = 1,
+			.source_pad = 0,
+			.source_stream = 1,
+			.flags = V4L2_SUBDEV_ROUTE_FL_ACTIVE,
+		},
+	};
+	struct v4l2_subdev_krouting routing = {
+		.num_routes = ARRAY_SIZE(routes),
+		.routes = routes,
+	};
+
+	return v4l2_subdev_set_routing_with_fmt(sd, state, &routing,
+						&cam57_def_fmt);
+}
+
+static int cam57_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct cam57_dev *cam =
+		container_of(ctrl->handler, struct cam57_dev, ctrls);
+	int ret = 0;
+
+	if (!cam->initialized)
+		return -EAGAIN;
+
+	switch (ctrl->id) {
+	case V4L2_CID_SATURATION:
+		ret = cam57_set_saturation(cam, ctrl->val);
+		break;
+	case V4L2_CID_SHARPNESS:
+		ret = cam57_set_sharpness(cam, ctrl->val);
+		break;
+	case V4L2_CID_CONTRAST:
+		ret = cam57_set_contrast(cam, ctrl->val);
+		break;
+	case V4L2_CID_BRIGHTNESS:
+		ret = cam57_set_brightness(cam, ctrl->val);
+		break;
+	case V4L2_CID_EXPOSURE_AUTO:
+		ret = cam57_set_exposure_rgb(cam, true, 0, 0);
+		break;
+	case V4L2_CID_EXPOSURE_ABSOLUTE:
+		ret = cam57_set_exposure_rgb(cam, false, ctrl->val, cam->gain);
+		break;
+	case V4L2_CID_CUSTOM_EXPOSURE_AUTO_IR:
+		ret = cam57_set_exposure_ir(cam, true, 0, 0);
+		break;
+	case V4L2_CID_CUSTOM_EXPOSURE_ABSOLUTE_IR:
+		ret = cam57_set_exposure_ir(cam, false, ctrl->val, cam->gain_ir);
+		break;
+	case V4L2_CID_GAIN:
+		cam->gain = ctrl->val;
+		break;
+	case V4L2_CID_CUSTOM_GAIN_IR:
+		cam->gain_ir = ctrl->val;
+		break;
+	case V4L2_CID_POWER_LINE_FREQUENCY:
+		ret = cam57_set_power_line_freq(cam, ctrl->val);
+		break;
+	case V4L2_CID_HFLIP:
+		ret = cam57_set_hflip(cam, ctrl->val);
+		break;
+	case V4L2_CID_VFLIP:
+		ret = cam57_set_vflip(cam, ctrl->val);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+        dev_info(&cam->client->dev, "s_ctrl %x %d: %d\n", ctrl->id, ctrl->val, ret);
+	return 0;
+}
+
+static const struct v4l2_ctrl_ops cam57_ctrl_ops = {
+	.s_ctrl = cam57_s_ctrl,
+};
+
+static const struct v4l2_ctrl_config custom_ctrls[] = {
+	{
+		.ops = &cam57_ctrl_ops,
+		.id = V4L2_CID_CUSTOM_EXPOSURE_AUTO_IR,
+		.name = "IR Auto Exposure",
+		.type = V4L2_CTRL_TYPE_BOOLEAN,
+		.min = 0,
+		.max = 1,
+		.step = 1,
+		.def = 1,
+	},
+	{
+		.ops = &cam57_ctrl_ops,
+		.id = V4L2_CID_CUSTOM_EXPOSURE_ABSOLUTE_IR,
+		.name = "IR Exposure Absolute",
+		.type = V4L2_CTRL_TYPE_INTEGER,
+		.min = 1,
+		.max = 0xFFFF,
+		.step = 1,
+		.def = 100,
+	},
+	{
+		.ops = &cam57_ctrl_ops,
+		.id = V4L2_CID_CUSTOM_GAIN_IR,
+		.name = "IR Global Gain",
+		.type = V4L2_CTRL_TYPE_INTEGER,
+		.min = 0,
+		.max = 255,
+		.step = 1,
+		.def = 16,
+	},
+};
+
+static int cam57_init_controls(struct cam57_dev *cam)
+{
+	struct v4l2_ctrl_handler *hdl = &cam->ctrls;
+	int i, ret;
+
+        if (list_empty(&hdl->ctrls)) {
+		v4l2_ctrl_new_std(hdl, &cam57_ctrl_ops, V4L2_CID_SATURATION,
+				  0, 255, 1, 128);
+		v4l2_ctrl_new_std(hdl, &cam57_ctrl_ops, V4L2_CID_SHARPNESS,
+				  0, 255, 1, 128);
+		v4l2_ctrl_new_std(hdl, &cam57_ctrl_ops, V4L2_CID_BRIGHTNESS,
+				  0, 255, 1, 128);
+		v4l2_ctrl_new_std(hdl, &cam57_ctrl_ops, V4L2_CID_CONTRAST,
+				  0, 255, 1, 128);
+		v4l2_ctrl_new_std(hdl, &cam57_ctrl_ops, V4L2_CID_GAIN,
+				  0, 255, 1, 16);
+
+		v4l2_ctrl_new_std_menu(hdl, &cam57_ctrl_ops, V4L2_CID_EXPOSURE_AUTO,
+				       V4L2_EXPOSURE_MANUAL, 0, V4L2_EXPOSURE_AUTO);
+		v4l2_ctrl_new_std(hdl, &cam57_ctrl_ops, V4L2_CID_EXPOSURE_ABSOLUTE,
+				  1, 0xFFFF, 1, 100);
+
+		v4l2_ctrl_new_std_menu(hdl, &cam57_ctrl_ops, V4L2_CID_POWER_LINE_FREQUENCY,
+				       V4L2_CID_POWER_LINE_FREQUENCY_60HZ, 0,
+				       V4L2_CID_POWER_LINE_FREQUENCY_50HZ);
+
+		v4l2_ctrl_new_std(hdl, &cam57_ctrl_ops, V4L2_CID_HFLIP, 0, 1, 1, 0);
+		v4l2_ctrl_new_std(hdl, &cam57_ctrl_ops, V4L2_CID_VFLIP, 0, 1, 1, 0);
+
+		for (i = 0; i < ARRAY_SIZE(custom_ctrls); i++)
+			v4l2_ctrl_new_custom(hdl, &custom_ctrls[i], NULL);
+
+		if (hdl->error) {
+			ret = hdl->error;
+			v4l2_ctrl_handler_free(hdl);
+			return ret;
+		}
+	}
+	return v4l2_ctrl_handler_setup(hdl);
+}
+
+static int cam57_core_reset(struct v4l2_subdev *sd, u32 val)
+{
+	struct cam57_dev *cam = to_cam57(sd);
+
+	if (val) {
+		dev_info(&cam->client->dev, "Link locked, initializing...\n");
+		schedule_delayed_work(&cam->init_work, msecs_to_jiffies(100));
+	} else {
+		dev_warn(&cam->client->dev, "Link lost...\n");
+		cancel_delayed_work_sync(&cam->init_work);
+		if (cam->initialized) {
+			v4l2_ctrl_handler_free(&cam->ctrls);
+			cam->initialized = false;
+		}
+        }
+	return 0;
+}
+
+static const struct v4l2_subdev_core_ops cam57_core_ops = {
+	.reset = cam57_core_reset,
+};
+
+static const struct v4l2_subdev_video_ops cam57_video_ops = {
+	.s_stream = cam57_s_stream,
+};
+
+static const struct v4l2_subdev_pad_ops cam57_pad_ops = {
+	.enum_mbus_code = cam57_enum_mbus_code,
+	.enum_frame_size = cam57_enum_frame_size,
+	.get_fmt = cam57_get_fmt,
+	.set_fmt = cam57_set_fmt,
+	.get_frame_desc = cam57_get_frame_desc,
+	.enable_streams = cam57_enable_streams,
+	.disable_streams = cam57_disable_streams,
+};
+
+static const struct v4l2_subdev_ops cam57_subdev_ops = {
+	.core = &cam57_core_ops,
+	.video = &cam57_video_ops,
+	.pad = &cam57_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops cam57_internal_ops = {
+	.init_state = cam57_init_state,
+};
+
+/* -----------------------------------------------------------------------------
+ * Deferred Work Initialization
+ * -----------------------------------------------------------------------------
+ */
+
+static void cam57_init_work(struct work_struct *work)
+{
+	struct cam57_dev *cam = container_of(work, struct cam57_dev, init_work.work);
+	struct i2c_client *client = cam->client;
+	struct device *dev = &client->dev;
+	int ret;
+
+	if (cam->initialized)
+		return;
+        /*
+         * Sleep for 1 second to allow additional links that share the same deserializer.
+         */
+	msleep(1000);
+	ret = cam57_enable_i2c_switch(client);
+	if (ret) {
+		dev_err(dev, "Failed to enable I2C switch: %d\n", ret);
+		return;
+	}
+
+	ret = oax4000_power_on(cam);
+	if (ret) {
+		dev_err(dev, "Failed to power on OAX4000: %d\n", ret);
+		return;
+	}
+
+	ret = oax4000_load_firmware(cam);
+	if (ret) {
+		dev_err(dev, "Failed to load firmware: %d\n", ret);
+		goto err_power_off;
+	}
+
+	cam->initialized = true;
+
+	ret = cam57_init_controls(cam);
+	if (ret) {
+		dev_err(dev, "Failed to initialize V4L2 controls: %d\n", ret);
+		goto err_power_off;
+	}
+
+	dev_info(dev, "CAM57 ISP / STURDeCAM57 deferred init complete\n");
+	return;
+err_power_off:
+	oax4000_power_off(cam);
+}
+
+/* -----------------------------------------------------------------------------
+ * Driver Probe & Runtime PM
+ * -----------------------------------------------------------------------------
+ */
+
+static const struct regmap_config cam57_regmap_config = {
+	.reg_bits = 16,
+	.val_bits = 8,
+	.max_register = 0xffff,
+};
+
+static int cam57_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct cam57_dev *cam;
+	struct fwnode_handle *endpoint;
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY
+	};
+	int ret;
+
+	cam = devm_kzalloc(dev, sizeof(*cam), GFP_KERNEL);
+	if (!cam)
+		return -ENOMEM;
+
+	cam->client  = client;
+	cam->gain    = 16;
+	cam->gain_ir = 16;
+	cam->current_mode = supported_modes;
+
+	INIT_DELAYED_WORK(&cam->init_work, cam57_init_work);
+
+	endpoint = fwnode_graph_get_endpoint_by_id(dev_fwnode(dev), 0, 0, 0);
+	if (!endpoint) {
+		dev_err(dev, "Failed to find endpoint fwnode in Device Tree\n");
+		return -ENODEV;
+	}
+
+	ret = v4l2_fwnode_endpoint_parse(endpoint, &bus_cfg);
+	fwnode_handle_put(endpoint);
+	if (ret) {
+		dev_err(dev, "Failed to parse endpoint fwnode: %d\n", ret);
+		return ret;
+	}
+
+	cam->regmap = devm_regmap_init_i2c(client, &cam57_regmap_config);
+	if (IS_ERR(cam->regmap))
+		return PTR_ERR(cam->regmap);
+
+	v4l2_i2c_subdev_init(&cam->sd, client, &cam57_subdev_ops);
+	cam->sd.internal_ops = &cam57_internal_ops;
+	cam->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE | V4L2_SUBDEV_FL_STREAMS;
+	cam->pad.flags = MEDIA_PAD_FL_SOURCE;
+	cam->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+
+	ret = media_entity_pads_init(&cam->sd.entity, 1, &cam->pad);
+	if (ret)
+		return ret;
+
+	ret = v4l2_subdev_init_finalize(&cam->sd);
+	if (ret)
+		goto err_entity_cleanup;
+
+	v4l2_ctrl_handler_init(&cam->ctrls, 16);
+	cam->sd.ctrl_handler = &cam->ctrls;
+        ret = v4l2_async_register_subdev(&cam->sd);
+	if (ret) {
+		dev_err(dev, "v4l2_async_register_subdev failed: %d\n", ret);
+		goto err_subdev_cleanup;
+	}
+
+	dev_info(dev, "CAM57 driver probed successfully sd=%s (awaiting link lock event)\n", cam->sd.name);
+	return 0;
+
+err_subdev_cleanup:
+	v4l2_subdev_cleanup(&cam->sd);
+err_entity_cleanup:
+	media_entity_cleanup(&cam->sd.entity);
+	return ret;
+}
+
+static void cam57_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct cam57_dev *cam = to_cam57(sd);
+
+	cancel_delayed_work_sync(&cam->init_work);
+
+	v4l2_async_unregister_subdev(sd);
+
+	v4l2_subdev_cleanup(sd);
+
+	if (cam->initialized) {
+		v4l2_ctrl_handler_free(&cam->ctrls);
+		oax4000_power_off(cam);
+	}
+
+	media_entity_cleanup(&sd->entity);
+}
