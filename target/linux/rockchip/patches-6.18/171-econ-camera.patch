+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Driver for eCon STURDeCAM31 containing Sony isx031 sensor.
+ */
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_graph.h>
+#include <linux/firmware.h>
+#include <linux/byteorder/generic.h>
+#include <linux/gpio/consumer.h>
+#include <linux/workqueue.h>
+
+#include <media/v4l2-async.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-event.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+#include <media/mipi-csi2.h>
+
+/* ST Bootloader Commands */
+#define BL_GET_VERSION                0x01
+#define BL_GO                         0x21
+#define BL_WRITE_MEM_NS               0x32
+#define BL_ERASE_MEM_NS               0x45
+#define RESP_ACK                      0x79
+#define RESP_BUSY                     0x76
+
+#define FLASH_START_ADDRESS           0x08000000
+#define ISX_BUFFER_SIZE               256
+
+/* Protocol Framing Constants */
+#define MCU_HEADER_SIZE			4
+#define MCU_MAX_PAYLOAD			256
+#define MCU_TIMEOUT_MS			1000
+#define MCU_CMD_SIGNATURE		0x43
+#define MCU_MAX_CONTROLS		32
+
+/*
+ * The max9296a driver doesn't implement a GPIO interface, so we must poke
+ * the GPIO registers directly via I2C.
+ */
+#define MAX9295A_SER_ADDR      0x40
+#define MAX9295A_REG_RESET     0x2ca  /* Serializer pin connected to MCU NRST */
+#define MAX9295A_REG_BOOT      0x2be  /* Serializer pin connected to MCU BOOT0 */
+#define MAX9295A_REG_GPIO3     0x2c7
+#define MAX9295A_REG_GPIO5     0x2cd
+#define MAX9295A_REG_GPIO7     0x2d3
+#define MAX9295A_REG_GPIO8     0x2d6
+
+#define CAM31_INIT_GPIOS
+
+#define MAX9295A_GPIO_HIGH     0x10
+#define MAX9295A_GPIO_LOW      0x00
+
+/* e-Con Proprietary Host Command Set */
+enum cam31_mcu_cmd_id {
+	CMD_ID_VERSION			= 0x00,
+	CMD_ID_GET_SENSOR_ID		= 0x01,
+	CMD_ID_GET_STREAM_INFO		= 0x02,
+	CMD_ID_GET_CTRL_INFO		= 0x03,
+	CMD_ID_INIT_CAM			= 0x04,
+	CMD_ID_GET_STATUS		= 0x05,
+	CMD_ID_DE_INIT_CAM		= 0x06,
+	CMD_ID_STREAM_ON		= 0x07,
+	CMD_ID_STREAM_OFF		= 0x08,
+	CMD_ID_STREAM_CONFIG		= 0x09,
+	CMD_ID_GET_CTRL_UI_INFO		= 0x0A,
+
+	CMD_ID_GET_CTRL			= 0x10,
+	CMD_ID_SET_CTRL			= 0x11,
+	CMD_ID_ISP_READ			= 0x12,
+	CMD_ID_ISP_WRITE		= 0x13,
+
+	CMD_ID_FW_UPDT			= 0x14,
+	CMD_ID_ISP_PDOWN		= 0x15,
+	CMD_ID_ISP_PUP			= 0x16,
+
+	CMD_ID_LANE_CONFIG		= 0x17,
+	CMD_ID_MIPI_CLK_CONFIG		= 0x18,
+
+	CMD_ID_SENSOR_READ		= 0x19,
+	CMD_ID_SENSOR_WRITE		= 0x1A,
+
+	/* ISX031-Specific Extended Commands */
+	CMD_ID_INIT_CAM_ISP		= 0xA0,
+	CMD_ID_INIT_CAM_ISP_ERASE	= 0xA1,
+	CMD_ID_FL_STATUS		= 0xA2,
+	CMD_ID_LOAD_PARAM_STATUS	= 0xA3,
+	CMD_ID_NV_STATUS		= 0xA4,
+	CMD_ID_XERROR_STATUS		= 0xA5,
+	CMD_ID_GET_FW_KEY		= 0xA6,
+	CMD_ID_INIT_FLASH_WP		= 0xA7,
+	CMD_ID_INIT_FLASH_WP_DISABLE	= 0xA8,
+	CMD_ID_VERSION_ISP		= 0xA9,
+	CMD_ID_GET_TEMPERATURE		= 0xAA,
+
+	CMD_ID_SET_ACK_RESPONSE_MODE	= 0xB0,
+};
+
+enum cam31_mcu_errcode {
+	ERRCODE_SUCCESS = 0x00,
+	ERRCODE_BUSY = 0x01,
+	ERRCODE_INVAL = 0x02,
+	ERRCODE_PERM = 0x03,
+	ERRCODE_NODEV = 0x04,
+	ERRCODE_IO = 0x05,
+	ERRCODE_HW_SPEC = 0x06,
+	ERRCODE_AGAIN = 0x07,
+	ERRCODE_ALREADY = 0x08,
+	ERRCODE_NOTIMPL = 0x09,
+	ERRCODE_RANGE = 0x0A,
+	ERRCODE_UNKNOWN = 0xFF,
+};
+
+#define MCU_CMD_STATUS_SUCCESS		0x0000
+#define MCU_CMD_STATUS_PENDING		0xF000
+#define MCU_CMD_STATUS_ISP_PWDN		0x0FF0
+#define MCU_CMD_STATUS_ISP_UNINIT	0x0FF1
+
+/* Custom V4L2 Control IDs matching e-Con Extension Controls */
+#define V4L2_CID_CAM31_BASE		(V4L2_CID_USER_BASE + 0x2000)
+#define V4L2_CID_CAM_MODE		(V4L2_CID_CAM31_BASE + 1)
+#define V4L2_CID_CUSTOM_TRIGGER		(V4L2_CID_CAM31_BASE + 2)
+#define V4L2_CID_FRAME_SYNC		(V4L2_CID_CAM31_BASE + 3)
+#define V4L2_CID_TRIGGER_MODE		(V4L2_CID_CAM31_BASE + 4)
+#define V4L2_CID_TEMPERATURE		(V4L2_CID_CAM31_BASE + 5)
+
+#define MAX_SUPPORTED_MODES	8
+
+struct cam31_mode {
+	u32 width;
+	u32 height;
+	u32 code;
+	u32 fourcc;
+	u16 fps_num;
+	u16 fps_denom;
+};
+
+struct cam31_ctrl {
+    u32 v4l2_cid;       /* Mapped V4L2 Control ID */
+    u8  ctrl_type;      /* 0x01 = Standard, 0x02 = Extended */
+    s32 min;
+    s32 max;
+    s32 def;
+    s32 step;
+    struct v4l2_ctrl *ctrl;
+};
+
+struct cam31_dev {
+	struct i2c_client *client;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *temperature_ctrl;
+
+	struct mutex lock; /* Protects stream & ctrl operations */
+	struct cam31_mode modes[MAX_SUPPORTED_MODES];
+	struct cam31_ctrl ctrldb[MCU_MAX_CONTROLS];
+	int num_modes;
+	int num_mcu_ctrls;
+	int current_mode;
+	bool streaming;
+
+	/* Deferred initialization work and state tracking */
+	struct delayed_work init_work;
+	bool initialized;
+};
+
+static inline struct cam31_dev *to_cam31_dev(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct cam31_dev, sd);
+}
+
+static int cam31_read_rx(struct i2c_client *client, u8 *buf, u32 len)
+{
+	struct i2c_msg msg = {
+		.addr = client->addr,
+		.flags = I2C_M_RD,
+		.len = len,
+		.buf = buf,
+	};
+	return (i2c_transfer(client->adapter, &msg, 1) == 1) ? 0 : -EIO;
+}
+
+static int cam31_write_tx(struct i2c_client *client, const u8 *buf, u32 len)
+{
+	struct i2c_msg msg = {
+		.addr = client->addr,
+		.flags = 0,
+		.len = len,
+		.buf = (u8 *)buf,
+	};
+	return (i2c_transfer(client->adapter, &msg, 1) == 1) ? 0 : -EIO;
+}
+
+static u8 cam31_checksum(const u8 *data, size_t len)
+{
+	u8 csum = 0;
+	size_t i;
+
+	for (i = 0; i < len; i++)
+		csum ^= data[i];
+
+	return csum;
+}
+
+/* ========================================================================= */
+/* SUBSYSTEM 1: Intel HEX Line Parser                                         */
+/* ========================================================================= */
+
+static int mcu_ascii2hex(u8 ascii)
+{
+	if (ascii <= '9') return ascii - '0';
+	if (ascii >= 'a' && ascii <= 'f') return 0xA + (ascii - 'a');
+	if (ascii >= 'A' && ascii <= 'F') return 0xA + (ascii - 'A');
+	return -EINVAL;
+}
+
+static int mcu_parse_hex_line(const u8 *ascii_buf, u8 *bin_buf, int ascii_len)
+{
+	u8 checksum = 0;
+	int i, bin_len = 0;
+
+	for (i = 0; i < ascii_len; i += 2) {
+		int hi = mcu_ascii2hex(ascii_buf[i]);
+		int lo = mcu_ascii2hex(ascii_buf[i + 1]);
+		if (hi < 0 || lo < 0) return -EINVAL;
+
+		bin_buf[bin_len] = (hi << 4) | lo;
+		checksum += bin_buf[bin_len];
+		bin_len++;
+	}
+
+	return (checksum == 0) ? bin_len : -EILSEQ;
+}
+
+/* ========================================================================= */
+/* SUBSYSTEM 2: ST Bootloader Engine & Jumper                                 */
+/* ========================================================================= */
+
+#define MAX_PAGES         512
+#define TOTAL_PAGES       1536
+#define NUM_ERASE_CYCLES  (TOTAL_PAGES / MAX_PAGES)
+
+static int mcu_bootloader_erase(struct i2c_client *client)
+{
+	u8 *buf;
+	u16 pagenum;
+	u8 checksum;
+	int i, ret = -EIO;
+
+	buf = kmalloc((2 * MAX_PAGES) + 1, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
+	for (i = 0; i < NUM_ERASE_CYCLES; i++) {
+		buf[0] = BL_ERASE_MEM_NS;
+		buf[1] = (u8)~BL_ERASE_MEM_NS;
+		ret = cam31_write_tx(client, buf, 2);
+		if (ret || cam31_read_rx(client, buf, 1) || buf[0] != RESP_ACK) {
+			dev_err(&client->dev, "Erase cycle %d header failed\n", i);
+			ret = -EIO;
+			goto out;
+		}
+
+		buf[0] = (MAX_PAGES - 1) >> 8;
+		buf[1] = (MAX_PAGES - 1) & 0xFF;
+		buf[2] = buf[0] ^ buf[1];
+		ret = cam31_write_tx(client, buf, 3);
+		if (ret || cam31_read_rx(client, buf, 1) || buf[0] != RESP_ACK) {
+			dev_err(&client->dev, "Erase cycle %d page count rejected\n", i);
+			ret = -EIO;
+			goto out;
+		}
+
+		checksum = 0x00;
+		for (pagenum = 0; pagenum < MAX_PAGES; pagenum++) {
+			u16 actual_page = pagenum + (i * MAX_PAGES);
+			buf[2 * pagenum]     = actual_page >> 8;
+			buf[(2 * pagenum) + 1] = actual_page & 0xFF;
+			checksum ^= buf[2 * pagenum] ^ buf[(2 * pagenum) + 1];
+		}
+		buf[2 * MAX_PAGES] = checksum;
+
+		ret = cam31_write_tx(client, buf, (2 * MAX_PAGES) + 1);
+		if (ret) {
+			dev_err(&client->dev, "Erase cycle %d page list write failed\n", i);
+			ret = -EIO;
+			goto out;
+		}
+
+		do {
+			msleep(20);
+			ret = cam31_read_rx(client, buf, 1);
+		} while (!ret && buf[0] == RESP_BUSY);
+
+		if (ret || buf[0] != RESP_ACK) {
+			dev_err(&client->dev, "Erase cycle %d failed (status: 0x%02x)\n", i, buf[0]);
+			ret = -EIO;
+			goto out;
+		}
+	}
+
+	ret = 0;
+
+out:
+	kfree(buf);
+	return ret;
+}
+
+static int mcu_bootloader_write_page(struct i2c_client *client, u32 flash_addr, const u8 *data, u8 len)
+{
+	u8 buf[260];
+	u8 checksum = 0;
+	int i;
+
+	if (flash_addr % 4096 == 0)
+		dev_info(&client->dev, "   loading MCU at %8x...", flash_addr);
+
+	buf[0] = BL_WRITE_MEM_NS;
+	buf[1] = ~BL_WRITE_MEM_NS;
+	if (cam31_write_tx(client, buf, 2) || cam31_read_rx(client, buf, 1) || buf[0] != RESP_ACK)
+		return -EIO;
+
+	buf[0] = (flash_addr >> 24) & 0xFF;
+	buf[1] = (flash_addr >> 16) & 0xFF;
+	buf[2] = (flash_addr >> 8) & 0xFF;
+	buf[3] = flash_addr & 0xFF;
+	buf[4] = buf[0] ^ buf[1] ^ buf[2] ^ buf[3];
+	if (cam31_write_tx(client, buf, 5) || cam31_read_rx(client, buf, 1) || buf[0] != RESP_ACK)
+		return -EIO;
+
+	buf[0] = len - 1;
+	checksum = buf[0];
+	for (i = 0; i < len; i++) {
+		buf[i + 1] = data[i];
+		checksum ^= data[i];
+	}
+	buf[len + 1] = checksum;
+
+	if (cam31_write_tx(client, buf, len + 2))
+		return -EIO;
+	while (true) {
+		if (cam31_read_rx(client, buf, 1))
+			return -EIO;
+		if (buf[0] == RESP_ACK)
+			break;
+		if (buf[0] == RESP_BUSY)
+			usleep_range(1000, 2000);
+		else
+			return -EIO;
+	}
+	return 0;
+}
+
+static int mcu_bootloader_go(struct i2c_client *client, u32 start_addr)
+{
+	u8 buf[5];
+
+	buf[0] = BL_GO;
+	buf[1] = ~BL_GO;
+	if (cam31_write_tx(client, buf, 2) || cam31_read_rx(client, buf, 1) || buf[0] != RESP_ACK)
+		return -EIO;
+
+	buf[0] = (start_addr >> 24) & 0xFF;
+	buf[1] = (start_addr >> 16) & 0xFF;
+	buf[2] = (start_addr >> 8) & 0xFF;
+	buf[3] = start_addr & 0xFF;
+	buf[4] = buf[0] ^ buf[1] ^ buf[2] ^ buf[3];
+
+	if (cam31_write_tx(client, buf, 5) || cam31_read_rx(client, buf, 1))
+		return -EIO;
+	if (buf[0] == RESP_ACK)
+		return 0;
+	return -EIO;
+}
+
+static int mcu_flash_intel_hex(struct i2c_client *client, const u8 *hex_data, size_t size)
+{
+	u32 line_start = 0, line_end = 0;
+	u32 upper_addr = 0x00000000;
+	u8 parsed[256];
+	int ret;
+
+	ret = mcu_bootloader_erase(client);
+	if (ret) return ret;
+
+	while (line_start < size) {
+		while (line_end < size && hex_data[line_end] != '\n' && hex_data[line_end] != '\r')
+			line_end++;
+
+		if (hex_data[line_start] == ':') {
+			int ascii_len = line_end - (line_start + 1);
+			int bin_len = mcu_parse_hex_line(&hex_data[line_start + 1], parsed, ascii_len);
+
+			if (bin_len > 0) {
+				u8 len = parsed[0];
+				u16 low_addr = (parsed[1] << 8) | parsed[2];
+				u8 type = parsed[3];
+				u8 *payload = &parsed[4];
+
+				if (type == 0x04 && len == 2) {
+					upper_addr = ((payload[0] << 8) | payload[1]) << 16;
+				} else if (type == 0x00) {
+					u32 target_addr = upper_addr | low_addr;
+					ret = mcu_bootloader_write_page(client, target_addr, payload, len);
+					if (ret) return ret;
+				} else if (type == 0x01) {
+					break;
+				}
+			}
+		}
+
+		while (line_end < size && (hex_data[line_end] == '\n' || hex_data[line_end] == '\r'))
+			line_end++;
+		line_start = line_end;
+	}
+
+	return mcu_bootloader_go(client, FLASH_START_ADDRESS);
+}
+
+/* -----------------------------------------------------------------------------
+ * MCU Packet Protocol Transport Layer
+ * -----------------------------------------------------------------------------
+ */
+static int cam31_get_cmd_status(struct i2c_client *client, enum cam31_mcu_cmd_id cmd_id)
+{
+	u8 cmd_1[5] = { MCU_CMD_SIGNATURE, CMD_ID_GET_STATUS, 0x00, 0x01, 0x01 };
+	u8 cmd_2[3] = { MCU_CMD_SIGNATURE, CMD_ID_GET_STATUS, cmd_id };
+	u_char cmd_buf[7];
+	int retry;
+
+	for (retry = 5; --retry >= 0;) {
+		if (cam31_write_tx(client, cmd_1, sizeof(cmd_1)) == 0
+		    && cam31_write_tx(client, cmd_2, sizeof(cmd_2)) == 0
+		    && cam31_read_rx(client, cmd_buf, sizeof(cmd_buf)) == 0) {
+			u8 orig_crc = cmd_buf[5];
+			u8 calc_crc = cam31_checksum(&cmd_buf[2], 3);
+			if (orig_crc == calc_crc) {
+				u32 cmd_status = (cmd_buf[3] << 8) | cmd_buf[4];
+				enum cam31_mcu_errcode errcode = cmd_buf[6];
+				if (cmd_status == MCU_CMD_STATUS_SUCCESS && errcode == ERRCODE_SUCCESS)
+					return 0;
+				else if (errcode == ERRCODE_AGAIN)
+					return -EAGAIN;
+				else if (errcode != ERRCODE_BUSY && cmd_status != MCU_CMD_STATUS_PENDING) {
+					if (errcode == ERRCODE_SUCCESS || errcode == ERRCODE_ALREADY)
+						return cmd_status;
+					else {
+						dev_warn(&client->dev, "cam31_status 0x%x: errcode:%d cmd_status = 0x%x\n",
+							 cmd_id, errcode, cmd_status);
+						return -EINVAL;
+					}
+				}
+			} else {
+				dev_warn(&client->dev, "cam31_status %x: crc:%x/%x\n",
+					 cmd_id, orig_crc, calc_crc);
+			}
+		}
+		msleep(50);
+	}
+	dev_err(&client->dev, "get_cmd_status %d: timed out\n", cmd_id);
+	return -ETIMEDOUT;
+}
+
+static int cam31_mcu_cmd(struct i2c_client *client, u8 cmd_id,
+			 const u8 *tx_msg, u16 tx_len,
+			 u8 *rx_msg, u16 rx_len)
+{
+	u8 hdr[3 + MCU_MAX_PAYLOAD];
+	int retry;
+	int ret;
+	u16 len;
+
+	if (tx_len > MCU_MAX_PAYLOAD)
+		return -EINVAL;
+
+	for (retry = 5; --retry >= 0; msleep(100) ) {
+		hdr[0] = MCU_CMD_SIGNATURE;
+		hdr[1] = cmd_id;
+		hdr[2] = (tx_len >> 8) & 0xFF;
+		hdr[3] = tx_len & 0xFF;
+		hdr[4] = cam31_checksum(&hdr[2], 2);
+
+		ret = cam31_write_tx(client, hdr, 5);
+		if (ret)
+			continue;
+		if (tx_len == 0)
+			ret = cam31_write_tx(client, hdr, 2);
+		else {
+			memcpy(&hdr[2], tx_msg, tx_len);
+			hdr[tx_len + 2] = cam31_checksum(&hdr[2], tx_len);
+			ret = cam31_write_tx(client, hdr, tx_len + 3);
+		}
+		if (ret)
+			continue;
+		if (cmd_id == CMD_ID_INIT_CAM_ISP_ERASE) {
+			msleep(18000);
+			goto done;
+		}
+		if (cmd_id == CMD_ID_INIT_FLASH_WP
+		    || cmd_id == CMD_ID_INIT_FLASH_WP_DISABLE) {
+			msleep(200);
+			goto done;
+		}
+		if (cmd_id == CMD_ID_INIT_CAM_ISP) {
+			msleep(10);
+			return ret;
+		}
+		if (rx_len == 0) {
+			ret = cam31_get_cmd_status(client, cmd_id);
+			goto done;
+		}
+		else {
+			ret = cam31_read_rx(client, hdr, 8);
+			if (ret < 0)
+				continue;
+			u8 orig_crc = hdr[4];
+			u8 err_code = hdr[5];
+			u8 calc_crc = cam31_checksum(&hdr[2], 2);
+			if (orig_crc != calc_crc) {
+				dev_warn(&client->dev, "cam31_mcu_cmd 0x%02x: crc=%x/%x\n",
+					cmd_id, orig_crc, calc_crc);
+				continue;
+			}
+			if (err_code != ERRCODE_SUCCESS) {
+				ret = err_code;
+				goto done;
+			}
+			len = (hdr[2] << 8) | hdr[3];
+			if (len > rx_len)
+				len = rx_len;
+			ret = cam31_read_rx(client, hdr, len + 4);
+			if (ret == 0) {
+				memcpy(rx_msg, &hdr[2], len);
+				goto done;
+			}
+		}
+	}
+ done:
+	if (ret < 0)
+		dev_err(&client->dev, "cam31_mcu_cmd 0x%02x failed: %d\n", cmd_id, ret);
+	else
+		dev_info(&client->dev, "mcu_cmd %02x tx:%*ph rx:%*ph\n",
+			 cmd_id, tx_len, tx_msg, rx_len, rx_msg);
+	return ret;
+}
+
+static int isp_flash_bootdata(struct i2c_client *client, const u8 *bin_data, size_t size)
+{
+	u8 tx_buf[260];
+	u32 total_chunks = size / ISX_BUFFER_SIZE;
+	u32 chunk;
+	int ret;
+
+	ret = cam31_mcu_cmd(client, CMD_ID_INIT_FLASH_WP_DISABLE, NULL, 0, NULL, 0);
+	if (ret < 0)
+		return ret;
+	msleep(200);
+
+	tx_buf[0] = 0;
+	dev_info(&client->dev, "Erasing ISP firmware...");
+	ret = cam31_mcu_cmd(client, CMD_ID_INIT_CAM_ISP_ERASE, tx_buf, 1, NULL, 0);
+	if (ret < 0)
+		return ret;
+
+	for (chunk = 0; chunk < total_chunks; chunk++) {
+		if (chunk % 32 == 0) {
+			dev_info(&client->dev, "   loading ISP at %d%%\n", chunk * 100 / total_chunks);
+		}
+		ret = cam31_mcu_cmd(client, CMD_ID_INIT_CAM_ISP,
+				    &bin_data[chunk * ISX_BUFFER_SIZE], ISX_BUFFER_SIZE,
+				    NULL, 0);
+		if (ret)
+			return ret;
+		msleep(50);
+	}
+
+	ret = cam31_mcu_cmd(client, CMD_ID_INIT_FLASH_WP, NULL, 0, NULL, 0);
+	if (ret)
+		return ret;
+
+	msleep(100);
+
+	return 0;
+}
+
+/* -----------------------------------------------------------------------------
+ * V4L2 Controls Handling
+ * -----------------------------------------------------------------------------
+ */
+struct cam31_mcu_set_ctrl_payload {
+	__be32 ctrl_id;
+	u8     ctrl_type;
+	__be32 val;
+	__be16 reserved;
+} __packed;
+
+struct cam31_mcu_get_ctrl_payload {
+	__be32 ctrl_id;   
+	u8     ctrl_type; 
+} __packed;
+
+static struct cam31_ctrl *cam31_find_ctrl(struct cam31_dev *cam, u32 v4l2_cid)
+{
+	int i;
+	for (i = 0; i < cam->num_mcu_ctrls; i++) {
+		if (cam->ctrldb[i].v4l2_cid == v4l2_cid)
+			return &cam->ctrldb[i];
+	}
+	return NULL;
+}
+
+static int cam31_g_volatile_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct cam31_dev *cam = container_of(ctrl->handler, struct cam31_dev, ctrls);
+	struct cam31_ctrl *map;
+	struct cam31_mcu_get_ctrl_payload tx_payload;
+	u8 rx_buf[10];
+	int ret;
+
+	if (!cam->initialized)
+		return -EAGAIN;
+
+	map = cam31_find_ctrl(cam, ctrl->id);
+	if (!map)
+		return -EINVAL;
+
+	memset(&tx_payload, 0, sizeof(tx_payload));
+	tx_payload.ctrl_id   = cpu_to_be32(map->v4l2_cid);
+	tx_payload.ctrl_type = map->ctrl_type;
+
+	ret = cam31_mcu_cmd(cam->client, CMD_ID_GET_CTRL,
+			    (u8 *)&tx_payload, sizeof(tx_payload),
+			    rx_buf, sizeof(rx_buf));
+	if (ret)
+		return ret;
+
+	ctrl->val = (s32)be32_to_cpup((__be32 *)&rx_buf[5]);
+	return 0;
+}
+
+static int cam31_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct cam31_dev *cam = container_of(ctrl->handler, struct cam31_dev, ctrls);
+	struct cam31_ctrl *map;
+	struct cam31_mcu_set_ctrl_payload payload;
+
+	if (!cam->initialized)
+		return -EAGAIN;
+
+	map = cam31_find_ctrl(cam, ctrl->id);
+	if (!map)
+		return -EINVAL;
+
+	memset(&payload, 0, sizeof(payload));
+	payload.ctrl_id   = cpu_to_be32(map->v4l2_cid);
+	payload.ctrl_type = map->ctrl_type;
+	payload.val       = cpu_to_be32(ctrl->val);
+
+	return cam31_mcu_cmd(cam->client, CMD_ID_SET_CTRL,
+			     (u8 *)&payload, sizeof(payload), NULL, 0);
+}
+
+static const struct v4l2_ctrl_ops cam31_ctrl_ops = {
+	.s_ctrl          = cam31_s_ctrl,
+	.g_volatile_ctrl = cam31_g_volatile_ctrl,
+};
+
+static bool cam31_is_valid_isx031_ctrl(u32 cid)
+{
+	switch (cid) {
+	case V4L2_CID_BRIGHTNESS:
+	case V4L2_CID_CONTRAST:
+	case V4L2_CID_SATURATION:
+	case V4L2_CID_SHARPNESS:
+	case V4L2_CID_FRAME_SYNC:
+	case V4L2_CID_HUE:
+	case V4L2_CID_EXPOSURE_AUTO:
+	case V4L2_CID_EXPOSURE_ABSOLUTE:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static int cam31_init_controls(struct cam31_dev *cam)
+{
+	struct v4l2_ctrl_handler *hdl = &cam->ctrls;
+	u8 tx_payload[2];
+	u8 rx_buf[64];
+	u16 index = 0;
+	int ret;
+
+	v4l2_ctrl_handler_init(hdl, MCU_MAX_CONTROLS);
+
+	while (index < MCU_MAX_CONTROLS) {
+		tx_payload[0] = (index >> 8) & 0xFF;
+		tx_payload[1] = index & 0xFF;
+
+		ret = cam31_mcu_cmd(cam->client, CMD_ID_GET_CTRL_INFO,
+				    tx_payload, 2, rx_buf, sizeof(rx_buf));
+		if (ret)
+			break;
+
+		u32 cid = (rx_buf[0] << 24) | (rx_buf[1] << 16) | (rx_buf[2] << 8) | rx_buf[3];
+
+		if (!cam31_is_valid_isx031_ctrl(cid)) {
+			index++;
+			continue;
+		}
+
+		struct cam31_ctrl *map = &cam->ctrldb[cam->num_mcu_ctrls];
+		map->v4l2_cid  = cid;
+		map->ctrl_type = rx_buf[4];
+		map->min       = (s32)be32_to_cpup((__be32 *)&rx_buf[5]);
+		map->max       = (s32)be32_to_cpup((__be32 *)&rx_buf[9]);
+		map->def       = (s32)be32_to_cpup((__be32 *)&rx_buf[13]);
+		map->step      = (s32)be32_to_cpup((__be32 *)&rx_buf[17]);
+
+		if (map->v4l2_cid == V4L2_CID_EXPOSURE_AUTO) {
+			map->ctrl = v4l2_ctrl_new_std_menu(hdl, &cam31_ctrl_ops,
+							   map->v4l2_cid, map->max,
+							   0, map->def);
+		} else {
+			map->ctrl = v4l2_ctrl_new_std(hdl, &cam31_ctrl_ops,
+						      map->v4l2_cid, map->min, map->max,
+						      map->step, map->def);
+		}
+
+		if (map->ctrl) {
+			dev_info(&cam->client->dev, "Registered MCU Ctrl 0x%08x [%d..%d]\n",
+				 map->v4l2_cid, map->min, map->max);
+			cam->num_mcu_ctrls++;
+		}
+		index++;
+	}
+
+	if (hdl->error) {
+		v4l2_ctrl_handler_free(hdl);
+		return hdl->error;
+	}
+
+	cam->sd.ctrl_handler = hdl;
+	return 0;
+}
+
+static int cam31_isp_read_reg(struct i2c_client *client, u16 reg_addr)
+{
+    u8 tx_payload[3];
+    u8 rx_buf[4] = {0};
+    int ret;
+
+    tx_payload[0] = (reg_addr >> 8) & 0xFF;
+    tx_payload[1] = reg_addr & 0xFF;
+    tx_payload[2] = 2;
+
+    ret = cam31_mcu_cmd(client, CMD_ID_ISP_READ, tx_payload, 3, rx_buf, sizeof(rx_buf));
+    if (ret) {
+        dev_err(&client->dev, "ISP read reg 0x%04x failed: %d\n", reg_addr, ret);
+        return ret;
+    }
+
+    return (rx_buf[3] << 8) | rx_buf[2];
+}
+
+/* -----------------------------------------------------------------------------
+ * Hardware Hardware Initialization & Driver Probe
+ * -----------------------------------------------------------------------------
+ */
+static int max9295a_write_reg16(struct i2c_client *client, u16 reg, u8 val)
+{
+	u8 buf[3] = { (u8)(reg >> 8), (u8)(reg & 0xFF), val };
+	struct i2c_msg msg = {
+		.addr = MAX9295A_SER_ADDR,
+		.flags = 0,
+		.len = 3,
+		.buf = buf,
+	};
+
+	return (i2c_transfer(client->adapter, &msg, 1) == 1) ? 0 : -EIO;
+}
+
+#ifdef CAM31_INIT_GPIOS
+/*
+ * Initialize all the crazy insane GPIO initialization required
+ * on the serializer to boot the ISX031 ISP.
+ */
+static int cam31_init_gpios(struct i2c_client *client)
+{
+    int ret;
+
+    ret = max9295a_write_reg16(client, MAX9295A_REG_BOOT, MAX9295A_GPIO_LOW);
+    if (ret) return ret;
+
+    ret = max9295a_write_reg16(client, MAX9295A_REG_GPIO7, MAX9295A_GPIO_LOW);
+    if (ret) return ret;
+
+    ret = max9295a_write_reg16(client, MAX9295A_REG_GPIO8, MAX9295A_GPIO_LOW);
+    if (ret) return ret;
+    ret = max9295a_write_reg16(client, MAX9295A_REG_GPIO8, MAX9295A_GPIO_HIGH);
+    if (ret) return ret;
+
+    ret = max9295a_write_reg16(client, MAX9295A_REG_GPIO3, MAX9295A_GPIO_LOW);
+    if (ret) return ret;
+
+    ret = max9295a_write_reg16(client, MAX9295A_REG_GPIO5, MAX9295A_GPIO_HIGH);
+    if (ret) return ret;
+
+    msleep(20);
+    return 0;
+}
+#endif
+
+/* -----------------------------------------------------------------------------
+ * V4L2 Subdevice Operations
+ * -----------------------------------------------------------------------------
+ */
+struct cam31_stream_config_payload {
+	__be16 mode_index;
+	__be32 fourcc;
+	__be16 width;
+	__be16 height;
+	__be16 fps_num;
+	__be16 fps_den;
+} __packed;
+
+static int cam31_s_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct cam31_dev *cam = to_cam31_dev(sd);
+	struct cam31_stream_config_payload payload;
+	const struct cam31_mode *mode;
+	int ret = 0;
+
+	if (!cam->initialized)
+		return -EAGAIN;
+
+	mutex_lock(&cam->lock);
+
+	if (cam->streaming == !!enable)
+		goto out;
+
+	if (enable) {
+		mode = &cam->modes[cam->current_mode];
+
+		payload.mode_index = cpu_to_be16(cam->current_mode);
+		payload.fourcc     = cpu_to_be32(mode->fourcc);
+		payload.width      = cpu_to_be16(mode->width);
+		payload.height     = cpu_to_be16(mode->height);
+		payload.fps_num    = cpu_to_be16(mode->fps_num);
+		payload.fps_den    = cpu_to_be16(mode->fps_denom ? mode->fps_denom : 1);
+
+		ret = cam31_mcu_cmd(cam->client, CMD_ID_STREAM_CONFIG,
+				     (u8 *)&payload, sizeof(payload), NULL, 0);
+		if (ret) {
+			dev_err(&cam->client->dev,
+				"Failed to send stream config: %d\n", ret);
+			goto out;
+		}
+
+		ret = cam31_mcu_cmd(cam->client, CMD_ID_STREAM_ON, NULL, 0, NULL, 0);
+		if (!ret)
+			cam->streaming = true;
+
+		dev_info(&cam->client->dev, "ISP frame count #1: %x\n", cam31_isp_read_reg(cam->client, 0x7dc8));
+		dev_info(&cam->client->dev, "ISP standby state: %x\n", cam31_isp_read_reg(cam->client, 0x6005));
+		dev_info(&cam->client->dev, "ISP chip ID: %x\n", cam31_isp_read_reg(cam->client, 0x8a54));
+                msleep(50);
+		dev_info(&cam->client->dev, "ISP frame count #2: %x\n", cam31_isp_read_reg(cam->client, 0x7dc8));
+                msleep(50);
+		dev_info(&cam->client->dev, "ISP frame count #3: %x\n", cam31_isp_read_reg(cam->client, 0x7dc8));
+                msleep(50);
+		dev_info(&cam->client->dev, "ISP frame count #4: %x\n", cam31_isp_read_reg(cam->client, 0x7dc8));
+	} else {
+		ret = cam31_mcu_cmd(cam->client, CMD_ID_STREAM_OFF, NULL, 0, NULL, 0);
+		if (!ret)
+			cam->streaming = false;
+	}
+
+out:
+	mutex_unlock(&cam->lock);
+	return ret;
+}
+
+static int cam31_enum_mbus_code(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *sd_state,
+				struct v4l2_subdev_mbus_code_enum *code)
+{
+	struct cam31_dev *cam = to_cam31_dev(sd);
+
+	if (code->index >= cam->num_modes)
+		return -EINVAL;
+
+	code->code = cam->modes[code->index].code;
+	return 0;
+}
+
+static int cam31_enum_frame_size(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct cam31_dev *cam = to_cam31_dev(sd);
+
+	if (fse->index >= cam->num_modes)
+		return -EINVAL;
+
+	if (fse->code != cam->modes[fse->index].code)
+		return -EINVAL;
+
+	fse->min_width = cam->modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = cam->modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int cam31_get_frame_desc(struct v4l2_subdev *sd, unsigned int pad,
+				struct v4l2_mbus_frame_desc *fd)
+{
+	if (pad != 0)
+		return -EINVAL;
+	memset(fd, 0, sizeof(*fd));
+	fd->type = V4L2_MBUS_FRAME_DESC_TYPE_CSI2;
+	fd->num_entries = 1;
+	fd->entry[0].stream = 0;
+	fd->entry[0].flags = V4L2_MBUS_FRAME_DESC_FL_LEN_MAX;
+	fd->entry[0].pixelcode = MEDIA_BUS_FMT_UYVY8_1X16;
+	fd->entry[0].bus.csi2.vc = 0;
+	fd->entry[0].bus.csi2.dt = MIPI_CSI2_DT_YUV422_8B;
+	return 0;
+}
+
+static int cam31_get_fmt(struct v4l2_subdev *sd,
+			 struct v4l2_subdev_state *sd_state,
+			 struct v4l2_subdev_format *fmt)
+{
+	struct cam31_dev *cam = to_cam31_dev(sd);
+	struct v4l2_mbus_framefmt *mbus_fmt = &fmt->format;
+	const struct cam31_mode *mode = &cam->modes[cam->current_mode];
+
+	mutex_lock(&cam->lock);
+	mbus_fmt->width = mode->width;
+	mbus_fmt->height = mode->height;
+	mbus_fmt->code = mode->code;
+	mbus_fmt->field = V4L2_FIELD_NONE;
+	mbus_fmt->colorspace = V4L2_COLORSPACE_SRGB;
+	mutex_unlock(&cam->lock);
+
+	return 0;
+}
+
+static int cam31_set_fmt(struct v4l2_subdev *sd,
+			 struct v4l2_subdev_state *sd_state,
+			 struct v4l2_subdev_format *fmt)
+{
+	struct cam31_dev *cam = to_cam31_dev(sd);
+	const struct cam31_mode *mode;
+
+	if (fmt->pad != 0)
+		return -EINVAL;
+
+	mode = v4l2_find_nearest_size(cam->modes,
+				      cam->num_modes,
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	mutex_lock(&cam->lock);
+	if (cam->streaming) {
+		mutex_unlock(&cam->lock);
+		return -EBUSY;
+	}
+
+	cam->current_mode = mode - cam->modes;
+
+	fmt->format.width = mode->width;
+	fmt->format.height = mode->height;
+	fmt->format.code = MEDIA_BUS_FMT_UYVY8_1X16;
+	fmt->format.field = V4L2_FIELD_NONE;
+	fmt->format.colorspace = V4L2_COLORSPACE_SRGB;
+	mutex_unlock(&cam->lock);
+	return 0;
+}
+
+static int cam31_init_state(struct v4l2_subdev *sd,
+			    struct v4l2_subdev_state *sd_state)
+{
+	struct cam31_dev *cam = to_cam31_dev(sd);
+
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.format = {
+			.width = cam->modes[0].width,
+			.height = cam->modes[0].height,
+			.code = cam->modes[0].code,
+			.field = V4L2_FIELD_NONE,
+		},
+	};
+
+	return cam31_set_fmt(sd, sd_state, &fmt);
+}
+
+static int cam31_core_reset(struct v4l2_subdev *sd, u32 val)
+{
+	struct cam31_dev *cam = to_cam31_dev(sd);
+
+	if (val) {
+		dev_info(&cam->client->dev, "Link locked! Scheduling delayed init...\n");
+		schedule_delayed_work(&cam->init_work, msecs_to_jiffies(100));
+	} else {
+		dev_warn(&cam->client->dev, "Link lost! Resetting initialized state...\n");
+		cancel_delayed_work_sync(&cam->init_work);
+		if (cam->initialized) {
+			v4l2_ctrl_handler_free(&cam->ctrls);
+			cam->initialized = false;
+		}
+        }
+	return 0;
+}
+
+static const struct v4l2_subdev_core_ops cam31_core_ops = {
+	.reset = cam31_core_reset,
+};
+
+static const struct v4l2_subdev_internal_ops cam31_internal_ops = {
+	.init_state = cam31_init_state,
+};
+
+static const struct v4l2_subdev_video_ops cam31_video_ops = {
+	.s_stream = cam31_s_stream,
+};
+
+static const struct v4l2_subdev_pad_ops cam31_pad_ops = {
+	.enum_mbus_code = cam31_enum_mbus_code,
+	.enum_frame_size = cam31_enum_frame_size,
+	.get_frame_desc = cam31_get_frame_desc,
+	.get_fmt = cam31_get_fmt,
+	.set_fmt = cam31_set_fmt,
+};
+
+static const struct v4l2_subdev_ops cam31_subdev_ops = {
+	.core = &cam31_core_ops,
+	.video = &cam31_video_ops,
+	.pad = &cam31_pad_ops,
+};
+
+static int mcu_pulse_reset(struct i2c_client *client)
+{
+	int ret;
+
+	ret = max9295a_write_reg16(client, MAX9295A_REG_RESET, MAX9295A_GPIO_LOW);
+	if (ret)
+		return ret;
+	msleep(1);
+
+	ret = max9295a_write_reg16(client, MAX9295A_REG_RESET, MAX9295A_GPIO_HIGH);
+	if (ret)
+		return ret;
+	msleep(1);
+	return 0;
+}
+
+static int mcu_boot_mode(struct i2c_client *client)
+{
+	int retry;
+	u8 buf[2] = { BL_GET_VERSION, ~BL_GET_VERSION };
+	u8 ack;
+	
+	for (retry = 10; --retry >= 0; ) {
+		if (cam31_write_tx(client, buf, sizeof(buf)) == 0
+		    && cam31_read_rx(client, &ack, 1) == 0
+		    && ack == 'y'
+		    && cam31_read_rx(client, &ack, 1) == 0
+		    && cam31_read_rx(client, &ack, 1) == 0) {
+			return 0;
+		}
+		if (max9295a_write_reg16(client, MAX9295A_REG_BOOT, MAX9295A_GPIO_LOW) == 0
+		    && max9295a_write_reg16(client, MAX9295A_REG_BOOT, MAX9295A_GPIO_HIGH) == 0) {
+			msleep(1);
+			if (mcu_pulse_reset(client) == 0)
+				return 0;
+		}
+		msleep(100);
+	}
+	return -EIO;
+}
+
+static int cam31_power_on(struct cam31_dev *cam)
+{
+	int ret;
+
+	ret = cam31_mcu_cmd(cam->client, CMD_ID_INIT_FLASH_WP_DISABLE, NULL, 0, NULL, 0);
+	if (ret < 0)
+		return ret;
+
+	ret = cam31_mcu_cmd(cam->client, CMD_ID_INIT_CAM, NULL, 0, NULL, 0);
+	if (ret)
+		return ret;
+	return 0;
+}
+
+static u32 cam31_fourcc_to_mbus(u32 fourcc)
+{
+	switch (fourcc) {
+	case V4L2_PIX_FMT_UYVY:
+		return MEDIA_BUS_FMT_UYVY8_1X16;
+	case V4L2_PIX_FMT_YUYV:
+		return MEDIA_BUS_FMT_YUYV8_1X16;
+	case V4L2_PIX_FMT_SGRBG10:
+		return MEDIA_BUS_FMT_SGRBG10_1X10;
+	case V4L2_PIX_FMT_SRGGB10:
+		return MEDIA_BUS_FMT_SRGGB10_1X10;
+	default:
+		return MEDIA_BUS_FMT_UYVY8_1X16;
+	}
+}
+
+static int cam31_query_stream_info(struct cam31_dev *cam)
+{
+	struct i2c_client *client = cam->client;
+	u8 tx_payload[2];
+	u8 rx_buf[16];
+	u16 index = 0;
+	int ret;
+
+	while (index < MAX_SUPPORTED_MODES) {
+		tx_payload[0] = (index >> 8) & 0xff;
+		tx_payload[1] = index & 0xff;
+		ret = cam31_mcu_cmd(cam->client, CMD_ID_GET_STREAM_INFO, tx_payload, 2, rx_buf, sizeof(rx_buf));
+		if (ret)
+			break;
+
+		cam->modes[index].fourcc = (rx_buf[0] << 24) | (rx_buf[1] << 16) | (rx_buf[2] << 8) | rx_buf[3];
+		cam->modes[index].code = cam31_fourcc_to_mbus(cam->modes[index].fourcc);
+		cam->modes[index].width = (rx_buf[4] << 8) | rx_buf[5];
+		cam->modes[index].height = (rx_buf[6] << 8) | rx_buf[7];
+
+		if (rx_buf[8] == 0x01) {
+			cam->modes[index].fps_num = (rx_buf[9] << 8) | rx_buf[10];
+			cam->modes[index].fps_denom = (rx_buf[11] << 8) | rx_buf[12];
+		}
+
+		dev_info(&client->dev, "mode[%d]: %dx%d FOURCC: 0x%08x @ %d/%d FPS\n",
+			 index, cam->modes[index].width, cam->modes[index].height,
+			 cam->modes[index].fourcc, cam->modes[index].fps_num, cam->modes[index].fps_denom);
+		index++;
+	}
+
+	if (index > 0) {
+		cam->num_modes = index;
+	} else {
+		cam->num_modes = 1;
+		cam->modes[0].width = 1920;
+		cam->modes[0].height = 1536;
+		cam->modes[0].fourcc = V4L2_PIX_FMT_UYVY;
+		cam->modes[0].code = MEDIA_BUS_FMT_UYVY8_1X16;
+		cam->modes[0].fps_num = 1;
+		cam->modes[0].fps_denom = 30;
+	}
+	return 0;
+}
+
+static int cam31_load_firmware(struct cam31_dev *cam)
+{
+	struct i2c_client *client = cam->client;
+	bool load_mcu_fw = true;
+	bool load_isp_fw = true;
+	u8 rx_buf[32];
+	int ret;
+
+	ret = cam31_mcu_cmd(cam->client, CMD_ID_VERSION, NULL, 0, rx_buf, sizeof(rx_buf));
+	if (ret && load_mcu_fw) {
+		const char *mcu_fw_name = "cam31_mcu_fw.bin";
+		const struct firmware *mcu_fw = NULL;
+
+		of_property_read_string(client->dev.of_node, "mcu_fw_name", &mcu_fw_name);
+		ret = request_firmware(&mcu_fw, mcu_fw_name, &client->dev);
+		if (ret) {
+			dev_err(&client->dev, "Failed to load MCU firmware %s: %d\n", mcu_fw_name, ret);
+			return ret;
+		}
+
+		ret = mcu_boot_mode(cam->client);
+		if (ret) {
+			dev_err(&client->dev, "Cannot enter boot mode\n");
+			return ret;
+		}
+		ret = max9295a_write_reg16(cam->client, MAX9295A_REG_BOOT, MAX9295A_GPIO_LOW);
+		if (ret) {
+			dev_err(&client->dev, "Cannot assert BOOT: %d\n", ret);
+			return ret;
+		}
+		msleep(100);
+
+		ret = mcu_flash_intel_hex(client, mcu_fw->data, mcu_fw->size);
+		release_firmware(mcu_fw);
+		if (ret) {
+			dev_err(&client->dev, "MCU Firmware Flash failed: %d\n", ret);
+			return ret;
+		}
+		msleep(1000);
+		ret = cam31_mcu_cmd(cam->client, CMD_ID_VERSION, NULL, 0, rx_buf, sizeof(rx_buf));
+		if (ret)
+			return ret;
+	}
+	dev_info(&client->dev, "Firmware Version %.32s\n", rx_buf);
+
+	/* Check if ISP SPI Flash is unprogrammed */
+	ret = cam31_mcu_cmd(cam->client, CMD_ID_FL_STATUS, NULL, 0, rx_buf, sizeof(rx_buf));
+	if (ret < 0)
+		dev_err(&client->dev, "Cannot read SPI flash status\n");
+	else if (rx_buf[0] == 0x01) {
+		ret = cam31_mcu_cmd(cam->client, CMD_ID_VERSION_ISP, NULL, 0, rx_buf, sizeof(rx_buf));
+		if (ret)
+			dev_warn(&client->dev, "CAM31 ISP version unknown\n");
+		else
+			dev_info(&client->dev, "CAM31 ISP version %.32s\n", rx_buf);
+	}
+	else if (load_isp_fw) {
+		const struct firmware *isp_fw = NULL;
+		const char *isp_fw_name = "cam31_isp_fw.bin";
+
+		of_property_read_string(client->dev.of_node, "isp_fw_name", &isp_fw_name);
+		ret = request_firmware(&isp_fw, isp_fw_name, &client->dev);
+		if (ret) {
+			dev_err(&client->dev, "Failed to load ISP firmware %s: %d\n", isp_fw_name, ret);
+			return ret;
+		}
+
+		ret = isp_flash_bootdata(client, isp_fw->data, isp_fw->size);
+		release_firmware(isp_fw);
+		if (ret) {
+			dev_err(&client->dev, "ISP Firmware Flash failed: %d\n", ret);
+			return ret;
+		}
+		dev_info(&client->dev, "CAM31 firmware load successful\n");
+	}
+	return ret;
+}
+
+/* -----------------------------------------------------------------------------
+ * Deferred Work Initialization
+ * -----------------------------------------------------------------------------
+ */
+
+static void cam31_init_work(struct work_struct *work)
+{
+	struct cam31_dev *cam = container_of(work, struct cam31_dev, init_work.work);
+	struct i2c_client *client = cam->client;
+	struct device *dev = &client->dev;
+	int ret;
+
+	if (cam->initialized)
+		return;
+
+	dev_info(dev, "Initializing...\n");
+
+#ifdef CAM31_INIT_GPIOS
+	cam31_init_gpios(client);
+	mcu_pulse_reset(client);
+#else
+	mcu_bootloader_go(client, FLASH_START_ADDRESS);
+#endif
+	msleep(250);
+
+	ret = cam31_load_firmware(cam);
+	if (ret) {
+		dev_err(dev, "Failed to load firmware: %d\n", ret);
+		return;
+	}
+
+	ret = cam31_power_on(cam);
+	if (ret) {
+		dev_err(dev, "Failed to power on MCU/camera: %d\n", ret);
+		return;
+	}
+
+	ret = cam31_query_stream_info(cam);
+	if (ret) {
+		dev_err(dev, "Failed to query stream modes: %d\n", ret);
+		return;
+	}
+
+	ret = cam31_init_controls(cam);
+	if (ret) {
+		dev_err(dev, "Failed to initialize controls: %d\n", ret);
+		return;
+	}
+
+	cam->initialized = true;
+	dev_info(dev, "CAM31 (Sony ISX031 via MCU) deferred init complete\n");
+}
+
+/* -----------------------------------------------------------------------------
+ * Driver Probe & Remove
+ * -----------------------------------------------------------------------------
+ */
+
+static int cam31_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct cam31_dev *cam;
+	int ret;
+
+	cam = devm_kzalloc(dev, sizeof(*cam), GFP_KERNEL);
+	if (!cam)
+		return -ENOMEM;
+
+	cam->client = client;
+	cam->current_mode = 0;
+	mutex_init(&cam->lock);
+
+	INIT_DELAYED_WORK(&cam->init_work, cam31_init_work);
+
+	/* Initialize fallback default mode before async query */
+	cam->num_modes = 1;
+	cam->modes[0].width = 1920;
+	cam->modes[0].height = 1536;
+	cam->modes[0].fourcc = V4L2_PIX_FMT_UYVY;
+	cam->modes[0].code = MEDIA_BUS_FMT_UYVY8_1X16;
+	cam->modes[0].fps_num = 1;
+	cam->modes[0].fps_denom = 30;
+
+	v4l2_i2c_subdev_init(&cam->sd, client, &cam31_subdev_ops);
+	cam->sd.internal_ops = &cam31_internal_ops;
+	cam->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	cam->pad.flags = MEDIA_PAD_FL_SOURCE;
+	cam->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+
+	ret = media_entity_pads_init(&cam->sd.entity, 1, &cam->pad);
+	if (ret)
+		goto err_mutex_cleanup;
+
+	ret = v4l2_subdev_init_finalize(&cam->sd);
+	if (ret)
+		goto err_entity_cleanup;
+
+        ret = v4l2_async_register_subdev(&cam->sd);
+	if (ret) {
+		dev_err(dev, "v4l2_async_register_subdev failed: %d\n", ret);
+		goto err_subdev_cleanup;
+	}
+
+	dev_info(dev, "CAM31 driver probed successfully (awaiting link lock)\n");
+	return 0;
+
+err_subdev_cleanup:
+	v4l2_subdev_cleanup(&cam->sd);
+err_entity_cleanup:
+	media_entity_cleanup(&cam->sd.entity);
+err_mutex_cleanup:
+	mutex_destroy(&cam->lock);
+	return ret;
+}
+
+static void cam31_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct cam31_dev *cam = to_cam31_dev(sd);
+
+	cancel_delayed_work_sync(&cam->init_work);
+
+        v4l2_async_unregister_subdev(sd);
+
+	if (cam->initialized) {
+		v4l2_ctrl_handler_free(&cam->ctrls);
+		cam31_mcu_cmd(cam->client, CMD_ID_DE_INIT_CAM, NULL, 0, NULL, 0);
+	}
+
+	media_entity_cleanup(&sd->entity);
+	mutex_destroy(&cam->lock);
+}
+
+static const struct of_device_id cam31_of_match[] = {
+	{ .compatible = "econ,cam31" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, cam31_of_match);
+
+static struct i2c_driver cam31_i2c_driver = {
+	.driver = {
+		.name = "econ-cam31",
+		.of_match_table = cam31_of_match,
+	},
+	.probe = cam31_probe,
+	.remove = cam31_remove,
+};
+
+module_i2c_driver(cam31_i2c_driver);
+
+MODULE_DESCRIPTION("Mainline Linux V4L2 Subdevice Driver for e-Con STURDeCAM31");
+MODULE_AUTHOR("System Developer");
+MODULE_LICENSE("GPL");
diff --git a/drivers/media/i2c/econ-cam57.c b/drivers/media/i2c/econ-cam57.c
new file mode 100644
index 000000000000..c42932d80f68
--- /dev/null
+++ b/drivers/media/i2c/econ-cam57.c
@@ -0,0 +1,1150 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Driver for eCon STURDeCAM57 containing oax4000 ISP connected to OmniVision ox05b1s sensor.
+ */
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/regmap.h>
+#include <linux/workqueue.h>
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-event.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+#include <media/mipi-csi2.h>
+#include <linux/firmware.h>
+
+/* Custom V4L2 Control CIDs for OAX4000 Dual RGB-IR ISP */
+#define V4L2_CID_CUSTOM_BASE                    (V4L2_CID_USER_BASE + 0x1000)
+
+#define V4L2_CID_CUSTOM_EXPOSURE_AUTO_IR        (V4L2_CID_CUSTOM_BASE + 1)
+#define V4L2_CID_CUSTOM_EXPOSURE_ABSOLUTE_IR    (V4L2_CID_CUSTOM_BASE + 2)
+#define V4L2_CID_CUSTOM_GAIN_IR                 (V4L2_CID_CUSTOM_BASE + 3)
+#define V4L2_CID_CUSTOM_MODE_SELECT             (V4L2_CID_CUSTOM_BASE + 4)
+#define V4L2_CID_CUSTOM_FSYNC_ENABLE            (V4L2_CID_CUSTOM_BASE + 5)
+
+#define CAM57_NUM_STREAMS  2   /* Stream 0: VC0 (RGB), Stream 1: VC1 (IR) */
+
+#define CAM57_FIRMWARE_NAME "cam57_isp_fw.bin"
+
+/* OAX4000 Serial Flash / SRAM Host Commands from oax4000.h */
+#define CMD_SERIAL_FLASH_ERASE           0x31
+#define CMD_SERIAL_FLASH_PAGE_PROGRAM    0x32
+#define CMD_SERIAL_FLASH_READ		 0x33
+#define CMD_SERIAL_FLASH_STA_GET         0x35
+
+struct cam57_mode {
+	u32 width;
+	u32 height;
+	u32 code;
+	const struct reg_sequence *reg_list;
+	unsigned int num_regs;
+};
+
+struct cam57_dev {
+	struct i2c_client *client;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct regmap *regmap;
+	
+	/* Hardware Control Lines */
+	struct gpio_desc *reset_gpio; /* Controls MFP4 on MAX96717 */
+	struct i2c_client *i2c_switch; /* Client handle for 0x70 switch if needed */
+	
+	struct v4l2_ctrl_handler ctrls;
+	const struct cam57_mode *cur_mode;
+	u16 gain, gain_ir;
+	bool streaming;
+
+	/* Deferred initialization work and status flags */
+	struct delayed_work init_work;
+	bool initialized;
+};
+
+static inline struct cam57_dev *to_cam57(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct cam57_dev, sd);
+}
+
+#define OAX4000_MAILBOX_BASE    0x3000
+#define OAX4000_CMD_TRIGGER_REG 0x80BC
+#define OAX4000_CMD_STATUS_REG  0x3C06
+#define OAX4000_CMD_SUCCESS     0x00
+#define OAX4000_CMD_TIMEOUT_MS  100
+#define OAX4000_FW_VERSION_PAGE (0x1FF000/0x100)
+#define OAX4000_FW_VERSION_LEN  10
+
+#define OAX4000_STATUS_FINISH		0x99
+#define OAX4000_STATUS_ONGOINF		0x88
+#define OAX4000_STATUS_ERR		0x55
+#define OAX4000_STATUS_HW_CRC_ERR	0x44
+#define OAX4000_STATUS_SEQ_ERR		0x22
+#define OAX4000_STATUS_TIMEOUT_ERR	0x11
+#define OAX4000_STATUS_RESET		0x00
+
+static int oax4000_check_cmd_status(struct cam57_dev *sensor)
+{
+	unsigned int val;
+	int ret;
+	unsigned long timeout = jiffies + msecs_to_jiffies(OAX4000_CMD_TIMEOUT_MS);
+
+	do {
+		ret = regmap_read(sensor->regmap, OAX4000_CMD_STATUS_REG, &val);
+		if (ret)
+			return ret;
+
+		if (val == OAX4000_STATUS_FINISH)
+			return 0;
+
+		usleep_range(500, 1000);
+	} while (time_before(jiffies, timeout));
+
+	dev_err(&sensor->client->dev, "OAX4000 status check timeout (0x%02x)\n", val);
+	return -ETIMEDOUT;
+}
+
+/**
+ * oax4000_send_mailbox_cmd() - Send dynamic-length payload to OAX4000 mailbox
+ * @sensor: Pointer to driver device instance
+ * @msg_data: Map of byte offsets to values (starting at offset 0x3000)
+ * @total_len: Total bytes to write to the mailbox array
+ */
+static int oax4000_send_mailbox_cmd(struct cam57_dev *sensor, const u8 *msg_data, size_t total_len)
+{
+	int ret, i;
+
+	if (!msg_data || total_len == 0)
+		return -EINVAL;
+
+	/* Write payload bytes sequentially starting at Mailbox 0x3000 */
+	for (i = 0; i < total_len; i++) {
+		ret = regmap_write(sensor->regmap, OAX4000_MAILBOX_BASE + i, msg_data[i]);
+		if (ret) {
+			dev_err(&sensor->client->dev, "Mailbox write failed at offset 0x%04x: %d\n",
+				OAX4000_MAILBOX_BASE + i, ret);
+			return ret;
+		}
+	}
+
+	ret = regmap_write(sensor->regmap, OAX4000_CMD_TRIGGER_REG, 0x01);
+	if (ret)
+		return ret;
+
+	return oax4000_check_cmd_status(sensor);
+}
+
+static int cam57_sensor_rw(struct cam57_dev *sensor, u16 reg, u8 *idata, u16 count, bool is_write)
+{
+	u8 buf[12] = {0};
+	int ret, i;
+
+	buf[5]  = 0x05;                        /* Group ID */
+	buf[6]  = is_write ? 0x00 : 0x01;      /* 0 = Write, 1 = Read */
+	buf[8]  = (reg >> 8) & 0xFF;
+	buf[9]  = reg & 0xFF;
+	buf[10] = count & 0xFF;
+	if (is_write && idata)
+		buf[11] = idata[0];
+
+	ret = oax4000_send_mailbox_cmd(sensor, buf, 12);
+	if (ret)
+		return ret;
+
+	/* Read back data payload from 0x3C07 on read commands */
+	if (!is_write && idata) {
+		for (i = 0; i < count; i++) {
+			u32 val;
+			ret = regmap_read(sensor->regmap, 0x3C07 + i, &val);
+			if (ret)
+				return ret;
+			idata[i] = val & 0xFF;
+		}
+	}
+
+	return 0;
+}
+
+/* Helper to write to sensor registers (like 0x0100) via OAX4000 Mailbox */
+static int cam57_sensor_write_reg(struct cam57_dev *sensor, u16 reg, u8 val)
+{
+	dev_info(&sensor->client->dev, "write_reg %04x=%02x\n", reg, val);
+	return cam57_sensor_rw(sensor, reg, &val, 1, true);
+}
+
+struct saturation_entry {
+	u8 reg_0cf4[4];
+	u8 reg_0d0e[4];
+};
+
+/* Lookup table for saturation levels 0 through 10 */
+static const struct saturation_entry saturation_lut[11] = {
+	[0]  = { {0x28, 0x28, 0x28, 0x20}, {0x20, 0x20, 0x20, 0x10} },
+	[1]  = { {0x30, 0x30, 0x28, 0x20}, {0x20, 0x20, 0x20, 0x10} },
+	[2]  = { {0x31, 0x31, 0x38, 0x28}, {0x30, 0x30, 0x40, 0x10} },
+	[3]  = { {0x33, 0x33, 0x38, 0x28}, {0x40, 0x38, 0x40, 0x10} },
+	[4]  = { {0x37, 0x37, 0x38, 0x28}, {0x60, 0x50, 0x40, 0x10} },
+	[5]  = { {0x40, 0x40, 0x38, 0x28}, {0x66, 0x58, 0x50, 0x10} },
+	[6]  = { {0x43, 0x43, 0x38, 0x28}, {0x72, 0x66, 0x60, 0x10} },
+	[7]  = { {0x48, 0x38, 0x30, 0x28}, {0x80, 0x80, 0x50, 0x10} },
+	[8]  = { {0x56, 0x56, 0x38, 0x28}, {0xA2, 0x86, 0x60, 0x10} },
+	[9]  = { {0x66, 0x66, 0x48, 0x38}, {0xB2, 0x96, 0x60, 0x10} },
+	[10] = { {0x74, 0x74, 0x48, 0x38}, {0xB2, 0x96, 0x60, 0x10} },
+};
+
+static int cam57_set_saturation(struct cam57_dev *sensor, s32 val)
+{
+	static const u8 init_9644[4] = { 0x00, 0x90, 0x1C, 0x80 };
+	const struct saturation_entry *entry;
+	int ret, i;
+
+	if (val < 0 || val > 10)
+		return -EINVAL;
+
+	for (i = 0; i < 4; i++) {
+		ret = regmap_write(sensor->regmap, 0x9644 + i, init_9644[i]);
+		if (ret)
+			return ret;
+	}
+
+	entry = &saturation_lut[val];
+
+	for (i = 0; i < 4; i++) {
+		ret = regmap_write(sensor->regmap, 0x0CF4 + (i * 2), entry->reg_0cf4[i]);
+		if (ret)
+			return ret;
+	}
+
+	for (i = 0; i < 4; i++) {
+		ret = regmap_write(sensor->regmap, 0x0D0E + i, entry->reg_0d0e[i]);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int cam57_set_sharpness(struct cam57_dev *sensor, s32 val)
+{
+	u8 buf[8] = {0};
+
+	if (val < 0 || val > 255)
+		return -EINVAL;
+
+	buf[3] = 0x43;
+	buf[5] = 0x05;
+	buf[6] = 0x10;
+	buf[7] = val & 0xFF;
+
+	return oax4000_send_mailbox_cmd(sensor, buf, sizeof(buf));
+}
+
+static int cam57_set_contrast(struct cam57_dev *sensor, s32 val)
+{
+	u8 buf[9] = {0};
+
+	if (val < 0 || val > 255)
+		return -EINVAL;
+
+	buf[3] = 0x4D;
+	buf[5] = 0x09;
+	buf[6] = 0x10;
+	buf[7] = 0x0A;
+	buf[8] = 0x00;
+
+	return oax4000_send_mailbox_cmd(sensor, buf, sizeof(buf));
+}
+
+static int cam57_set_brightness(struct cam57_dev *sensor, u8 brightness)
+{
+	u8 buf[9] = {0};
+
+	buf[3] = 0x40;
+	buf[5] = 0x06;
+	buf[6] = 0x10;
+	buf[8] = brightness;
+
+	return oax4000_send_mailbox_cmd(sensor, buf, sizeof(buf));
+}
+
+static int cam57_set_exposure_rgb(struct cam57_dev *sensor, bool auto_exp, u16 exp_val, u16 gain_val)
+{
+	u8 buf[24] = {0};
+
+	buf[3] = 0x44;
+	buf[5] = 0x45;
+	buf[6] = 0x10;
+	buf[7] = auto_exp ? 0x00 : 0x01;
+
+	if (!auto_exp) {
+		buf[8]  = buf[10] = buf[12] = buf[14] = (exp_val >> 8) & 0xFF;
+		buf[9]  = buf[11] = buf[13] = buf[15] = exp_val & 0xFF;
+		buf[16] = buf[18] = buf[20] = buf[22] = (gain_val >> 8) & 0xFF;
+		buf[17] = buf[19] = buf[21] = buf[23] = gain_val & 0xFF;
+	}
+
+	return oax4000_send_mailbox_cmd(sensor, buf, auto_exp ? 8 : sizeof(buf));
+}
+
+static int cam57_set_exposure_ir(struct cam57_dev *sensor, bool auto_exp, u16 exp_val, u16 gain_val)
+{
+	u8 buf[75] = {0};
+
+	buf[3] = 0x44;
+	buf[5] = 0x45;
+	buf[6] = 0x80;
+	buf[7] = 0x00;
+
+	if (!auto_exp) {
+		buf[58] = 0x01;
+		buf[59] = buf[61] = buf[63] = buf[65] = (exp_val >> 8) & 0xFF;
+		buf[60] = buf[62] = buf[64] = buf[66] = exp_val & 0xFF;
+		buf[67] = buf[69] = buf[71] = buf[73] = (gain_val >> 8) & 0xFF;
+		buf[68] = buf[70] = buf[72] = buf[74] = gain_val & 0xFF;
+	}
+
+	return oax4000_send_mailbox_cmd(sensor, buf, auto_exp ? 8 : sizeof(buf));
+}
+
+static int cam57_set_power_line_freq(struct cam57_dev *sensor, u8 freq_mode)
+{
+	u8 buf[7] = {0};
+
+	buf[3] = 0x54;
+	buf[5] = 0x01;
+	buf[6] = (freq_mode == 2) ? 0x33 : 0x30;
+
+	return oax4000_send_mailbox_cmd(sensor, buf, sizeof(buf));
+}
+
+static int cam57_set_hflip(struct cam57_dev *sensor, s32 val)
+{
+	u8 reg_val = 0;
+	int ret;
+
+	ret = cam57_sensor_rw(sensor, 0x3013, &reg_val, 1, false);
+	if (ret)
+		return ret;
+
+	if (val)
+		reg_val |= BIT(0);
+	else
+		reg_val &= ~BIT(0);
+
+	return cam57_sensor_rw(sensor, 0x3013, &reg_val, 1, true);
+}
+
+static int cam57_set_vflip(struct cam57_dev *sensor, s32 val)
+{
+	u8 reg_val = 0;
+	int ret;
+
+	ret = cam57_sensor_rw(sensor, 0x3012, &reg_val, 1, false);
+	if (ret)
+		return ret;
+
+	if (val)
+		reg_val |= BIT(0);
+	else
+		reg_val &= ~BIT(0);
+
+	return cam57_sensor_rw(sensor, 0x3012, &reg_val, 1, true);
+}
+
+/* -----------------------------------------------------------------------------
+ * Hardware Initialization Sequence
+ * -----------------------------------------------------------------------------
+ */
+#define MODULE_I2C_SWITCH_ADDR  0x70
+#define TWO_CHANNELS            0x03
+
+static int cam57_enable_i2c_switch(struct i2c_client *client)
+{
+	struct i2c_adapter *adap = client->adapter;
+	u8 both = TWO_CHANNELS;
+	struct i2c_msg msg = {
+		.addr = MODULE_I2C_SWITCH_ADDR,
+		.flags = 0,
+		.len = 1,
+		.buf = &both,
+	};
+	int ret = 0, retry;
+
+	for (retry = 0; retry < 10; retry++) {
+		ret = i2c_transfer(adap, &msg, 1);
+		if (ret >= 0)
+			return 0;
+		usleep_range(2000, 3000);
+	}
+	dev_err(&client->dev, "Failed to enable I2C switch @ 0x%02x: %d\n",
+		MODULE_I2C_SWITCH_ADDR, ret);
+	return ret;
+}
+
+static int oax4000_power_on(struct cam57_dev *sensor)
+{
+	struct device *dev = &sensor->client->dev;
+
+	if (sensor->reset_gpio) {
+		dev_info(dev, "Pulsing MFP4 reset line for OAX4000 ISP...\n");
+		
+		gpiod_set_value_cansleep(sensor->reset_gpio, 1);
+		msleep(50);
+
+		gpiod_set_value_cansleep(sensor->reset_gpio, 0);
+		msleep(200);
+	}
+
+	return 0;
+}
+
+static int oax4000_power_off(struct cam57_dev *sensor)
+{
+	if (sensor->reset_gpio)
+		gpiod_set_value_cansleep(sensor->reset_gpio, 1);
+
+	return 0;
+}
+
+static int oax4000_send_isp_cmd(struct cam57_dev *sensor, const u8 *payload, u16 len)
+{
+	int ret, i;
+
+	for (i = 0; i < (12 + len); i++) {
+		ret = regmap_write(sensor->regmap, 0x3000 + i, payload[i]);
+		if (ret)
+			return ret;
+	}
+
+	ret = regmap_write(sensor->regmap, OAX4000_CMD_TRIGGER_REG, 0x01);
+	if (ret)
+		return ret;
+
+	return oax4000_check_cmd_status(sensor);
+}
+
+static int oax4000_read_page(struct cam57_dev *sensor,
+                             u8 *buf, size_t size, u32 flash_page)
+{
+	u8 payload[8] = {0};
+	unsigned int val;
+	int ret, i;
+
+	if (size > 256)
+		return -EINVAL;
+
+	payload[0] = 0x00;
+	payload[1] = 0x00;
+	payload[3] = CMD_SERIAL_FLASH_READ;
+	payload[4] = 0x00;
+	payload[5] = 0x02;
+	payload[6] = (flash_page >> 8) & 0xff;
+	payload[7] = flash_page & 0xff;
+
+	ret = oax4000_send_isp_cmd(sensor, payload, sizeof(payload));
+	if (ret)
+		return ret;
+
+	for (i = 0; i < size; i++) {
+		ret = regmap_read(sensor->regmap, 0x3007 + i, &val);
+		if (ret)
+			return ret;
+		buf[i] = val & 0xFF;
+	}
+	return 0;
+}
+
+static int oax4000_write_page(struct cam57_dev *sensor,
+                              const u8 *data, size_t size, u32 flash_page)
+{
+	u8 payload[10 + 256];
+	int ret;
+
+	if (size > 256)
+		return -EINVAL;
+
+	if (flash_page % 16 == 0) {
+		payload[0] = 0x00;
+		payload[1] = 0x00;
+		payload[2] = 0x00;
+		payload[3] = CMD_SERIAL_FLASH_ERASE;
+		payload[4] = 0x00;
+		payload[5] = 0x03;
+		payload[6] = 0x01;
+		payload[7] = (flash_page >> 8) & 0xff;
+		payload[8] = flash_page & 0xff;
+		ret = oax4000_send_isp_cmd(sensor, payload, 9);
+		if (ret)
+			return ret;
+	}
+	payload[0] = 0x03; // Why is reg 0x3000 written at location zero here? 
+	payload[1] = 0x00; // Seems silly, but that's what the vendor driver does.
+	payload[2] = 0x00;
+	payload[3] = 0x00;
+	payload[4] = 0x00;
+	payload[5] = CMD_SERIAL_FLASH_PAGE_PROGRAM;
+	payload[6] = 0x01;
+	payload[7] = 0x02;
+	payload[8] = (flash_page >> 8) & 0xff;
+	payload[9] = flash_page & 0xff;
+	memcpy(&payload[10], data, size);
+
+	return oax4000_send_isp_cmd(sensor, payload, sizeof(payload));
+}
+
+static int oax4000_firmware_ok(struct cam57_dev *sensor, const struct firmware *fw)
+{
+	struct device *dev = &sensor->client->dev;
+	u8 version_size = fw->data[0];
+	u8 version[OAX4000_FW_VERSION_LEN];
+	int ret;
+
+	if (version_size != OAX4000_FW_VERSION_LEN) {
+		dev_err(dev, "invalid cam57 version size: %d\n", version_size);
+		return -EINVAL;
+	}
+
+	ret = oax4000_read_page(sensor, version, sizeof(version), OAX4000_FW_VERSION_PAGE);
+	if (ret) {
+		dev_err(dev, "cannot read firmware version\n");
+		return ret;
+	}
+	dev_info(dev, "cam57 version %*ph\n", (int)sizeof(version), version);
+	return memcmp(version, &fw->data[1], version_size) == 0;
+}
+
+static int oax4000_load_firmware(struct cam57_dev *sensor)
+{
+	struct device *dev = &sensor->client->dev;
+	const struct firmware *fw;
+	size_t offset = 0;
+	int ret;
+
+	return 0;
+	ret = request_firmware(&fw, CAM57_FIRMWARE_NAME, dev);
+	if (ret) {
+		dev_err(dev, "Failed to load firmware file %s: %d\n",
+			CAM57_FIRMWARE_NAME, ret);
+		return ret;
+	}
+
+	if (oax4000_firmware_ok(sensor, fw) > 0) {
+		release_firmware(fw);
+		return 0;
+	}
+	dev_info(dev, "reprogramming CAM57 with %ld bytes\n", fw->size);
+
+	while (offset < fw->size) {
+		size_t page_size = min_t(size_t, 256, fw->size - offset);
+
+		ret = oax4000_write_page(sensor, fw->data + offset, page_size, offset / 0x100);
+		if (ret) {
+			dev_err(dev, "page write failed at %lx\n", offset);
+			goto out_release_fw;
+		}
+		offset += page_size;
+	}
+
+	/* Write CAM57 firmware ID at end of flash */
+	
+	ret = oax4000_write_page(sensor, &fw->data[1], OAX4000_FW_VERSION_LEN, OAX4000_FW_VERSION_PAGE);
+	if (ret) {
+		dev_err(dev, "writing firmware version failed");
+		goto out_release_fw;
+	}
+
+	dev_info(dev, "CAM57 firmware programming complete\n");
+
+	oax4000_power_on(sensor);
+out_release_fw:
+	release_firmware(fw);
+	return ret;
+}
+
+/* -----------------------------------------------------------------------------
+ * V4L2 Subdev Operations
+ * -----------------------------------------------------------------------------
+ */
+
+static int cam57_s_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct cam57_dev *sensor = to_cam57(sd);
+	int ret = 0;
+
+	if (!sensor->initialized)
+		return -EAGAIN;
+
+	if (sensor->streaming == enable)
+		return 0;
+
+	if (enable) {
+		ret = regmap_write(sensor->regmap, 0x0100, 0x01);
+		if (ret)
+			return ret;
+		sensor->streaming = true;
+	} else {
+		regmap_write(sensor->regmap, 0x0100, 0x00);
+		sensor->streaming = false;
+	}
+
+	return 0;
+}
+
+static int cam57_enum_frame_size(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *sd_state,
+				   struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index > 0)
+		return -EINVAL;
+
+	if (fse->code != MEDIA_BUS_FMT_UYVY8_1X16)
+		return -EINVAL;
+
+	fse->min_width = 2592;
+	fse->max_width = 2592;
+	fse->min_height = 1946;
+	fse->max_height = 1946;
+
+	return 0;
+}
+
+static int cam57_get_fmt(struct v4l2_subdev *sd,
+			 struct v4l2_subdev_state *sd_state,
+			 struct v4l2_subdev_format *fmt)
+{
+	struct v4l2_mbus_framefmt *mbus_fmt;
+
+	mbus_fmt = v4l2_subdev_state_get_format(sd_state, fmt->pad, fmt->stream);
+	if (!mbus_fmt)
+		mbus_fmt = v4l2_subdev_state_get_format(sd_state, fmt->pad, 0);
+	if (!mbus_fmt) {
+		fmt->format.code = MEDIA_BUS_FMT_UYVY8_1X16;
+		fmt->format.width = 2592;
+		fmt->format.height = 1946;
+		fmt->format.field = V4L2_FIELD_NONE;
+		fmt->format.colorspace = V4L2_COLORSPACE_SRGB;
+		return 0;
+	}
+	mbus_fmt->code = MEDIA_BUS_FMT_UYVY8_1X16;
+	mbus_fmt->width = 2592;
+	mbus_fmt->height = 1946;
+	mbus_fmt->field = V4L2_FIELD_NONE;
+	mbus_fmt->colorspace = V4L2_COLORSPACE_SRGB;
+	fmt->format = *mbus_fmt;
+	return 0;
+}
+
+static const u32 cam57_mbus_codes[] = {
+	MEDIA_BUS_FMT_UYVY8_1X16,
+};
+
+static int cam57_enum_mbus_code(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index >= ARRAY_SIZE(cam57_mbus_codes))
+		return -EINVAL;
+
+	code->code = cam57_mbus_codes[code->index];
+	return 0;
+}
+
+static int cam57_get_frame_desc(struct v4l2_subdev *sd, unsigned int pad,
+				struct v4l2_mbus_frame_desc *fd)
+{
+	struct v4l2_subdev_state *state;
+	struct v4l2_subdev_route *route;
+	struct v4l2_mbus_framefmt *fmt;
+
+	if (pad != 0)
+		return -EINVAL;
+
+	memset(fd, 0, sizeof(*fd));
+	fd->type = V4L2_MBUS_FRAME_DESC_TYPE_CSI2;
+
+	state = v4l2_subdev_lock_and_get_active_state(sd);
+
+	for_each_active_route(&state->routing, route) {
+		if (route->source_pad != pad)
+			continue;
+
+		if (fd->num_entries >= V4L2_FRAME_DESC_ENTRY_MAX)
+			break;
+
+		fmt = v4l2_subdev_state_get_format(state, pad, route->source_stream);
+
+		fd->entry[fd->num_entries] = (struct v4l2_mbus_frame_desc_entry){
+			.stream = route->source_stream,
+			.flags = V4L2_MBUS_FRAME_DESC_FL_LEN_MAX,
+			.pixelcode = fmt ? fmt->code : MEDIA_BUS_FMT_UYVY8_1X16,
+			.bus.csi2 = {
+				.vc = route->source_stream,
+				.dt = MIPI_CSI2_DT_YUV422_8B,
+			},
+		};
+		fd->num_entries++;
+	}
+
+	v4l2_subdev_unlock_state(state);
+
+	if (fd->num_entries == 0) {
+		fd->num_entries = 1;
+		fd->entry[0].stream = 0;
+		fd->entry[0].pixelcode = MEDIA_BUS_FMT_UYVY8_1X16;
+		fd->entry[0].bus.csi2.vc = 0;
+		fd->entry[0].bus.csi2.dt = MIPI_CSI2_DT_YUV422_8B;
+	}
+
+	return 0;
+}
+
+static int cam57_set_fmt(struct v4l2_subdev *sd,
+			   struct v4l2_subdev_state *sd_state,
+			   struct v4l2_subdev_format *fmt)
+{
+	struct v4l2_mbus_framefmt *mbus_fmt;
+
+	mbus_fmt = v4l2_subdev_state_get_format(sd_state, fmt->pad);
+	if (!mbus_fmt)
+		return -EINVAL;
+
+	mbus_fmt->code = MEDIA_BUS_FMT_UYVY8_1X16;
+	mbus_fmt->width = 2592;
+	mbus_fmt->height = 1946;
+	mbus_fmt->field = V4L2_FIELD_NONE;
+	mbus_fmt->colorspace = V4L2_COLORSPACE_SRGB;
+
+	fmt->format = *mbus_fmt;
+	return 0;
+}
+
+static int cam57_enable_streams(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				u32 pad, u64 streams_mask)
+{
+	struct cam57_dev *sensor = to_cam57(sd);
+	int ret = 0;
+
+	if (!sensor->initialized)
+		return -EAGAIN;
+
+	if (!sensor->streaming) {
+		ret = cam57_sensor_write_reg(sensor, 0x0100, 0x01);
+		if (ret) {
+			dev_err(sd->dev, "Failed to start stream on 0x0100: %d\n", ret);
+			return ret;
+		}
+		sensor->streaming = true;
+	}
+
+	return 0;
+}
+
+static int cam57_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  u32 pad, u64 streams_mask)
+{
+	struct cam57_dev *sensor = to_cam57(sd);
+
+	if (sensor->streaming) {
+		cam57_sensor_write_reg(sensor, 0x0100, 0x00);
+		sensor->streaming = false;
+	}
+
+	return 0;
+}
+
+static const struct v4l2_mbus_framefmt cam57_def_fmt = {
+	.width = 2592,
+	.height = 1946,
+	.code = MEDIA_BUS_FMT_UYVY8_1X16,
+	.field = V4L2_FIELD_NONE,
+	.colorspace = V4L2_COLORSPACE_SRGB,
+	.ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT,
+	.quantization = V4L2_QUANTIZATION_DEFAULT,
+	.xfer_func = V4L2_XFER_FUNC_DEFAULT,
+};
+
+static int cam57_init_state(struct v4l2_subdev *sd,
+			      struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_route routes[] = {
+		{
+			.sink_pad = 0,
+			.sink_stream = 0,
+			.source_pad = 0,
+			.source_stream = 0,
+			.flags = V4L2_SUBDEV_ROUTE_FL_ACTIVE,
+		},
+		{
+			.sink_pad = 0,
+			.sink_stream = 1,
+			.source_pad = 0,
+			.source_stream = 1,
+			.flags = V4L2_SUBDEV_ROUTE_FL_ACTIVE,
+		},
+	};
+	struct v4l2_subdev_krouting routing = {
+		.num_routes = ARRAY_SIZE(routes),
+		.routes = routes,
+	};
+
+	return v4l2_subdev_set_routing_with_fmt(sd, state, &routing,
+						&cam57_def_fmt);
+}
+
+static int cam57_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct cam57_dev *sensor =
+		container_of(ctrl->handler, struct cam57_dev, ctrls);
+	int ret = 0;
+
+	if (!sensor->initialized)
+		return -EAGAIN;
+
+	switch (ctrl->id) {
+	case V4L2_CID_SATURATION:
+		ret = cam57_set_saturation(sensor, ctrl->val);
+		break;
+	case V4L2_CID_SHARPNESS:
+		ret = cam57_set_sharpness(sensor, ctrl->val);
+		break;
+	case V4L2_CID_CONTRAST:
+		ret = cam57_set_contrast(sensor, ctrl->val);
+		break;
+	case V4L2_CID_BRIGHTNESS:
+		ret = cam57_set_brightness(sensor, ctrl->val);
+		break;
+	case V4L2_CID_EXPOSURE_AUTO:
+		ret = cam57_set_exposure_rgb(sensor, true, 0, 0);
+		break;
+	case V4L2_CID_EXPOSURE_ABSOLUTE:
+		ret = cam57_set_exposure_rgb(sensor, false, ctrl->val, sensor->gain);
+		break;
+	case V4L2_CID_CUSTOM_EXPOSURE_AUTO_IR:
+		ret = cam57_set_exposure_ir(sensor, true, 0, 0);
+		break;
+	case V4L2_CID_CUSTOM_EXPOSURE_ABSOLUTE_IR:
+		ret = cam57_set_exposure_ir(sensor, false, ctrl->val, sensor->gain_ir);
+		break;
+	case V4L2_CID_GAIN:
+		sensor->gain = ctrl->val;
+		break;
+	case V4L2_CID_CUSTOM_GAIN_IR:
+		sensor->gain_ir = ctrl->val;
+		break;
+	case V4L2_CID_POWER_LINE_FREQUENCY:
+		ret = cam57_set_power_line_freq(sensor, ctrl->val);
+		break;
+	case V4L2_CID_HFLIP:
+		ret = cam57_set_hflip(sensor, ctrl->val);
+		break;
+	case V4L2_CID_VFLIP:
+		ret = cam57_set_vflip(sensor, ctrl->val);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops cam57_ctrl_ops = {
+	.s_ctrl = cam57_s_ctrl,
+};
+
+static const struct v4l2_ctrl_config custom_ctrls[] = {
+	{
+		.ops = &cam57_ctrl_ops,
+		.id = V4L2_CID_CUSTOM_EXPOSURE_AUTO_IR,
+		.name = "IR Auto Exposure",
+		.type = V4L2_CTRL_TYPE_BOOLEAN,
+		.min = 0,
+		.max = 1,
+		.step = 1,
+		.def = 1,
+	},
+	{
+		.ops = &cam57_ctrl_ops,
+		.id = V4L2_CID_CUSTOM_EXPOSURE_ABSOLUTE_IR,
+		.name = "IR Exposure Absolute",
+		.type = V4L2_CTRL_TYPE_INTEGER,
+		.min = 1,
+		.max = 0xFFFF,
+		.step = 1,
+		.def = 100,
+	},
+	{
+		.ops = &cam57_ctrl_ops,
+		.id = V4L2_CID_CUSTOM_GAIN_IR,
