+#define OAX4000_MAILBOX_BASE    0x3000
+#define OAX4000_CMD_TRIGGER_REG 0x80BC
+#define OAX4000_CMD_STATUS_REG  0x3C06
+#define OAX4000_ISP_STATUS_REG  0x80DB
+#define OAX4000_CMD_SUCCESS     0x00
+#define OAX4000_CMD_TIMEOUT_MS  1000
+#define OAX4000_FW_VERSION_PAGE (0x1FF000/0x100)
+#define OAX4000_FW_VERSION_LEN  10
+
+#define OAX4000_STATUS_FINISH		0x99
+#define OAX4000_STATUS_ONGOING		0x88
+#define OAX4000_STATUS_ERR		0x55
+#define OAX4000_STATUS_HW_CRC_ERR	0x44
+#define OAX4000_STATUS_SEQ_ERR		0x22
+#define OAX4000_STATUS_TIMEOUT_ERR	0x11
+#define OAX4000_STATUS_RESET		0x00
+
+static int oax4000_check_cmd_status(struct cam57_dev *cam)
+{
+	unsigned int val;
+	unsigned long timeout = jiffies + msecs_to_jiffies(OAX4000_CMD_TIMEOUT_MS);
+	int ret;
+
+	do {
+		ret = regmap_read(cam->regmap, OAX4000_CMD_STATUS_REG, &val);
+		if (ret)
+			return ret;
+		if (val == OAX4000_STATUS_FINISH)
+			return 0;
+		if (val != OAX4000_STATUS_ONGOING)
+			return val;
+		usleep_range(1000, 2000);
+	} while (time_before(jiffies, timeout));
+	return -ETIMEDOUT;
+}
