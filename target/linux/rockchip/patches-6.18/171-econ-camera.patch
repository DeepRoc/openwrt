+static int oax4000_write_bytes(struct i2c_client *client, u16 reg, const u8 *bytes, int len)
+{
+	int ret = 0;
+
+	for (int i = 0; i < len; i++) {
+		for (int retry = MAX_RETRY_CNT; --retry >= 0; ) {
+			u8 buf[3] = { (reg >> 8) & 255, reg & 0xff, bytes[i] };
+			ret = i2c_master_send(client, buf, sizeof(buf));
+			if (ret > 0)
+				break;
+			usleep_range(500, 1000);
+		}
+		if (ret < 0)
+			break;
+		reg++;
+	}
+	if (ret < 0)
+		return ret;
+	return 0;
+}
+
+/**
+ * oax4000_set_ram_window() - Re-map the OAX4000 I2C write window to a 32-bit RAM address
+ * @client: Pointer to I2C client device
+ * @base_addr: Target 32-bit physical address in OAX4000 SRAM
+ */
+static int oax4000_set_ram_window(struct i2c_client *client, u32 base_addr)
+{
+	u8 window_cmd[6];
+
+	/* Byte 0..3: 32-bit physical memory base address (little-endian) */
+	window_cmd[0] = (base_addr >> 0)  & 0xFF;
+	window_cmd[1] = (base_addr >> 8)  & 0xFF;
+	window_cmd[2] = (base_addr >> 16) & 0xFF;
+	window_cmd[3] = (base_addr >> 24) & 0xFF;
+	/* Byte 4..5: Fixed OAX4000 window control magic bytes */
+	window_cmd[4] = 0xFF;
+	window_cmd[5] = 0x7F;
+
+	return oax4000_write_bytes(client, 0x9644, window_cmd, sizeof(window_cmd));
+}
+
+static int oax4000_write_8b_reg(struct i2c_client *client, u16 reg, u8 val)
+{
+	u8 buf[3] = { (reg >> 8) & 0xff, reg & 0xff, val };
+	int ret = i2c_master_send(client, buf, sizeof(buf));
+
+	if (ret < 0)
+		return ret;
+	return 0;
+}
+
+static int oax4000_read_8b_reg(struct i2c_client *client, u16 reg, u8 *val)
+{
+	u8 buf[2] = { (reg >> 8) & 0xff, reg & 0xff };
+	int ret = i2c_master_send(client, buf, sizeof(buf));
+
+	if (ret < 0)
+		return ret;
+	ret = i2c_master_recv(client, val, 1);
+	if (ret < 0)
+		return ret;
+	return 0;
+}
+
+/**
+ * oax4000_update_bootloader() - Upload RAM bootloader binary blob and execute MCU
+ * @client: Pointer to I2C client device
+ * @buf: Bootloader binary array payload (e.g. BOOT_FW)
+ * @size: Size of bootloader binary payload in bytes
+ */
+static int oax4000_update_bootloader(struct i2c_client *client, const u8 *buf, u32 size)
+{
+	const u32 RAM_BASE_ADDR = 0x80180000;
+	const u32 CHUNK_SIZE    = 0x4000; /* Max transfer window size before re-windowing */
+	u32 bytes_remaining     = size;
+	u32 curr_ram_addr       = RAM_BASE_ADDR;
+	size_t buf_offset       = 0;
+	u8 status               = 0;
+	int retry, ret;
+
+	if (!buf || size == 0)
+		return -EINVAL;
+
+	/* 1. Put OAX4000 MCU into SW Reset and switch clock source to PADCLK */
+	oax4000_write_8b_reg(client, 0x8050, 0x01); /* CPU SW Reset */
+	oax4000_write_8b_reg(client, 0x8061, 0x00);
+	oax4000_write_8b_reg(client, 0x8061, 0x80); /* Switch to PADCLK */
+	oax4000_write_8b_reg(client, 0x8061, 0x00);
+
+	/* 2. Upload bootloader binary chunks into internal RAM */
+	while (bytes_remaining > 0) {
+		u32 block_len = min(CHUNK_SIZE, bytes_remaining);
+
+		/* Re-map OAX4000 I2C window to target SRAM offset */
+		ret = oax4000_set_ram_window(client, curr_ram_addr);
+		if (ret) {
+			dev_err(&client->dev, "Failed to set RAM window at 0x%08x: %d\n", curr_ram_addr, ret);
+			return ret;
+		}
+
+		/* Write payload chunk to base offset 0x0000 */
+		ret = oax4000_write_bytes(client, 0x0000, buf + buf_offset, block_len);
+		if (ret) {
+			dev_err(&client->dev, "RAM write failed at offset 0x%zx: %d\n", buf_offset, ret);
+			return ret;
+		}
+
+		curr_ram_addr   += block_len;
+		buf_offset      += block_len;
+		bytes_remaining -= block_len;
+		msleep(100);
+	}
+
+	/* 3. Release MCU reset and boot from uploaded RAM binary */
+	oax4000_write_8b_reg(client, 0x8001, 0x09);
+	oax4000_write_8b_reg(client, 0x8005, 0x06); /* RAM boot mode */
+	oax4000_write_8b_reg(client, 0x8050, 0x00); /* Release CPU Reset */
+	msleep(10);
+
+	/* 4. Poll OAX4000 status register until bootloader reports execution readiness (0x5A) */
+	for (retry = 0; retry < MAX_RETRY_CNT; retry++) {
+		ret = oax4000_read_8b_reg(client, OAX4000_ISP_STATUS_REG, &status);
+		if (!ret && status == 0x5a)
+			return 0;
+		msleep(10);
+	}
+
+	dev_err(&client->dev, "OAX4000 Bootloader failed to boot (status: 0x%02x)\n", status);
+	return -EIO;
+}
+
+static int oax4000_send_mailbox_cmd(struct cam57_dev *cam, const u8 *msg_data, size_t total_len)
+{
+	int ret;
+
+	if (!msg_data || total_len == 0)
+		return -EINVAL;
+
+	/* Write payload bytes sequentially starting at Mailbox 0x3000 */
+	for (int i = 0; i < total_len; i++) {
+		ret = regmap_write(cam->regmap, OAX4000_MAILBOX_BASE + i, msg_data[i]);
+		if (ret) {
+			dev_err(&cam->client->dev, "Mailbox write failed at offset 0x%04x: %d\n",
+				OAX4000_MAILBOX_BASE + i, ret);
+			return ret;
+		}
+	}
+
+	ret = regmap_write(cam->regmap, OAX4000_CMD_TRIGGER_REG, 0x01);
+	if (ret)
+		return ret;
+
+	// dev_info(&cam->client->dev, "cmd %*ph\n", (int)total_len, msg_data);
+	if (msg_data[3] == OAX4000_SET_RESOLUTION) {
+		msleep(100);
+		return 0;
+	}
+	return oax4000_check_cmd_status(cam);
+}
+
+static int cam57_sensor_rw(struct cam57_dev *cam, u16 reg, u8 *idata, u16 count, bool is_write)
+{
+	u8 buf[12] = {0};
+	int ret, i;
+
+	buf[5]  = 0x05;                        /* Group ID */
+	buf[6]  = is_write ? 0x00 : 0x01;      /* 0 = Write, 1 = Read */
+	buf[8]  = (reg >> 8) & 0xFF;
+	buf[9]  = reg & 0xFF;
+	buf[10] = count & 0xFF;
+	if (is_write && idata)
+		buf[11] = idata[0];
+
+	ret = oax4000_send_mailbox_cmd(cam, buf, 12);
+	if (ret)
+		return ret;
+
+	/* Read back data payload from 0x3C07 on read commands */
+	if (!is_write && idata) {
+		for (i = 0; i < count; i++) {
+			u32 val;
+			ret = regmap_read(cam->regmap, 0x3C07 + i, &val);
+			if (ret)
+				return ret;
+			idata[i] = val & 0xFF;
+		}
+	}
+
+	return 0;
+}
+
+/* Helper to write to sensor registers (like 0x0100) via OAX4000 Mailbox */
+static int cam57_sensor_write_reg(struct cam57_dev *cam, u16 reg, u8 val)
+{
+	return cam57_sensor_rw(cam, reg, &val, 1, true);
+}
+
+struct saturation_entry {
+	u8 reg_0cf4[4];
+	u8 reg_0d0e[4];
+};
+
+/* Lookup table for saturation levels 0 through 10 */
+static const struct saturation_entry saturation_lut[11] = {
+	[0]  = { {0x28, 0x28, 0x28, 0x20}, {0x20, 0x20, 0x20, 0x10} },
+	[1]  = { {0x30, 0x30, 0x28, 0x20}, {0x20, 0x20, 0x20, 0x10} },
+	[2]  = { {0x31, 0x31, 0x38, 0x28}, {0x30, 0x30, 0x40, 0x10} },
+	[3]  = { {0x33, 0x33, 0x38, 0x28}, {0x40, 0x38, 0x40, 0x10} },
+	[4]  = { {0x37, 0x37, 0x38, 0x28}, {0x60, 0x50, 0x40, 0x10} },
+	[5]  = { {0x40, 0x40, 0x38, 0x28}, {0x66, 0x58, 0x50, 0x10} },
+	[6]  = { {0x43, 0x43, 0x38, 0x28}, {0x72, 0x66, 0x60, 0x10} },
+	[7]  = { {0x48, 0x38, 0x30, 0x28}, {0x80, 0x80, 0x50, 0x10} },
+	[8]  = { {0x56, 0x56, 0x38, 0x28}, {0xA2, 0x86, 0x60, 0x10} },
+	[9]  = { {0x66, 0x66, 0x48, 0x38}, {0xB2, 0x96, 0x60, 0x10} },
+	[10] = { {0x74, 0x74, 0x48, 0x38}, {0xB2, 0x96, 0x60, 0x10} },
+};
