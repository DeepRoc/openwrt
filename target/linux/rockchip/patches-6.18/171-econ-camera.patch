+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Driver for eCon STURDeCAM31 containing Sony isx031 sensor.
+ */
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_graph.h>
+#include <linux/firmware.h>
+#include <linux/byteorder/generic.h>
+#include <linux/gpio/consumer.h>
+#include <linux/workqueue.h>
+
+#include <media/v4l2-async.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-event.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+#include <media/mipi-csi2.h>
+
+/* ST Bootloader Commands */
+#define BL_GET_VERSION                0x01
+#define BL_READ_MEM                   0x11
+#define BL_GO                         0x21
+#define BL_WRITE_MEM_NS               0x32
+#define BL_ERASE_MEM_NS               0x45
+#define RESP_ACK                      0x79
+#define RESP_BUSY                     0x76
+
+#define FLASH_START_ADDRESS           0x08000000
+#define CAM31_MCU_FLASH_SIZE           (192 * 1024)
+#define CAM31_ISP_FLASH_SIZE           (512 * 1024)
+#define ISX_BUFFER_SIZE               256
+
+/* Protocol Framing Constants */
+#define MCU_HEADER_SIZE			4
+#define MCU_MAX_PAYLOAD			256
+#define MCU_TIMEOUT_MS			1000
+#define MCU_CMD_SIGNATURE		0x43
+#define MCU_MAX_CONTROLS		32
+
+/*
+ * The max9296a driver doesn't implement a GPIO interface, so we must poke
+ * the GPIO registers directly via I2C.
+ */
+#define SER_ADDR          0x40
+#define SER_REG_RESET     0x2ca  /* Serializer pin connected to MCU NRST */
+#define SER_REG_BOOT      0x2be  /* Serializer pin connected to MCU BOOT0 */
+#define SER_REG_GPIO3     0x2c7
+#define SER_REG_GPIO5     0x2cd
+#define SER_REG_GPIO7     0x2d3
+#define SER_REG_GPIO8     0x2d6
+#define SER_GPIO_OUT_MASK 0x11   /* Bit#0 to disable output, Bit#4 select high/low */
+#define SER_GPIO_LOW      0x00
+#define SER_GPIO_HIGH     0x10
+#define SER_GPIO_CFG_MASK 0xe0   /* Bit#5,6,7 to enable push-pull and pullup resistor */
+#define SER_GPIO_PP       0xa0
+
+#define CAM31_INIT_GPIOS
+
+#define DEBUG
+
+/* e-Con Proprietary Host Command Set */
+enum cam31_mcu_cmd_id {
+	CMD_ID_VERSION			= 0x00,
+	CMD_ID_GET_SENSOR_ID		= 0x01,
+	CMD_ID_GET_STREAM_INFO		= 0x02,
+	CMD_ID_GET_CTRL_INFO		= 0x03,
+	CMD_ID_INIT_CAM			= 0x04,
+	CMD_ID_GET_STATUS		= 0x05,
+	CMD_ID_DE_INIT_CAM		= 0x06,
+	CMD_ID_STREAM_ON		= 0x07,
+	CMD_ID_STREAM_OFF		= 0x08,
+	CMD_ID_STREAM_CONFIG		= 0x09,
+	CMD_ID_GET_CTRL_UI_INFO		= 0x0A,
+
+	CMD_ID_GET_CTRL			= 0x10,
+	CMD_ID_SET_CTRL			= 0x11,
+	CMD_ID_ISP_READ			= 0x12,
+	CMD_ID_ISP_WRITE		= 0x13,
+
+	CMD_ID_FW_UPDT			= 0x14,
+	CMD_ID_ISP_PDOWN		= 0x15,
+	CMD_ID_ISP_PUP			= 0x16,
+
+	CMD_ID_LANE_CONFIG		= 0x17,
+	CMD_ID_MIPI_CLK_CONFIG		= 0x18,
+
+	CMD_ID_SENSOR_READ		= 0x19,
+	CMD_ID_SENSOR_WRITE		= 0x1A,
+
+	/* ISX031-Specific Extended Commands */
+	CMD_ID_INIT_CAM_ISP		= 0xA0,
+	CMD_ID_INIT_CAM_ISP_ERASE	= 0xA1,
+	CMD_ID_FL_STATUS		= 0xA2,
+	CMD_ID_LOAD_PARAM_STATUS	= 0xA3,
+	CMD_ID_NV_STATUS		= 0xA4,
+	CMD_ID_XERROR_STATUS		= 0xA5,
+	CMD_ID_GET_FW_KEY		= 0xA6,
+	CMD_ID_INIT_FLASH_WP		= 0xA7,
+	CMD_ID_INIT_FLASH_WP_DISABLE	= 0xA8,
+	CMD_ID_VERSION_ISP		= 0xA9,
+	CMD_ID_GET_TEMPERATURE		= 0xAA,
+
+	CMD_ID_SET_ACK_RESPONSE_MODE	= 0xB0,
+};
+
+enum cam31_mcu_errcode {
+	ERRCODE_SUCCESS = 0x00,
+	ERRCODE_BUSY = 0x01,
+	ERRCODE_INVAL = 0x02,
+	ERRCODE_PERM = 0x03,
+	ERRCODE_NODEV = 0x04,
+	ERRCODE_IO = 0x05,
+	ERRCODE_HW_SPEC = 0x06,
+	ERRCODE_AGAIN = 0x07,
+	ERRCODE_ALREADY = 0x08,
+	ERRCODE_NOTIMPL = 0x09,
+	ERRCODE_RANGE = 0x0A,
+	ERRCODE_UNKNOWN = 0xFF,
+};
+
+#define MCU_CMD_STATUS_SUCCESS		0x0000
+#define MCU_CMD_STATUS_PENDING		0xF000
+#define MCU_CMD_STATUS_ISP_PWDN		0x0FF0
+#define MCU_CMD_STATUS_ISP_UNINIT	0x0FF1
+
+/* Custom V4L2 Control IDs matching e-Con Extension Controls */
+#define V4L2_CID_CAM31_BASE		(V4L2_CID_USER_BASE + 0x2000)
+#define V4L2_CID_CAM_MODE		(V4L2_CID_CAM31_BASE + 1)
+#define V4L2_CID_CUSTOM_TRIGGER		(V4L2_CID_CAM31_BASE + 2)
+#define V4L2_CID_FRAME_SYNC		(V4L2_CID_CAM31_BASE + 3)
+#define V4L2_CID_TRIGGER_MODE		(V4L2_CID_CAM31_BASE + 4)
+#define V4L2_CID_TEMPERATURE		(V4L2_CID_CAM31_BASE + 5)
+
+#define MAX_SUPPORTED_MODES	8
+
+struct cam31_mode {
+	u32 width;
+	u32 height;
+	u32 code;
+	u32 fourcc;
+	u16 fps_num;
+	u16 fps_denom;
+};
+
+struct cam31_ctrl {
+	u32 v4l2_cid;       /* Mapped V4L2 Control ID */
+	u8  ctrl_type;      /* 0x01 = Standard, 0x02 = Extended */
+	u16 index;          /* Index of control in CAM31 */
+	s32 min;
+	s32 max;
+	s32 def;
+	s32 step;
+	struct v4l2_ctrl *ctrl;
+};
+
+struct cam31_dev {
+	struct i2c_client *client;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *temperature_ctrl;
+
+	struct mutex lock; /* Protects stream & ctrl operations */
+	struct cam31_mode modes[MAX_SUPPORTED_MODES];
+	struct cam31_ctrl ctrldb[MCU_MAX_CONTROLS];
+	int num_modes;
+	int num_mcu_ctrls;
+	int current_mode;
+	bool streaming;
+
+	/* Deferred initialization work and state tracking */
+	struct delayed_work init_work;
+	bool initialized;
+};
+
+static inline struct cam31_dev *to_cam31_dev(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct cam31_dev, sd);
+}
+
+static int cam31_read_rx(struct i2c_client *client, u8 *buf, u32 len)
+{
+	struct i2c_msg msg = {
+		.addr = client->addr,
+		.flags = I2C_M_RD,
+		.len = len,
+		.buf = buf,
+	};
+	int ret = i2c_transfer(client->adapter, &msg, 1);
+
+	if (ret < 0)
+		return ret;
+	return ret == 1 ? 0 : -EIO;
+}
+
+static int cam31_write_tx(struct i2c_client *client, const u8 *buf, u32 len)
+{
+	struct i2c_msg msg = {
+		.addr = client->addr,
+		.flags = 0,
+		.len = len,
+		.buf = (u8 *)buf,
+	};
+	int ret = i2c_transfer(client->adapter, &msg, 1);
+
+	if (ret < 0)
+		return ret;
+	return ret == 1 ? 0 : -EIO;
+}
+
+static u8 cam31_checksum(const u8 *data, size_t len)
+{
+	u8 csum = 0;
+	size_t i;
+
+	for (i = 0; i < len; i++)
+		csum ^= data[i];
+
+	return csum;
+}
+
+/* ========================================================================= */
+/* SUBSYSTEM 1: Intel HEX Line Parser                                         */
+/* ========================================================================= */
+
+static int mcu_ascii2hex(u8 ascii)
+{
+	if (ascii >= '0' && ascii <= '9')
+		return ascii - '0';
+	if (ascii >= 'a' && ascii <= 'f')
+		return 0xa + ascii - 'a';
+	if (ascii >= 'A' && ascii <= 'F')
+		return 0xa + ascii - 'A';
+	return -EINVAL;
+}
+
+static int mcu_parse_hex_line(const u8 *ascii, u8 *record, size_t len)
+{
+	u8 checksum = 0;
+	size_t i;
+	int hi, lo;
+
+	/* Byte count, address, type and checksum, plus at most 255 data bytes. */
+	if (len < 10 || len > 2 * (255 + 5) || len % 2)
+		return -EINVAL;
+	for (i = 0; i < len / 2; i++) {
+		hi = mcu_ascii2hex(ascii[2 * i]);
+		lo = mcu_ascii2hex(ascii[2 * i + 1]);
+		if (hi < 0 || lo < 0)
+			return -EINVAL;
+		record[i] = (hi << 4) | lo;
+		checksum += record[i];
+	}
+	if (len / 2 != record[0] + 5)
+		return -EINVAL;
+	return checksum ? -EILSEQ : 0;
+}
+
+/* ========================================================================= */
+/* SUBSYSTEM 2: ST Bootloader Engine & Jumper                                 */
+/* ========================================================================= */
+
+#define MAX_PAGES         512
+#define TOTAL_PAGES       1536
+#define NUM_ERASE_CYCLES  (TOTAL_PAGES / MAX_PAGES)
+
+static int mcu_bootloader_wait_ack(struct i2c_client *client, unsigned int timeout_ms)
+{
+	u8 ack;
+	unsigned int elapsed;
+	int ret;
+
+	for (elapsed = 0; elapsed < timeout_ms; elapsed += 20) {
+		msleep(20);
+		ret = cam31_read_rx(client, &ack, 1);
+		if (ret)
+			return ret;
+		if (ack == RESP_ACK)
+			return 0;
+		if (ack != RESP_BUSY)
+			return -EIO;
+	}
+	return -ETIMEDOUT;
+}
+
+static int mcu_bootloader_erase(struct i2c_client *client)
+{
+	u8 *buf;
+	u16 pagenum;
+	u8 checksum;
+	int i, ret = -EIO;
+
+	buf = kmalloc((2 * MAX_PAGES) + 1, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
+	for (i = 0; i < NUM_ERASE_CYCLES; i++) {
+		buf[0] = BL_ERASE_MEM_NS;
+		buf[1] = (u8)~BL_ERASE_MEM_NS;
+		ret = cam31_write_tx(client, buf, 2);
+		if (ret || cam31_read_rx(client, buf, 1) || buf[0] != RESP_ACK) {
+			dev_err(&client->dev, "Erase cycle %d header failed\n", i);
+			ret = -EIO;
+			goto out;
+		}
+
+		buf[0] = (MAX_PAGES - 1) >> 8;
+		buf[1] = (MAX_PAGES - 1) & 0xFF;
+		buf[2] = buf[0] ^ buf[1];
+		ret = cam31_write_tx(client, buf, 3);
+		if (ret || cam31_read_rx(client, buf, 1) || buf[0] != RESP_ACK) {
+			dev_err(&client->dev, "Erase cycle %d page count rejected\n", i);
+			ret = -EIO;
+			goto out;
+		}
+
+		checksum = 0x00;
+		for (pagenum = 0; pagenum < MAX_PAGES; pagenum++) {
+			u16 actual_page = pagenum + (i * MAX_PAGES);
+			buf[2 * pagenum]     = actual_page >> 8;
+			buf[(2 * pagenum) + 1] = actual_page & 0xFF;
+			checksum ^= buf[2 * pagenum] ^ buf[(2 * pagenum) + 1];
+		}
+		buf[2 * MAX_PAGES] = checksum;
+
+		ret = cam31_write_tx(client, buf, (2 * MAX_PAGES) + 1);
+		if (ret) {
+			dev_err(&client->dev, "Erase cycle %d page list write failed\n", i);
+			ret = -EIO;
+			goto out;
+		}
+
+		ret = mcu_bootloader_wait_ack(client, 30000);
+		if (ret) {
+			dev_err(&client->dev, "Erase cycle %d failed: %d\n", i, ret);
+			goto out;
+		}
+	}
+
+	ret = 0;
+
+out:
+	kfree(buf);
+	return ret;
+}
+
+static int mcu_bootloader_write_page(struct i2c_client *client, u32 flash_addr,
+				     const u8 *data, u16 len)
+{
+	u8 buf[260];
+	u8 checksum = 0;
+	int i;
+
+	if (!len || len > 256)
+		return -EINVAL;
+
+	if (flash_addr % 4096 == 0)
+		dev_info(&client->dev, "   loading MCU at %8x...", flash_addr);
+
+	buf[0] = BL_WRITE_MEM_NS;
+	buf[1] = ~BL_WRITE_MEM_NS;
+	if (cam31_write_tx(client, buf, 2) || cam31_read_rx(client, buf, 1) || buf[0] != RESP_ACK)
+		return -EIO;
+
+	buf[0] = (flash_addr >> 24) & 0xFF;
+	buf[1] = (flash_addr >> 16) & 0xFF;
+	buf[2] = (flash_addr >> 8) & 0xFF;
+	buf[3] = flash_addr & 0xFF;
+	buf[4] = buf[0] ^ buf[1] ^ buf[2] ^ buf[3];
+	if (cam31_write_tx(client, buf, 5) || cam31_read_rx(client, buf, 1) || buf[0] != RESP_ACK)
+		return -EIO;
+
+	buf[0] = len - 1;
+	checksum = buf[0];
+	for (i = 0; i < len; i++) {
+		buf[i + 1] = data[i];
+		checksum ^= data[i];
+	}
+	buf[len + 1] = checksum;
+
+	if (cam31_write_tx(client, buf, len + 2))
+		return -EIO;
+	return mcu_bootloader_wait_ack(client, 5000);
+}
+
+static int mcu_bootloader_go(struct i2c_client *client, u32 start_addr)
+{
+	u8 buf[5];
+
+	buf[0] = BL_GO;
+	buf[1] = ~BL_GO;
+	if (cam31_write_tx(client, buf, 2) || cam31_read_rx(client, buf, 1) || buf[0] != RESP_ACK)
+		return -EIO;
+
+	buf[0] = (start_addr >> 24) & 0xFF;
+	buf[1] = (start_addr >> 16) & 0xFF;
+	buf[2] = (start_addr >> 8) & 0xFF;
+	buf[3] = start_addr & 0xFF;
+	buf[4] = buf[0] ^ buf[1] ^ buf[2] ^ buf[3];
+
+	if (cam31_write_tx(client, buf, 5) || cam31_read_rx(client, buf, 1))
+		return -EIO;
+	if (buf[0] == RESP_ACK)
+		return 0;
+	return -EIO;
+}
+
+static int mcu_bootloader_read_page(struct i2c_client *client, u32 address,
+				    u8 *data, u16 len)
+{
+	u8 packet[5], ack;
+
+	if (!len || len > 256)
+		return -EINVAL;
+	packet[0] = BL_READ_MEM;
+	packet[1] = (u8)~BL_READ_MEM;
+	if (cam31_write_tx(client, packet, 2) ||
+	    cam31_read_rx(client, &ack, 1) || ack != RESP_ACK)
+		return -EIO;
+	packet[0] = address >> 24;
+	packet[1] = address >> 16;
+	packet[2] = address >> 8;
+	packet[3] = address;
+	packet[4] = cam31_checksum(packet, 4);
+	if (cam31_write_tx(client, packet, 5) ||
+	    cam31_read_rx(client, &ack, 1) || ack != RESP_ACK)
+		return -EIO;
+	packet[0] = len - 1;
+	packet[1] = (u8)~packet[0];
+	if (cam31_write_tx(client, packet, 2) ||
+	    cam31_read_rx(client, &ack, 1) || ack != RESP_ACK)
+		return -EIO;
+	return cam31_read_rx(client, data, len);
+}
+
+static int mcu_walk_hex(struct i2c_client *client, const u8 *data, size_t size,
+			bool program)
+{
+	u8 record[255 + 5], verify[256];
+	u32 upper = 0, address;
+	size_t start = 0, end;
+	bool vectors = false, eof = false;
+	u16 low;
+	u8 len, type;
+	int ret;
+
+	while (start < size) {
+		if (data[start] == '\n' || data[start] == '\r') {
+			start++;
+			continue;
+		}
+		if (eof || data[start] != ':')
+			return -EINVAL;
+		for (end = start + 1; end < size && data[end] != '\n' && data[end] != '\r'; end++)
+			;
+		ret = mcu_parse_hex_line(&data[start + 1], record, end - start - 1);
+		if (ret)
+			return ret;
+		len = record[0];
+		low = (record[1] << 8) | record[2];
+		type = record[3];
+		switch (type) {
+		case 0x00:
+			address = upper | low;
+			if (!len || address < FLASH_START_ADDRESS ||
+			    address >= FLASH_START_ADDRESS + CAM31_MCU_FLASH_SIZE ||
+			    len > FLASH_START_ADDRESS + CAM31_MCU_FLASH_SIZE - address)
+				return -EINVAL;
+			if (address == FLASH_START_ADDRESS && len >= 8)
+				vectors = true;
+			if (program) {
+				ret = mcu_bootloader_write_page(client, address, &record[4], len);
+				if (ret)
+					return ret;
+				ret = mcu_bootloader_read_page(client, address, verify, len);
+				if (ret)
+					return ret;
+				if (memcmp(verify, &record[4], len))
+					return -EILSEQ;
+			}
+			break;
+		case 0x01:
+			if (len || low)
+				return -EINVAL;
+			eof = true;
+			break;
+		case 0x04:
+			if (len != 2 || low)
+				return -EINVAL;
+			upper = ((u32)record[4] << 24) | ((u32)record[5] << 16);
+			break;
+		case 0x05:
+			if (len != 4 || low)
+				return -EINVAL;
+			break;
+		default:
+			return -EINVAL;
+		}
+		start = end;
+	}
+	return eof && vectors ? 0 : -EINVAL;
+}
+
+static int mcu_flash_intel_hex(struct i2c_client *client, const u8 *data, size_t size)
+{
+	int ret;
+
+	/* Validate every record and address before the first destructive command. */
+	ret = mcu_walk_hex(client, data, size, false);
+	if (ret)
+		return ret;
+	ret = mcu_bootloader_erase(client);
+	if (ret)
+		return ret;
+	ret = mcu_walk_hex(client, data, size, true);
+	if (ret)
+		return ret;
+	return mcu_bootloader_go(client, FLASH_START_ADDRESS);
+}
+
+/* -----------------------------------------------------------------------------
+ * MCU Packet Protocol Transport Layer
+ * -----------------------------------------------------------------------------
+ */
+static int cam31_get_cmd_status(struct i2c_client *client, u8 cmd_id)
+{
+	u8 header[] = { MCU_CMD_SIGNATURE, CMD_ID_GET_STATUS, 0, 1, 1 };
+	u8 command[] = { MCU_CMD_SIGNATURE, CMD_ID_GET_STATUS, cmd_id };
+	u8 response[7];
+	u16 status;
+	int ret, retry;
+	bool flash_command = cmd_id == CMD_ID_INIT_CAM_ISP ||
+			     cmd_id == CMD_ID_INIT_CAM_ISP_ERASE;
+
+	/* Poll status only. Never resend an uncertain sequential flash write. */
+	for (retry = 0; retry < 50; retry++) {
+		ret = cam31_write_tx(client, header, sizeof(header));
+		if (ret)
+			return ret;
+		ret = cam31_write_tx(client, command, sizeof(command));
+		if (ret)
+			return ret;
+		ret = cam31_read_rx(client, response, sizeof(response));
+		if (ret)
+			return ret;
+		if (response[0] != MCU_CMD_SIGNATURE ||
+		    response[1] != CMD_ID_GET_STATUS || response[2] != cmd_id ||
+		    cam31_checksum(&response[2], 3) != response[5])
+			return -EBADMSG;
+
+		status = (response[3] << 8) | response[4];
+		if (status == MCU_CMD_STATUS_PENDING || response[6] == ERRCODE_BUSY) {
+			msleep(100);
+			continue;
+		}
+		if (response[6] == ERRCODE_AGAIN)
+			return -EAGAIN;
+		if (response[6] != ERRCODE_SUCCESS &&
+		    (response[6] != ERRCODE_ALREADY || flash_command))
+			return -EIO;
+		if (status == MCU_CMD_STATUS_SUCCESS)
+			return 0;
+		/* The ISP is uninitialized while writing bootdata or setting ACK mode. */
+		if (status == MCU_CMD_STATUS_ISP_UNINIT ||
+		    status == MCU_CMD_STATUS_ISP_PWDN) {
+			if (flash_command || cmd_id == CMD_ID_SET_ACK_RESPONSE_MODE)
+				return 0;
+			return -ENODATA;
+		}
+		return -EIO;
+	}
+	return -ETIMEDOUT;
+}
+
+static int cam31_send_cmd(struct i2c_client *client, u8 cmd_id,
+			  const u8 *payload, u16 len)
+{
+	u8 packet[MCU_MAX_PAYLOAD + 3];
+	int ret;
+
+	if (len > MCU_MAX_PAYLOAD || (len && !payload))
+		return -EINVAL;
+	packet[0] = MCU_CMD_SIGNATURE;
+	packet[1] = cmd_id;
+	packet[2] = len >> 8;
+	packet[3] = len & 0xff;
+	packet[4] = packet[2] ^ packet[3];
+	ret = cam31_write_tx(client, packet, 5);
+	if (ret)
+		return ret;
+	usleep_range(10000, 12000);
+	if (len) {
+		memcpy(&packet[2], payload, len);
+		packet[len + 2] = cam31_checksum(payload, len);
+	}
+	return cam31_write_tx(client, packet, len ? len + 3 : 2);
+}
+
+static int cam31_mcu_cmd(struct i2c_client *client, u8 cmd_id,
+			 const u8 *tx_msg, u16 tx_len,
+			 u8 *rx_msg, u16 rx_len)
+{
+	u8 packet[MCU_MAX_PAYLOAD + 4];
+	u16 len;
+	int ret = -EIO, retry;
+
+	/* Flash erase/write have their own framing, timing and no-resend policy. */
+	if (cmd_id == CMD_ID_INIT_CAM_ISP || cmd_id == CMD_ID_INIT_CAM_ISP_ERASE ||
+	    rx_len > MCU_MAX_PAYLOAD || (rx_len && !rx_msg))
+		return -EINVAL;
+
+	for (retry = 0; retry < (rx_len ? 5 : 1); retry++) {
+		if (retry)
+			msleep(100);
+		ret = cam31_send_cmd(client, cmd_id, tx_msg, tx_len);
+		if (ret)
+			continue;
+		if (cmd_id == CMD_ID_INIT_FLASH_WP ||
+		    cmd_id == CMD_ID_INIT_FLASH_WP_DISABLE) {
+			/* These vendor commands do not have a GET_STATUS response. */
+			msleep(200);
+			return 0;
+		}
+		if (cmd_id == CMD_ID_SET_ACK_RESPONSE_MODE)
+			msleep(100);
+		if (!rx_len)
+			return cam31_get_cmd_status(client, cmd_id);
+
+		usleep_range(10000, 12000);
+		ret = cam31_read_rx(client, packet, 6);
+		if (ret)
+			continue;
+		if (packet[0] != MCU_CMD_SIGNATURE || packet[1] != cmd_id ||
+		    (packet[2] ^ packet[3]) != packet[4]) {
+			ret = -EBADMSG;
+			continue;
+		}
+		if (packet[5] != ERRCODE_SUCCESS)
+			return packet[5] == ERRCODE_AGAIN ? -EAGAIN : -EIO;
+		len = (packet[2] << 8) | packet[3];
+		if (len > MCU_MAX_PAYLOAD)
+			return -EMSGSIZE;
+		ret = cam31_read_rx(client, packet, len + 4);
+		if (ret)
+			continue;
+		if (packet[0] != MCU_CMD_SIGNATURE || packet[1] != cmd_id ||
+		    cam31_checksum(&packet[2], len) != packet[len + 2])
+			return -EBADMSG;
+		if (packet[len + 3] != ERRCODE_SUCCESS)
+			return packet[len + 3] == ERRCODE_AGAIN ? -EAGAIN : -EIO;
+		if (len > rx_len)
+			return -EMSGSIZE;
+		/* Critical firmware decisions require complete, fixed-size replies. */
+		if ((cmd_id == CMD_ID_GET_FW_KEY || cmd_id == CMD_ID_VERSION ||
+		     cmd_id == CMD_ID_VERSION_ISP ||
+		     (cmd_id >= CMD_ID_FL_STATUS && cmd_id <= CMD_ID_NV_STATUS)) &&
+		    len != rx_len)
+			return -EMSGSIZE;
+		if (!len)
+			return -ENODATA;
+		memset(rx_msg, 0, rx_len);
+		memcpy(rx_msg, &packet[2], len);
+		return 0;
+	}
+	return ret;
+}
+
+static int cam31_isp_erase(struct i2c_client *client)
+{
+	/* A1 advertises zero payload bytes, but sends one sector byte, no CRC. */
+	u8 header[] = { MCU_CMD_SIGNATURE, CMD_ID_INIT_CAM_ISP_ERASE, 0, 0, 0 };
+	u8 command[] = { MCU_CMD_SIGNATURE, CMD_ID_INIT_CAM_ISP_ERASE, 0 };
+	int ret;
+
+	ret = cam31_write_tx(client, header, sizeof(header));
+	if (ret)
+		return ret;
+	usleep_range(2000, 3000);
+	ret = cam31_write_tx(client, command, sizeof(command));
+	if (ret)
+		return ret;
+	msleep(18000);
+	return cam31_get_cmd_status(client, CMD_ID_INIT_CAM_ISP_ERASE);
+}
+
+static int isp_flash_bootdata(struct i2c_client *client, const u8 *bin_data,
+			      size_t size)
+{
+	u8 key[16];
+	u8 chunk[ISX_BUFFER_SIZE];
+	size_t offset, i;
+	int ret, protect_ret;
+
+	/* Reject partial images before changing flash protection or erasing. */
+	if (size != CAM31_ISP_FLASH_SIZE)
+		return -EINVAL;
+	ret = cam31_mcu_cmd(client, CMD_ID_GET_FW_KEY, NULL, 0, key, sizeof(key));
+	if (ret)
+		goto clear_key;
+
+	ret = cam31_mcu_cmd(client, CMD_ID_INIT_FLASH_WP_DISABLE, NULL, 0, NULL, 0);
+	if (ret)
+		goto protect;
+	msleep(200);
+	dev_info(&client->dev, "Erasing CAM31 ISP bootdata\n");
+	ret = cam31_isp_erase(client);
+	if (ret)
+		goto protect;
+
+	for (offset = 0; offset < size; offset += sizeof(chunk)) {
+		for (i = 0; i < sizeof(chunk); i++)
+			chunk[i] = bin_data[offset + i] ^ key[(offset + i) % sizeof(key)];
+		/* No resend: the MCU advances its implicit flash address per block. */
+		ret = cam31_send_cmd(client, CMD_ID_INIT_CAM_ISP, chunk, sizeof(chunk));
+		if (ret)
+			goto protect;
+		msleep(100);
+		ret = cam31_get_cmd_status(client, CMD_ID_INIT_CAM_ISP);
+		if (ret)
+			goto protect;
+		if ((offset + sizeof(chunk)) % (64 * sizeof(chunk)) == 0)
+			dev_info(&client->dev, "CAM31 ISP firmware: %zu%%\n",
+				 (offset + sizeof(chunk)) * 100 / size);
+	}
+
+protect:
+	/* Also attempt protection after a failed or uncertain unprotect/write. */
+	protect_ret = cam31_mcu_cmd(client, CMD_ID_INIT_FLASH_WP, NULL, 0, NULL, 0);
+	if (protect_ret) {
+		dev_err(&client->dev, "Cannot restore ISP flash protection: %d\n",
+			protect_ret);
+		if (!ret)
+			ret = protect_ret;
+	}
+	if (ret)
+		dev_err(&client->dev, "ISP firmware recovery incomplete: %d\n", ret);
+clear_key:
+	memzero_explicit(key, sizeof(key));
+	memzero_explicit(chunk, sizeof(chunk));
+	return ret;
+}
+
+/* -----------------------------------------------------------------------------
+ * V4L2 Controls Handling
+ * -----------------------------------------------------------------------------
+ */
+struct cam31_mcu_set_ctrl_payload {
+	__be16 index;
+	__be32 ctrl_id;
+	u8     ctrl_type;
+	__be32 val;
+} __packed;
+
+struct cam31_mcu_get_ctrl_payload {
+	__be32 ctrl_id;   
+	u8     ctrl_type; 
+} __packed;
+
+static struct cam31_ctrl *cam31_find_ctrl(struct cam31_dev *cam, u32 v4l2_cid)
+{
+	int i;
+	for (i = 0; i < cam->num_mcu_ctrls; i++) {
+		if (cam->ctrldb[i].v4l2_cid == v4l2_cid)
+			return &cam->ctrldb[i];
+	}
+	return NULL;
+}
+
+static int cam31_g_volatile_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct cam31_dev *cam = container_of(ctrl->handler, struct cam31_dev, ctrls);
+	struct cam31_ctrl *map;
+	struct cam31_mcu_get_ctrl_payload tx_payload;
+	u8 rx_buf[10];
+	int ret;
+
+	if (!cam->initialized)
+		return -EAGAIN;
+
+	map = cam31_find_ctrl(cam, ctrl->id);
+	if (!map)
+		return -EINVAL;
+
+	memset(&tx_payload, 0, sizeof(tx_payload));
+	tx_payload.ctrl_id   = cpu_to_be32(map->v4l2_cid);
+	tx_payload.ctrl_type = map->ctrl_type;
+
+	ret = cam31_mcu_cmd(cam->client, CMD_ID_GET_CTRL,
+			    (u8 *)&tx_payload, sizeof(tx_payload),
+			    rx_buf, sizeof(rx_buf));
+	if (ret)
+		return ret;
+
+	ctrl->val = (s32)be32_to_cpup((__be32 *)&rx_buf[5]);
+	return 0;
+}
+
+
+static int cam31_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct cam31_dev *cam = container_of(ctrl->handler, struct cam31_dev, ctrls);
+	struct cam31_ctrl *map;
+	struct cam31_mcu_set_ctrl_payload payload;
+        int ret;
+
+	if (!cam->initialized)
+		return -EAGAIN;
+
+	map = cam31_find_ctrl(cam, ctrl->id);
+	if (!map) {
+		dev_warn(&cam->client->dev, "Invalid ctrl: %x\n", ctrl->id);
+                return 0;
+        }
+
+	memset(&payload, 0, sizeof(payload));
+	payload.index     = cpu_to_be16(map->index);
+	payload.ctrl_id   = cpu_to_be32(map->v4l2_cid);
+	payload.ctrl_type = map->ctrl_type;
+	payload.val       = cpu_to_be32(ctrl->val);
+
+	ret = cam31_mcu_cmd(cam->client, CMD_ID_SET_CTRL,
+                            (u8 *)&payload, sizeof(payload), NULL, 0);
+        dev_info(&cam->client->dev, "s_ctrl %x %d min=%d max=%d def=%d: %d\n",
+                 ctrl->id, ctrl->val, map->min, map->max, map->def, ret);
+        return 0;
+}
+
+static const struct v4l2_ctrl_ops cam31_ctrl_ops = {
+	.s_ctrl          = cam31_s_ctrl,
+	.g_volatile_ctrl = cam31_g_volatile_ctrl,
+};
+
+static bool cam31_is_valid_isx031_ctrl(u32 cid)
+{
+	switch (cid) {
+	case V4L2_CID_BRIGHTNESS:
+	case V4L2_CID_CONTRAST:
+	case V4L2_CID_SATURATION:
+	case V4L2_CID_SHARPNESS:
+	case V4L2_CID_FRAME_SYNC:
+	case V4L2_CID_HUE:
+	case V4L2_CID_EXPOSURE_AUTO:
+	case V4L2_CID_EXPOSURE_ABSOLUTE:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static int cam31_init_controls(struct cam31_dev *cam)
+{
+	struct v4l2_ctrl_handler *hdl = &cam->ctrls;
+	u8 tx_payload[2];
+	u8 rx_buf[64];
+	u16 index = 0;
+	int ret;
+
+        if (list_empty(&hdl->ctrls)) {
+		while (index < MCU_MAX_CONTROLS) {
+			tx_payload[0] = (index >> 8) & 0xFF;
+			tx_payload[1] = index & 0xFF;
+
+			ret = cam31_mcu_cmd(cam->client, CMD_ID_GET_CTRL_INFO,
+					    tx_payload, 2, rx_buf, sizeof(rx_buf));
+			if (ret)
+				break;
+
+			u32 cid = (rx_buf[0] << 24) | (rx_buf[1] << 16) | (rx_buf[2] << 8) | rx_buf[3];
+
+			if (!cam31_is_valid_isx031_ctrl(cid)) {
+				index++;
+				continue;
+			}
+
+			struct cam31_ctrl *map = &cam->ctrldb[cam->num_mcu_ctrls];
+			map->v4l2_cid  = cid;
+			map->ctrl_type = rx_buf[4];
+			map->index     = index;
+			map->min       = (s32)be32_to_cpup((__be32 *)&rx_buf[5]);
+			map->max       = (s32)be32_to_cpup((__be32 *)&rx_buf[9]);
+			map->def       = (s32)be32_to_cpup((__be32 *)&rx_buf[13]);
+			map->step      = (s32)be32_to_cpup((__be32 *)&rx_buf[17]);
+
+			if (map->v4l2_cid == V4L2_CID_EXPOSURE_AUTO) {
+				map->ctrl = v4l2_ctrl_new_std_menu(hdl, &cam31_ctrl_ops,
+								   map->v4l2_cid, map->max,
+								   0, map->def);
+			} else {
+				map->ctrl = v4l2_ctrl_new_std(hdl, &cam31_ctrl_ops,
+							      map->v4l2_cid, map->min, map->max,
+							      map->step, map->def);
+			}
+
+			if (map->ctrl)
+				cam->num_mcu_ctrls++;
+			index++;
+		}
+
+		if (hdl->error) {
+			v4l2_ctrl_handler_free(hdl);
+			return hdl->error;
+		}
+	}
+	return v4l2_ctrl_handler_setup(&cam->ctrls);
+}
+
+static __maybe_unused int cam31_isp_read_reg(struct i2c_client *client, u16 reg_addr)
+{
+    u8 tx_payload[3];
+    u8 rx_buf[4] = {0};
+    int ret;
+
+    tx_payload[0] = (reg_addr >> 8) & 0xFF;
+    tx_payload[1] = reg_addr & 0xFF;
+    tx_payload[2] = 2;
+
+    ret = cam31_mcu_cmd(client, CMD_ID_ISP_READ, tx_payload, 3, rx_buf, sizeof(rx_buf));
+    if (ret) {
+        dev_err(&client->dev, "ISP read reg 0x%04x failed: %d\n", reg_addr, ret);
+        return ret;
+    }
+
+    return (rx_buf[3] << 8) | rx_buf[2];
+}
+
+/* -----------------------------------------------------------------------------
+ * Hardware Hardware Initialization & Driver Probe
+ * -----------------------------------------------------------------------------
+ */
+static int ser_update_reg16(struct i2c_client *client, u16 reg, u8 mask, u8 val)
+{
+	u8 recv[1];
+	u8 send[3] = { (reg >> 8) & 0xff, reg & 0xff, 0 };
+	struct i2c_msg msgs[] = {
+		{
+			.addr = SER_ADDR,
+			.flags = 0,
+			.len   = 2,
+			.buf   = send
+		},
+		{
+			.addr  = SER_ADDR,
+			.flags = I2C_M_RD,
+			.len   = 1,
+			.buf   = recv
+		},
+	};
+
+	int ret = i2c_transfer(client->adapter, msgs, 2);
+	if (ret < 2)
+		return -EIO;
+
+	send[2] = (recv[0] & ~mask) | (val & mask);
+	msgs[0].len = 3;
+	ret = i2c_transfer(client->adapter, msgs, 1);
+	if (ret < 1)
+		return -EIO;
+
+	dev_info(&client->dev, "update_reg16 %02x = %02x\n", reg, send[2]);
+	return 0;
+}
+
+static int ser_gpio_level(struct i2c_client *client, u16 gpio, bool level)
+{
+	int ret = ser_update_reg16(client, gpio, SER_GPIO_OUT_MASK,
+				   level ? SER_GPIO_HIGH : SER_GPIO_LOW);
+	if (ret)
+		dev_warn(&client->dev, "ser_gpio_level %02x: %d\n", gpio, ret);
+	return ret;
+}
+
+static int ser_gpio_config(struct i2c_client *client, u16 gpio) {
+	int ret = ser_update_reg16(client, gpio+1, SER_GPIO_CFG_MASK, SER_GPIO_PP);
+	if (ret)
+		dev_warn(&client->dev, "ser_gpio_config %02x: %d\n", gpio, ret);
+	return ret;
+}
+
+#ifdef CAM31_INIT_GPIOS
+/*
+ * Initialize all the crazy insane GPIO initialization required
+ * on the serializer to boot the ISX031 ISP.
+ */
+static int cam31_init_gpios(struct i2c_client *client)
+{
+    int ret;
+    static u16 gpios[] = {
+        SER_REG_RESET,
+        SER_REG_BOOT,
+        SER_REG_GPIO3,
+        SER_REG_GPIO5,
+        SER_REG_GPIO7,
+        SER_REG_GPIO8,
+    };
+
+    for (int i = 0; i < ARRAY_SIZE(gpios); i++) {
+        ret = ser_gpio_config(client, gpios[i]);
+        if (ret) return ret;
+    }
+    
+    ret = ser_gpio_level(client, SER_REG_BOOT, false);
+    if (ret) return ret;
+
+    ret = ser_gpio_level(client, SER_REG_GPIO7, false);
+    if (ret) return ret;
+
+    ret = ser_gpio_level(client, SER_REG_GPIO8, false);
+    if (ret) return ret;
+    ret = ser_gpio_level(client, SER_REG_GPIO8, true);
+    if (ret) return ret;
+
+    ret = ser_gpio_level(client, SER_REG_GPIO3, false);
+    if (ret) return ret;
+
+    ret = ser_gpio_level(client, SER_REG_GPIO5, true);
+    if (ret) return ret;
+
+    msleep(20);
+    return 0;
+}
+#endif
+
+/* -----------------------------------------------------------------------------
+ * V4L2 Subdevice Operations
+ * -----------------------------------------------------------------------------
+ */
+struct cam31_stream_config_payload {
+	__be16 mode_index;
+	__be32 fourcc;
+	__be16 width;
+	__be16 height;
+	__be16 fps_num;
+	__be16 fps_den;
+} __packed;
+
+static int cam31_s_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct cam31_dev *cam = to_cam31_dev(sd);
+	struct cam31_stream_config_payload payload;
+	const struct cam31_mode *mode;
+	int ret = 0;
+
+	if (!cam->initialized)
+		return -EAGAIN;
+
+	mutex_lock(&cam->lock);
+
+	if (cam->streaming == !!enable)
+		goto out;
+
+	if (enable) {
+		mode = &cam->modes[cam->current_mode];
+
+		payload.mode_index = cpu_to_be16(cam->current_mode);
+		payload.fourcc     = cpu_to_be32(mode->fourcc);
+		payload.width      = cpu_to_be16(mode->width);
+		payload.height     = cpu_to_be16(mode->height);
+		payload.fps_num    = cpu_to_be16(mode->fps_num);
+		payload.fps_den    = cpu_to_be16(mode->fps_denom ? mode->fps_denom : 1);
+
+		ret = cam31_mcu_cmd(cam->client, CMD_ID_STREAM_CONFIG,
+				     (u8 *)&payload, sizeof(payload), NULL, 0);
+		if (ret) {
+			dev_err(&cam->client->dev,
+				"Failed to send stream config: %d\n", ret);
+			goto out;
+		}
+
+		ret = cam31_mcu_cmd(cam->client, CMD_ID_STREAM_ON, NULL, 0, NULL, 0);
+		if (!ret)
+			cam->streaming = true;
+
+#ifdef DEBUG
+		dev_info(&cam->client->dev, "ISP frame count #1: %x\n", cam31_isp_read_reg(cam->client, 0x7dc8));
+		dev_info(&cam->client->dev, "ISP standby state: %x\n", cam31_isp_read_reg(cam->client, 0x6005));
+		dev_info(&cam->client->dev, "ISP chip ID: %x\n", cam31_isp_read_reg(cam->client, 0x8a54));
+                msleep(50);
+		dev_info(&cam->client->dev, "ISP frame count #2: %x\n", cam31_isp_read_reg(cam->client, 0x7dc8));
+                msleep(50);
+		dev_info(&cam->client->dev, "ISP frame count #3: %x\n", cam31_isp_read_reg(cam->client, 0x7dc8));
+                msleep(50);
+		dev_info(&cam->client->dev, "ISP frame count #4: %x\n", cam31_isp_read_reg(cam->client, 0x7dc8));
+#endif
+	} else {
+		ret = cam31_mcu_cmd(cam->client, CMD_ID_STREAM_OFF, NULL, 0, NULL, 0);
+		if (!ret)
+			cam->streaming = false;
+	}
+
+out:
+	mutex_unlock(&cam->lock);
+	return ret;
+}
+
+static int cam31_enum_mbus_code(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *sd_state,
+				struct v4l2_subdev_mbus_code_enum *code)
+{
+	struct cam31_dev *cam = to_cam31_dev(sd);
+
+	if (code->index >= cam->num_modes)
+		return -EINVAL;
+
+	code->code = cam->modes[code->index].code;
+	return 0;
+}
+
+static int cam31_enum_frame_size(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct cam31_dev *cam = to_cam31_dev(sd);
+
+	if (fse->index >= cam->num_modes)
+		return -EINVAL;
+
+	if (fse->code != cam->modes[fse->index].code)
+		return -EINVAL;
+
+	fse->min_width = cam->modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = cam->modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int cam31_get_frame_desc(struct v4l2_subdev *sd, unsigned int pad,
+				struct v4l2_mbus_frame_desc *fd)
+{
+	if (pad != 0)
+		return -EINVAL;
+	memset(fd, 0, sizeof(*fd));
+	fd->type = V4L2_MBUS_FRAME_DESC_TYPE_CSI2;
+	fd->num_entries = 1;
+	fd->entry[0].stream = 0;
+	fd->entry[0].flags = V4L2_MBUS_FRAME_DESC_FL_LEN_MAX;
+	fd->entry[0].pixelcode = MEDIA_BUS_FMT_UYVY8_1X16;
+	fd->entry[0].bus.csi2.vc = 0;
+	fd->entry[0].bus.csi2.dt = MIPI_CSI2_DT_YUV422_8B;
+	return 0;
+}
+
+static int cam31_get_fmt(struct v4l2_subdev *sd,
+			 struct v4l2_subdev_state *sd_state,
+			 struct v4l2_subdev_format *fmt)
+{
+	struct cam31_dev *cam = to_cam31_dev(sd);
+	struct v4l2_mbus_framefmt *mbus_fmt = &fmt->format;
+	const struct cam31_mode *mode = &cam->modes[cam->current_mode];
+
+	mutex_lock(&cam->lock);
+	mbus_fmt->width = mode->width;
+	mbus_fmt->height = mode->height;
+	mbus_fmt->code = mode->code;
+	mbus_fmt->field = V4L2_FIELD_NONE;
+	mbus_fmt->colorspace = V4L2_COLORSPACE_SRGB;
+	mutex_unlock(&cam->lock);
+
+	return 0;
+}
+
+static int cam31_set_fmt(struct v4l2_subdev *sd,
+			 struct v4l2_subdev_state *sd_state,
+			 struct v4l2_subdev_format *fmt)
+{
+	struct cam31_dev *cam = to_cam31_dev(sd);
+	const struct cam31_mode *mode;
+
+	if (fmt->pad != 0)
+		return -EINVAL;
+
+	mode = v4l2_find_nearest_size(cam->modes,
+				      cam->num_modes,
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	mutex_lock(&cam->lock);
+	if (cam->streaming) {
+		mutex_unlock(&cam->lock);
+		return -EBUSY;
+	}
+
+	cam->current_mode = mode - cam->modes;
+
+	fmt->format.width = mode->width;
+	fmt->format.height = mode->height;
+	fmt->format.code = MEDIA_BUS_FMT_UYVY8_1X16;
+	fmt->format.field = V4L2_FIELD_NONE;
+	fmt->format.colorspace = V4L2_COLORSPACE_SRGB;
+	mutex_unlock(&cam->lock);
+	return 0;
+}
+
+static int cam31_init_state(struct v4l2_subdev *sd,
+			    struct v4l2_subdev_state *sd_state)
+{
+	struct cam31_dev *cam = to_cam31_dev(sd);
+
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.format = {
+			.width = cam->modes[0].width,
+			.height = cam->modes[0].height,
+			.code = cam->modes[0].code,
+			.field = V4L2_FIELD_NONE,
+		},
+	};
+
+	return cam31_set_fmt(sd, sd_state, &fmt);
+}
+
+static int cam31_core_reset(struct v4l2_subdev *sd, u32 val)
+{
+	struct cam31_dev *cam = to_cam31_dev(sd);
+
+	if (val) {
+		dev_info(&cam->client->dev, "Link locked! Scheduling delayed init...\n");
+		schedule_delayed_work(&cam->init_work, msecs_to_jiffies(100));
+	} else {
+		dev_warn(&cam->client->dev, "Link lost! Resetting initialized state...\n");
+		cancel_delayed_work_sync(&cam->init_work);
+		if (cam->initialized) {
+			v4l2_ctrl_handler_free(&cam->ctrls);
+			cam->initialized = false;
+		}
+        }
+	return 0;
+}
+
+static const struct v4l2_subdev_core_ops cam31_core_ops = {
+	.reset = cam31_core_reset,
+};
+
+static const struct v4l2_subdev_internal_ops cam31_internal_ops = {
+	.init_state = cam31_init_state,
+};
+
+static const struct v4l2_subdev_video_ops cam31_video_ops = {
+	.s_stream = cam31_s_stream,
+};
+
+static const struct v4l2_subdev_pad_ops cam31_pad_ops = {
+	.enum_mbus_code = cam31_enum_mbus_code,
+	.enum_frame_size = cam31_enum_frame_size,
+	.get_frame_desc = cam31_get_frame_desc,
+	.get_fmt = cam31_get_fmt,
+	.set_fmt = cam31_set_fmt,
+};
+
+static const struct v4l2_subdev_ops cam31_subdev_ops = {
+	.core = &cam31_core_ops,
+	.video = &cam31_video_ops,
+	.pad = &cam31_pad_ops,
+};
+
+static int mcu_pulse_reset(struct i2c_client *client)
+{
+	int ret;
+
+	ret = ser_gpio_level(client, SER_REG_RESET, false);
+	if (ret)
+		return ret;
+	msleep(1);
+
+	ret = ser_gpio_level(client, SER_REG_RESET, true);
+	if (ret)
+		return ret;
+	msleep(1);
+	return 0;
+}
+
+static int mcu_bootloader_check(struct i2c_client *client)
+{
+	u8 command[] = { BL_GET_VERSION, (u8)~BL_GET_VERSION };
+	u8 response;
+	int ret;
+
+	/* Confirm the ROM bootloader before automatic MCU recovery. */
+	ret = cam31_write_tx(client, command, sizeof(command));
+	if (ret)
+		return ret;
+	ret = cam31_read_rx(client, &response, 1);
+	if (ret || response != RESP_ACK)
+		return ret ? ret : -ENODEV;
+	ret = cam31_read_rx(client, &response, 1);
+	if (ret)
+		return ret;
+	ret = cam31_read_rx(client, &response, 1);
+	if (ret || response != RESP_ACK)
+		return ret ? ret : -ENODEV;
+	return 0;
+}
+
+static int cam31_start_isp(struct i2c_client *client)
+{
+	int ret;
+
+	ret = cam31_mcu_cmd(client, CMD_ID_INIT_CAM, NULL, 0, NULL, 0);
+	if (ret && ret != -ENODATA)
+		return ret;
+	ret = cam31_mcu_cmd(client, CMD_ID_SET_ACK_RESPONSE_MODE, NULL, 0, NULL, 0);
+	if (ret)
+		return ret;
+	msleep(50);
+	return 0;
+}
+
+static int cam31_read_boot_status(struct i2c_client *client, u8 status[3])
+{
+	int i, ret;
+
+	for (i = 0; i < 3; i++) {
+		ret = cam31_mcu_cmd(client, CMD_ID_FL_STATUS + i, NULL, 0,
+				    &status[i], 1);
+		if (ret)
+			return ret;
+		if (status[i] > 1)
+			return -EBADMSG;
+	}
+	return 0;
+}
+
+static int cam31_check_isp(struct i2c_client *client)
+{
+	u8 status[3];
+	int ret, retry, invalid = 0;
+
+	/* A2 detects the flash device; A3/A4 validate the ISP bootdata. */
+	for (retry = 0; retry < 5; retry++) {
+		ret = cam31_read_boot_status(client, status);
+		if (ret == -EAGAIN) {
+			invalid = 0;
+			ret = cam31_mcu_cmd(client, CMD_ID_SET_ACK_RESPONSE_MODE,
+					    NULL, 0, NULL, 0);
+			if (ret)
+				return ret;
+		} else {
+			if (ret)
+				return ret;
+			if (!status[0])
+				return -ENODEV;
+			if (status[1] && status[2])
+				return 0;
+			invalid++;
+		}
+		msleep(200);
+	}
+	/* Require consecutive valid replies after allowing startup to settle. */
+	return invalid >= 2 ? -ENODATA : -EAGAIN;
+}
+
+static int cam31_power_on(struct cam31_dev *cam)
+{
+	struct i2c_client *client = cam->client;
+	const struct firmware *fw;
+	const char *fw_name = "cam31_isp_fw.bin";
+	u8 version[32];
+	int ret;
+
+	ret = cam31_start_isp(client);
+	if (ret)
+		return ret;
+	ret = cam31_check_isp(client);
+	if (ret == -ENODATA) {
+		of_property_read_string(client->dev.of_node, "isp_fw_name", &fw_name);
+		ret = request_firmware(&fw, fw_name, &client->dev);
+		if (ret)
+			return ret;
+		dev_info(&client->dev, "Invalid ISP bootdata; recovering from %s\n", fw_name);
+		ret = isp_flash_bootdata(client, fw->data, fw->size);
+		release_firmware(fw);
+		if (ret)
+			return ret;
+
+		/* Restart and verify boot without retrying the erase/write cycle. */
+		ret = mcu_pulse_reset(client);
+		if (ret)
+			return ret;
+		msleep(50);
+		mcu_bootloader_go(client, FLASH_START_ADDRESS);
+		msleep(1000);
+		ret = cam31_start_isp(client);
+		if (ret)
+			return ret;
+		ret = cam31_check_isp(client);
+		if (ret)
+			return ret;
+		dev_info(&client->dev, "CAM31 ISP firmware recovered; boot verified\n");
+	} else {
+		if (ret)
+			return ret;
+		dev_info(&client->dev, "CAM31 ISP bootdata valid; skipping firmware write\n");
+	}
+
+	/* A version-query failure must never trigger erasure of healthy bootdata. */
+	ret = cam31_mcu_cmd(client, CMD_ID_VERSION_ISP, NULL, 0, version, sizeof(version));
+	if (ret)
+		dev_warn(&client->dev, "CAM31 ISP version unavailable: %d\n", ret);
+	else
+		dev_info(&client->dev, "CAM31 ISP version %.32s\n", version);
+	return 0;
+}
+
+static u32 cam31_fourcc_to_mbus(u32 fourcc)
+{
+	switch (fourcc) {
+	case V4L2_PIX_FMT_UYVY:
+		return MEDIA_BUS_FMT_UYVY8_1X16;
+	case V4L2_PIX_FMT_YUYV:
+		return MEDIA_BUS_FMT_YUYV8_1X16;
+	case V4L2_PIX_FMT_SGRBG10:
+		return MEDIA_BUS_FMT_SGRBG10_1X10;
+	case V4L2_PIX_FMT_SRGGB10:
+		return MEDIA_BUS_FMT_SRGGB10_1X10;
+	default:
+		return MEDIA_BUS_FMT_UYVY8_1X16;
+	}
+}
+
+static int cam31_query_stream_info(struct cam31_dev *cam)
+{
+	u8 tx_payload[2];
+	u8 rx_buf[16];
+	u16 index = 0;
+	int ret;
+
+	while (index < MAX_SUPPORTED_MODES) {
+		tx_payload[0] = (index >> 8) & 0xff;
+		tx_payload[1] = index & 0xff;
+		ret = cam31_mcu_cmd(cam->client, CMD_ID_GET_STREAM_INFO, tx_payload, 2, rx_buf, sizeof(rx_buf));
+		if (ret)
+			break;
+
+		cam->modes[index].fourcc = (rx_buf[0] << 24) | (rx_buf[1] << 16) | (rx_buf[2] << 8) | rx_buf[3];
+		cam->modes[index].code = cam31_fourcc_to_mbus(cam->modes[index].fourcc);
+		cam->modes[index].width = (rx_buf[4] << 8) | rx_buf[5];
+		cam->modes[index].height = (rx_buf[6] << 8) | rx_buf[7];
+
+		if (rx_buf[8] == 0x01) {
+			cam->modes[index].fps_num = (rx_buf[9] << 8) | rx_buf[10];
+			cam->modes[index].fps_denom = (rx_buf[11] << 8) | rx_buf[12];
+		}
+
+#ifdef DEBUG
+		dev_info(&cam->client->dev, "mode[%d]: %dx%d FOURCC: 0x%08x @ %d/%d FPS\n",
+			 index, cam->modes[index].width, cam->modes[index].height,
+			 cam->modes[index].fourcc, cam->modes[index].fps_num, cam->modes[index].fps_denom);
+#endif
+		index++;
+	}
+
+	if (index > 0) {
+		cam->num_modes = index;
+	} else {
+		cam->num_modes = 1;
+		cam->modes[0].width = 1920;
+		cam->modes[0].height = 1536;
+		cam->modes[0].fourcc = V4L2_PIX_FMT_UYVY;
+		cam->modes[0].code = MEDIA_BUS_FMT_UYVY8_1X16;
+		cam->modes[0].fps_num = 1;
+		cam->modes[0].fps_denom = 30;
+	}
+	return 0;
+}
+
+static int cam31_load_mcu_firmware(struct cam31_dev *cam)
+{
+	struct i2c_client *client = cam->client;
+	const struct firmware *fw;
+	const char *fw_name = "cam31_mcu_fw.bin";
+	u8 version[32];
+	int ret;
+
+	ret = cam31_mcu_cmd(client, CMD_ID_VERSION, NULL, 0, version, sizeof(version));
+	if (!ret)
+		goto ready;
+	/* Do not treat malformed application replies as missing firmware. */
+	if (ret == -EBADMSG || ret == -EMSGSIZE || ret == -EAGAIN)
+		return ret;
+	ret = mcu_bootloader_check(client);
+	if (ret)
+		return ret;
+
+	/* A valid application can remain in the ROM after a previous reset. */
+	ret = mcu_bootloader_go(client, FLASH_START_ADDRESS);
+	if (!ret) {
+		msleep(1000);
+		ret = cam31_mcu_cmd(client, CMD_ID_VERSION, NULL, 0, version, sizeof(version));
+		if (!ret)
+			goto ready;
+	}
+	ret = mcu_bootloader_check(client);
+	if (ret)
+		return ret;
+	of_property_read_string(client->dev.of_node, "mcu_fw_name", &fw_name);
+	ret = request_firmware(&fw, fw_name, &client->dev);
+	if (ret)
+		return ret;
+	dev_info(&client->dev, "Recovering CAM31 MCU application from %s\n", fw_name);
+	ret = mcu_flash_intel_hex(client, fw->data, fw->size);
+	release_firmware(fw);
+	if (ret)
+		return ret;
+	msleep(1000);
+	ret = cam31_mcu_cmd(client, CMD_ID_VERSION, NULL, 0, version, sizeof(version));
+	if (ret)
+		return ret;
+ready:
+	dev_info(&client->dev, "CAM31 MCU firmware version %.32s\n", version);
+	return 0;
+}
+
+/* -----------------------------------------------------------------------------
+ * Deferred Work Initialization
+ * -----------------------------------------------------------------------------
+ */
+
+static void cam31_init_work(struct work_struct *work)
+{
+	struct cam31_dev *cam = container_of(work, struct cam31_dev, init_work.work);
+	struct i2c_client *client = cam->client;
+	struct device *dev = &client->dev;
+	int ret;
+
+	if (cam->initialized)
+		return;
+
+	/* Allow the other links on this deserializer to initialize. */
+	msleep(1000);
+#ifdef CAM31_INIT_GPIOS
+	ret = cam31_init_gpios(client);
+	if (ret)
+		goto init_failed;
+	ret = mcu_pulse_reset(client);
+	if (ret)
+		goto init_failed;
+#endif
+	msleep(50);
+	/* Start the existing application if reset left the MCU in the ROM. */
+	mcu_bootloader_go(client, FLASH_START_ADDRESS);
+	msleep(200);
+
+	ret = cam31_load_mcu_firmware(cam);
+	if (ret) {
+		dev_err(dev, "Failed to load firmware: %d\n", ret);
+		return;
+	}
+
+	ret = cam31_power_on(cam);
+	if (ret) {
+		dev_err(dev, "Failed to power on MCU/camera: %d\n", ret);
+		return;
+	}
+
+	ret = cam31_query_stream_info(cam);
+	if (ret) {
+		dev_err(dev, "Failed to query stream modes: %d\n", ret);
+		return;
+	}
+
+	cam->initialized = true;
+	ret = cam31_init_controls(cam);
+	if (ret) {
+		dev_err(dev, "Failed to initialize controls: %d\n", ret);
+		return;
+	}
+
+	dev_info(dev, "CAM31 (Sony ISX031 via MCU) deferred init complete\n");
+	return;
+
+init_failed:
+	dev_err(dev, "Cannot reset CAM31 MCU: %d\n", ret);
+}
+
+/* -----------------------------------------------------------------------------
+ * Driver Probe & Remove
+ * -----------------------------------------------------------------------------
+ */
+
+static int cam31_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct cam31_dev *cam;
+	int ret;
+
+	cam = devm_kzalloc(dev, sizeof(*cam), GFP_KERNEL);
+	if (!cam)
+		return -ENOMEM;
+
+	cam->client = client;
+	cam->current_mode = 0;
+	mutex_init(&cam->lock);
+
+	INIT_DELAYED_WORK(&cam->init_work, cam31_init_work);
+
+	/* Initialize fallback default mode before async query */
+	cam->num_modes = 1;
+	cam->modes[0].width = 1920;
+	cam->modes[0].height = 1536;
+	cam->modes[0].fourcc = V4L2_PIX_FMT_UYVY;
+	cam->modes[0].code = MEDIA_BUS_FMT_UYVY8_1X16;
+	cam->modes[0].fps_num = 1;
+	cam->modes[0].fps_denom = 30;
+
+	v4l2_i2c_subdev_init(&cam->sd, client, &cam31_subdev_ops);
+	cam->sd.internal_ops = &cam31_internal_ops;
+	cam->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	cam->pad.flags = MEDIA_PAD_FL_SOURCE;
+	cam->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+
+	ret = media_entity_pads_init(&cam->sd.entity, 1, &cam->pad);
+	if (ret)
+		goto err_mutex_cleanup;
+
+	ret = v4l2_subdev_init_finalize(&cam->sd);
+	if (ret)
+		goto err_entity_cleanup;
+
+        v4l2_ctrl_handler_init(&cam->ctrls, MCU_MAX_CONTROLS);
+        cam->sd.ctrl_handler = &cam->ctrls;
+        ret = v4l2_async_register_subdev(&cam->sd);
+	if (ret) {
+		dev_err(dev, "v4l2_async_register_subdev failed: %d\n", ret);
+		goto err_subdev_cleanup;
+	}
+
+	dev_info(dev, "CAM31 driver probed successfully (awaiting link lock)\n");
+	return 0;
+
+err_subdev_cleanup:
+	v4l2_subdev_cleanup(&cam->sd);
+err_entity_cleanup:
+	media_entity_cleanup(&cam->sd.entity);
+err_mutex_cleanup:
+	mutex_destroy(&cam->lock);
+	return ret;
+}
+
+static void cam31_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct cam31_dev *cam = to_cam31_dev(sd);
+
+	cancel_delayed_work_sync(&cam->init_work);
+
+        v4l2_async_unregister_subdev(sd);
+
+	if (cam->initialized) {
+		v4l2_ctrl_handler_free(&cam->ctrls);
+		cam31_mcu_cmd(cam->client, CMD_ID_DE_INIT_CAM, NULL, 0, NULL, 0);
+	}
+
+	media_entity_cleanup(&sd->entity);
+	mutex_destroy(&cam->lock);
+}
+
+static const struct of_device_id cam31_of_match[] = {
+	{ .compatible = "econ,cam31" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, cam31_of_match);
+
+static struct i2c_driver cam31_i2c_driver = {
+	.driver = {
+		.name = "econ-cam31",
+		.of_match_table = cam31_of_match,
+	},
+	.probe = cam31_probe,
+	.remove = cam31_remove,
+};
+
+module_i2c_driver(cam31_i2c_driver);
+
+MODULE_DESCRIPTION("Mainline Linux V4L2 Subdevice Driver for e-Con STURDeCAM31");
+MODULE_AUTHOR("System Developer");
+MODULE_LICENSE("GPL");
diff --git a/drivers/media/i2c/econ-cam57.c b/drivers/media/i2c/econ-cam57.c
new file mode 100644
index 000000000000..b6a529e491a9
--- /dev/null
+++ b/drivers/media/i2c/econ-cam57.c
@@ -0,0 +1,2608 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Driver for eCon STURDeCAM57 containing oax4000 ISP connected to OmniVision ox05b1s sensor.
+ */
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/regmap.h>
+#include <linux/workqueue.h>
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-event.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+#include <media/mipi-csi2.h>
+#include <linux/firmware.h>
+
+/* Custom V4L2 Control CIDs for OAX4000 Dual RGB-IR ISP */
+#define V4L2_CID_CUSTOM_BASE                    (V4L2_CID_USER_BASE + 0x1000)
+
+#define V4L2_CID_CUSTOM_EXPOSURE_AUTO_IR        (V4L2_CID_CUSTOM_BASE + 1)
+#define V4L2_CID_CUSTOM_EXPOSURE_ABSOLUTE_IR    (V4L2_CID_CUSTOM_BASE + 2)
+#define V4L2_CID_CUSTOM_GAIN_IR                 (V4L2_CID_CUSTOM_BASE + 3)
+#define V4L2_CID_CUSTOM_MODE_SELECT             (V4L2_CID_CUSTOM_BASE + 4)
+#define V4L2_CID_CUSTOM_FSYNC_ENABLE            (V4L2_CID_CUSTOM_BASE + 5)
+
+#define CAM57_NUM_STREAMS  2   /* Stream 0: VC0 (RGB), Stream 1: VC1 (IR) */
+
+#define CAM57_FIRMWARE_NAME "cam57_isp_fw.bin"
+
+/* OAX4000 Serial Flash / SRAM Host Commands from oax4000.h */
+#define CMD_SERIAL_FLASH_PROTECT	 0x30
+#define CMD_SERIAL_FLASH_ERASE           0x31
+#define CMD_SERIAL_FLASH_PAGE_PROGRAM    0x32
+#define CMD_SERIAL_FLASH_READ		 0x33
+#define CMD_SERIAL_FLASH_STA_GET         0x35
+#define OAX4000_SET_RESOLUTION           0x1a
+
+/*
+ * Interface directly to serializer via I2C to eliminate reset-gpios DT dependency
+ * from aborting sensor probe.
+ *
+ * Note that SER_ADDR is the translated serializer address on the top-level
+ * I2C bus and will change if the device-tree is modified.
+ */
+#define SER_ADDR          0x66
+#define SER_REG_RESET     0x2ca  /* ISP reset pin connected to GPIO4 */
+#define SER_GPIO_OUT_MASK 0x11   /* Bit#0 to disable output, Bit#4 select high/low */
+#define SER_GPIO_LOW      0x00
+#define SER_GPIO_HIGH     0x10
+#define SER_GPIO_CFG_MASK 0xe0   /* Bit#5,6,7 to enable push-pull and pullup resistor */
+#define SER_GPIO_PP       0xa0
+
+#define MAX_RETRY_CNT     5
+
+/*
+ * OAX4000 Boot loader.
+ */
+uint8_t BOOT_FW[] = {
+	0x4f, 0x56, 0x54, 0x49, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
