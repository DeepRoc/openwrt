--- /dev/null
+++ b/drivers/media/i2c/econ-cam57.c
@@ -0,0 +1,920 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Driver for eCon STURDeCAM57 containing oax4000 ISP connected to OmniVision ox05b1s sensor.
+ */
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/regmap.h>
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+#include <media/mipi-csi2.h>
+
+/* Custom V4L2 Control CIDs for OAX4000 Dual RGB-IR ISP */
+#define V4L2_CID_CUSTOM_BASE                    (V4L2_CID_USER_BASE + 0x1000)
+
+#define V4L2_CID_CUSTOM_EXPOSURE_AUTO_IR        (V4L2_CID_CUSTOM_BASE + 1)
+#define V4L2_CID_CUSTOM_EXPOSURE_ABSOLUTE_IR    (V4L2_CID_CUSTOM_BASE + 2)
+#define V4L2_CID_CUSTOM_GAIN_IR                 (V4L2_CID_CUSTOM_BASE + 3)
+#define V4L2_CID_CUSTOM_MODE_SELECT             (V4L2_CID_CUSTOM_BASE + 4)
+#define V4L2_CID_CUSTOM_FSYNC_ENABLE            (V4L2_CID_CUSTOM_BASE + 5)
+
+#define CAM57_NUM_STREAMS  2   /* Stream 0: VC0 (RGB), Stream 1: VC1 (IR) */
+
+struct cam57_mode {
+	u32 width;
+	u32 height;
+	u32 code;
+	const struct reg_sequence *reg_list;
+	unsigned int num_regs;
+};
+
+struct cam57_dev {
+	struct i2c_client *client;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct regmap *regmap;
+	
+	/* Hardware Control Lines */
+	struct gpio_desc *reset_gpio; /* Controls MFP4 on MAX96717 */
+	struct i2c_client *i2c_switch; /* Client handle for 0x70 switch if needed */
+	
+	struct v4l2_ctrl_handler ctrls;
+	const struct cam57_mode *cur_mode;
+	u16 gain, gain_ir;
+	bool streaming;
+};
+
+static inline struct cam57_dev *to_cam57(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct cam57_dev, sd);
+}
+
+#define OAX4000_MAILBOX_BASE    0x3000
+#define OAX4000_CMD_TRIGGER_REG 0x80BC
+#define OAX4000_CMD_STATUS_REG  0x80BD
+#define OAX4000_CMD_SUCCESS     0x00
+#define OAX4000_CMD_TIMEOUT_MS  100
+
+static int oax4000_check_cmd_status(struct cam57_dev *sensor)
+{
+	unsigned int val;
+	int ret;
+	unsigned long timeout = jiffies + msecs_to_jiffies(OAX4000_CMD_TIMEOUT_MS);
+
+	do {
+		ret = regmap_read(sensor->regmap, OAX4000_CMD_STATUS_REG, &val);
+		if (ret)
+			return ret;
+
+		if (val == OAX4000_CMD_SUCCESS)
+			return 0;
+
+		usleep_range(500, 1000);
+	} while (time_before(jiffies, timeout));
+
+	dev_err(&sensor->client->dev, "OAX4000 status check timeout (0x%02x)\n", val);
+	return -ETIMEDOUT;
+}
+
+/**
+ * oax4000_send_mailbox_cmd() - Send dynamic-length payload to OAX4000 mailbox
+ * @sensor: Pointer to driver device instance
+ * @msg_data: Map of byte offsets to values (starting at offset 0x3000)
+ * @total_len: Total bytes to write to the mailbox array
+ */
+static int oax4000_send_mailbox_cmd(struct cam57_dev *sensor, const u8 *msg_data, size_t total_len)
+{
+	int ret, i;
+
+	if (!msg_data || total_len == 0)
+		return -EINVAL;
+
+	/* Write payload bytes sequentially starting at Mailbox 0x3000 */
+	for (i = 0; i < total_len; i++) {
+		ret = regmap_write(sensor->regmap, OAX4000_MAILBOX_BASE + i, msg_data[i]);
+		if (ret) {
+			dev_err(&sensor->client->dev, "Mailbox write failed at offset 0x%04x: %d\n",
+				OAX4000_MAILBOX_BASE + i, ret);
+			return ret;
+		}
+	}
+
+	/* Trigger execution via 0x80BC */
+	ret = regmap_write(sensor->regmap, OAX4000_CMD_TRIGGER_REG, 0x01);
+	if (ret)
+		return ret;
+
+	return oax4000_check_cmd_status(sensor);
+}
+
+static int cam57_sensor_rw(struct cam57_dev *sensor, u16 reg, u8 *idata, u16 count, bool is_write)
+{
+	u8 buf[12] = {0};
+	int ret, i;
+
+	buf[5]  = 0x05;                        /* Group ID */
+	buf[6]  = is_write ? 0x00 : 0x01;      /* 0 = Write, 1 = Read */
+	buf[8]  = (reg >> 8) & 0xFF;
+	buf[9]  = reg & 0xFF;
+	buf[10] = count & 0xFF;
+	if (is_write && idata)
+		buf[11] = idata[0];
+
+	ret = oax4000_send_mailbox_cmd(sensor, buf, 12);
+	if (ret)
+		return ret;
+
+	/* Read back data payload from 0x3C07 on read commands */
+	if (!is_write && idata) {
+		for (i = 0; i < count; i++) {
+			u32 val;
+			ret = regmap_read(sensor->regmap, 0x3C07 + i, &val);
+			if (ret)
+				return ret;
+			idata[i] = val & 0xFF;
+		}
+	}
+
+	return 0;
+}
+
+/* Helper to write to sensor registers (like 0x0100) via OAX4000 Mailbox */
+static int cam57_sensor_write_reg(struct cam57_dev *sensor, u16 reg, u8 val)
+{
+	return cam57_sensor_rw(sensor, reg, &val, 1, true);
+}
+struct saturation_entry {
+	u8 reg_0cf4[4];
+	u8 reg_0d0e[4];
+};
+
+/* Lookup table for saturation levels 0 through 10 */
+static const struct saturation_entry saturation_lut[11] = {
+	[0]  = { {0x28, 0x28, 0x28, 0x20}, {0x20, 0x20, 0x20, 0x10} },
+	[1]  = { {0x30, 0x30, 0x28, 0x20}, {0x20, 0x20, 0x20, 0x10} },
+	[2]  = { {0x31, 0x31, 0x38, 0x28}, {0x30, 0x30, 0x40, 0x10} },
+	[3]  = { {0x33, 0x33, 0x38, 0x28}, {0x40, 0x38, 0x40, 0x10} },
+	[4]  = { {0x37, 0x37, 0x38, 0x28}, {0x60, 0x50, 0x40, 0x10} },
+	[5]  = { {0x40, 0x40, 0x38, 0x28}, {0x66, 0x58, 0x50, 0x10} },
+	[6]  = { {0x43, 0x43, 0x38, 0x28}, {0x72, 0x66, 0x60, 0x10} },
+	[7]  = { {0x48, 0x38, 0x30, 0x28}, {0x80, 0x80, 0x50, 0x10} },
+	[8]  = { {0x56, 0x56, 0x38, 0x28}, {0xA2, 0x86, 0x60, 0x10} },
+	[9]  = { {0x66, 0x66, 0x48, 0x38}, {0xB2, 0x96, 0x60, 0x10} },
+	[10] = { {0x74, 0x74, 0x48, 0x38}, {0xB2, 0x96, 0x60, 0x10} },
+};
+
+static int cam57_set_saturation(struct cam57_dev *sensor, s32 val)
+{
+	static const u8 init_9644[4] = { 0x00, 0x90, 0x1C, 0x80 };
+	const struct saturation_entry *entry;
+	int ret, i;
+
+	if (val < 0 || val > 10)
+		return -EINVAL;
+
+	/* 1. Write configuration header to 0x9644 */
+	for (i = 0; i < 4; i++) {
+		ret = regmap_write(sensor->regmap, 0x9644 + i, init_9644[i]);
+		if (ret)
+			return ret;
+	}
+
+	entry = &saturation_lut[val];
+
+	/* 2. Write 0x0CF4 register array (stride = 2) */
+	for (i = 0; i < 4; i++) {
+		ret = regmap_write(sensor->regmap, 0x0CF4 + (i * 2), entry->reg_0cf4[i]);
+		if (ret)
+			return ret;
+	}
+
+	/* 3. Write 0x0D0E register array (sequential) */
+	for (i = 0; i < 4; i++) {
+		ret = regmap_write(sensor->regmap, 0x0D0E + i, entry->reg_0d0e[i]);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int cam57_set_sharpness(struct cam57_dev *sensor, s32 val)
+{
+	u8 buf[8] = {0};
+
+	if (val < 0 || val > 255)
+		return -EINVAL;
+
+	buf[3] = 0x43;
+	buf[5] = 0x05;
+	buf[6] = 0x10;
+	buf[7] = val & 0xFF;
+
+	return oax4000_send_mailbox_cmd(sensor, buf, sizeof(buf));
+}
+
+static int cam57_set_contrast(struct cam57_dev *sensor, s32 val)
+{
+	u8 buf[9] = {0};
+
+	if (val < 0 || val > 255)
+		return -EINVAL;
+
+	buf[3] = 0x4D;
+	buf[5] = 0x09;
+	buf[6] = 0x10;
+	buf[7] = 0x0A;
+	buf[8] = 0x00;
+
+	return oax4000_send_mailbox_cmd(sensor, buf, sizeof(buf));
+}
+
+static int cam57_set_brightness(struct cam57_dev *sensor, u8 brightness)
+{
+	u8 buf[9] = {0};
+
+	buf[3] = 0x40;
+	buf[5] = 0x06;
+	buf[6] = 0x10;
+	buf[8] = brightness;
+
+	return oax4000_send_mailbox_cmd(sensor, buf, sizeof(buf));
+}
+
+static int cam57_set_exposure_rgb(struct cam57_dev *sensor, bool auto_exp, u16 exp_val, u16 gain_val)
+{
+	u8 buf[24] = {0};
+
+	buf[3] = 0x44;
+	buf[5] = 0x45;
+	buf[6] = 0x10;
+	buf[7] = auto_exp ? 0x00 : 0x01;
+
+	if (!auto_exp) {
+		/* Populate 4 exposure registers (16-bit) */
+		buf[8]  = buf[10] = buf[12] = buf[14] = (exp_val >> 8) & 0xFF;
+		buf[9]  = buf[11] = buf[13] = buf[15] = exp_val & 0xFF;
+		/* Populate 4 gain registers (16-bit) */
+		buf[16] = buf[18] = buf[20] = buf[22] = (gain_val >> 8) & 0xFF;
+		buf[17] = buf[19] = buf[21] = buf[23] = gain_val & 0xFF;
+	}
+
+	return oax4000_send_mailbox_cmd(sensor, buf, auto_exp ? 8 : sizeof(buf));
+}
+
+static int cam57_set_exposure_ir(struct cam57_dev *sensor, bool auto_exp, u16 exp_val, u16 gain_val)
+{
+	u8 buf[75] = {0};
+
+	buf[3] = 0x44;
+	buf[5] = 0x45;
+	buf[6] = 0x80;
+	buf[7] = 0x00;
+
+	if (!auto_exp) {
+		buf[58] = 0x01;
+		/* Populate IR exposure parameters */
+		buf[59] = buf[61] = buf[63] = buf[65] = (exp_val >> 8) & 0xFF;
+		buf[60] = buf[62] = buf[64] = buf[66] = exp_val & 0xFF;
+		/* Populate IR gain parameters */
+		buf[67] = buf[69] = buf[71] = buf[73] = (gain_val >> 8) & 0xFF;
+		buf[68] = buf[70] = buf[72] = buf[74] = gain_val & 0xFF;
+	}
+
+	return oax4000_send_mailbox_cmd(sensor, buf, auto_exp ? 8 : sizeof(buf));
+}
+
+static int cam57_set_power_line_freq(struct cam57_dev *sensor, u8 freq_mode)
+{
+	u8 buf[7] = {0};
+
+	buf[3] = 0x54;
+	buf[5] = 0x01;
+	buf[6] = (freq_mode == 2) ? 0x33 : 0x30; /* 2 = 60Hz (0x33), 1 = 50Hz (0x30) */
+
+	return oax4000_send_mailbox_cmd(sensor, buf, sizeof(buf));
+}
+
+static int cam57_set_hflip(struct cam57_dev *sensor, s32 val)
+{
+	u8 reg_val = 0;
+	int ret;
+
+	/* 1. Read existing value of sensor register 0x3013 */
+	ret = cam57_sensor_rw(sensor, 0x3013, &reg_val, 1, false);
+	if (ret)
+		return ret;
+
+	/* 2. Modify Bit 0 */
+	if (val)
+		reg_val |= BIT(0);
+	else
+		reg_val &= ~BIT(0);
+
+	/* 3. Write back to sensor register 0x3013 */
+	return cam57_sensor_rw(sensor, 0x3013, &reg_val, 1, true);
+}
+
+static int cam57_set_vflip(struct cam57_dev *sensor, s32 val)
+{
+	u8 reg_val = 0;
+	int ret;
+
+	/* 1. Read existing value of sensor register 0x3012 */
+	ret = cam57_sensor_rw(sensor, 0x3012, &reg_val, 1, false);
+	if (ret)
+		return ret;
+
+	/* 2. Modify Bit 0 */
+	if (val)
+		reg_val |= BIT(0);
+	else
+		reg_val &= ~BIT(0);
+
+	/* 3. Write back to sensor register 0x3012 */
+	return cam57_sensor_rw(sensor, 0x3012, &reg_val, 1, true);
+}
+
+/* -----------------------------------------------------------------------------
+ * Hardware Initialization Sequence (Replacing Vendor Sysfs Hooks)
+ * -----------------------------------------------------------------------------
+ */
+#define MODULE_I2C_SWITCH_ADDR  0x70
+#define TWO_CHANNELS            0x03
+
+static int cam57_enable_i2c_switch(struct i2c_client *client)
+{
+	struct i2c_adapter *adap = client->adapter;
+	u8 both = TWO_CHANNELS;
+	struct i2c_msg msg = {
+            .addr = MODULE_I2C_SWITCH_ADDR,
+            .flags = 0,
+            .len = 1,
+            .buf = &both,
+        };
+	int ret = 0, retry;
+
+        for (retry = 0; retry < 10; retry++) {
+		ret = i2c_transfer(adap, &msg, 1);
+		if (ret >= 0)
+			return 0;
+		usleep_range(2000, 3000);
+	}
+	dev_err(&client->dev, "Failed to enable I2C switch @ 0x%02x: %d\n",
+		MODULE_I2C_SWITCH_ADDR, ret);
+	return ret;
+}
+
+static int oax4000_power_on(struct cam57_dev *sensor)
+{
+	struct device *dev = &sensor->client->dev;
+
+	if (sensor->reset_gpio) {
+		dev_info(dev, "Pulsing MFP4 reset line for OAX4000 ISP...\n");
+		
+		/* Drive MFP4 LOW (Assert ISP Reset) */
+		gpiod_set_value_cansleep(sensor->reset_gpio, 1);
+		msleep(50);
+
+		/* Drive MFP4 HIGH (Release ISP Reset) */
+		gpiod_set_value_cansleep(sensor->reset_gpio, 0);
+		msleep(200); /* Wait for OAX4000 ROM bootloader to start */
+	}
+
+	return 0;
+}
+
+static int oax4000_power_off(struct cam57_dev *sensor)
+{
+	if (sensor->reset_gpio)
+		gpiod_set_value_cansleep(sensor->reset_gpio, 1);
+
+	return 0;
+}
+
+/* -----------------------------------------------------------------------------
+ * V4L2 Subdev Operations
+ * -----------------------------------------------------------------------------
+ */
+
+static int cam57_s_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct cam57_dev *sensor = to_cam57(sd);
+	int ret = 0;
+
+	if (sensor->streaming == enable)
+		return 0;
+
+	if (enable) {
+		/* Wakeup / Stream Start command to CAM57 ISP */
+		ret = regmap_write(sensor->regmap, 0x0100, 0x01);
+		if (ret)
+			return ret;
+		sensor->streaming = true;
+	} else {
+		/* Sleep / Stream Stop command to CAM57 ISP */
+		regmap_write(sensor->regmap, 0x0100, 0x00);
+		sensor->streaming = false;
+	}
+
+	return 0;
+}
+
+static int cam57_enum_frame_size(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *sd_state,
+				   struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index > 0)
+		return -EINVAL;
+
+	if (fse->code != MEDIA_BUS_FMT_YUYV8_1X16)
+		return -EINVAL;
+
+	fse->min_width = 2592;
+	fse->max_width = 2592;
+	fse->min_height = 1946;
+	fse->max_height = 1946;
+
+	return 0;
+}
+
+
+static int cam57_get_fmt(struct v4l2_subdev *sd,
+			 struct v4l2_subdev_state *sd_state,
+			 struct v4l2_subdev_format *fmt)
+{
+	struct v4l2_mbus_framefmt *mbus_fmt;
+
+	mbus_fmt = v4l2_subdev_state_get_format(sd_state, fmt->pad, fmt->stream);
+	if (!mbus_fmt)
+		mbus_fmt = v4l2_subdev_state_get_format(sd_state, fmt->pad, 0);
+	if (!mbus_fmt) {
+		/* Return hardcoded default format if state format pointer is NULL */
+		fmt->format.code = MEDIA_BUS_FMT_UYVY8_1X16;
+		fmt->format.width = 2592;
+		fmt->format.height = 1946;
+		fmt->format.field = V4L2_FIELD_NONE;
+		fmt->format.colorspace = V4L2_COLORSPACE_SRGB;
+		return 0;
+	}
+	mbus_fmt->code = MEDIA_BUS_FMT_YUYV8_1X16;
+	mbus_fmt->width = 2592;
+	mbus_fmt->height = 1946;
+	mbus_fmt->field = V4L2_FIELD_NONE;
+	mbus_fmt->colorspace = V4L2_COLORSPACE_SRGB;
+	fmt->format = *mbus_fmt;
+	return 0;
+}
+
+static const u32 cam57_mbus_codes[] = {
+	MEDIA_BUS_FMT_UYVY8_1X16, /* UYVY 4:2:2 8-bit */
+};
+
+static int cam57_enum_mbus_code(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index >= ARRAY_SIZE(cam57_mbus_codes))
+		return -EINVAL;
+
+	/* Set the UYVY bus format code */
+	code->code = cam57_mbus_codes[code->index];
+	return 0;
+}
+
+static int cam57_get_frame_desc(struct v4l2_subdev *sd, unsigned int pad,
+				struct v4l2_mbus_frame_desc *fd)
+{
+	struct v4l2_subdev_state *state;
+	struct v4l2_subdev_route *route;
+	struct v4l2_mbus_framefmt *fmt;
+
+	if (pad != 0)
+		return -EINVAL;
+
+	memset(fd, 0, sizeof(*fd));
+	fd->type = V4L2_MBUS_FRAME_DESC_TYPE_CSI2;
+
+	state = v4l2_subdev_lock_and_get_active_state(sd);
+
+	/* Iterate through active state routes (0/0 -> 0/0 and 0/1 -> 0/1) */
+	for_each_active_route(&state->routing, route) {
+		if (route->source_pad != pad)
+			continue;
+
+		if (fd->num_entries >= V4L2_FRAME_DESC_ENTRY_MAX)
+			break;
+
+		fmt = v4l2_subdev_state_get_format(state, pad, route->source_stream);
+
+		fd->entry[fd->num_entries] = (struct v4l2_mbus_frame_desc_entry){
+			.stream = route->source_stream,
+			.flags = V4L2_MBUS_FRAME_DESC_FL_LEN_MAX,
+			.pixelcode = fmt ? fmt->code : MEDIA_BUS_FMT_UYVY8_1X16,
+			.bus.csi2 = {
+				.vc = route->source_stream, /* VC0 for Stream 0, VC1 for Stream 1 */
+				.dt = MIPI_CSI2_DT_YUV422_8B,
+			},
+		};
+		fd->num_entries++;
+	}
+
+	v4l2_subdev_unlock_state(state);
+
+	/* Fallback if no routes are populated in state yet */
+	if (fd->num_entries == 0) {
+		fd->num_entries = 1;
+		fd->entry[0].stream = 0;
+		fd->entry[0].pixelcode = MEDIA_BUS_FMT_UYVY8_1X16;
+		fd->entry[0].bus.csi2.vc = 0;
+		fd->entry[0].bus.csi2.dt = MIPI_CSI2_DT_YUV422_8B;
+	}
+
+	return 0;
+}
+
+static int cam57_set_fmt(struct v4l2_subdev *sd,
+			   struct v4l2_subdev_state *sd_state,
+			   struct v4l2_subdev_format *fmt)
+{
+	struct v4l2_mbus_framefmt *mbus_fmt;
+
+	mbus_fmt = v4l2_subdev_state_get_format(sd_state, fmt->pad);
+	if (!mbus_fmt)
+		return -EINVAL;
+
+	mbus_fmt->code = MEDIA_BUS_FMT_YUYV8_1X16;
+	mbus_fmt->width = 2592;
+	mbus_fmt->height = 1946;
+	mbus_fmt->field = V4L2_FIELD_NONE;
+	mbus_fmt->colorspace = V4L2_COLORSPACE_SRGB;
+
+	fmt->format = *mbus_fmt;
+	return 0;
+}
+
+static int cam57_enable_streams(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				u32 pad, u64 streams_mask)
+{
+	struct cam57_dev *sensor = to_cam57(sd);
+	int ret = 0;
+
+	if (!sensor->streaming) {
+		ret = cam57_sensor_write_reg(sensor, 0x0100, 0x01);
+		if (ret) {
+                    dev_err(sd->dev, "Failed to start stream on 0x0100: %d\n", ret);
+                    return ret;
+		}
+		sensor->streaming = true;
+	}
+
+	return 0;
+}
+
+static int cam57_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  u32 pad, u64 streams_mask)
+{
+	struct cam57_dev *sensor = to_cam57(sd);
+
+	if (sensor->streaming) {
+		cam57_sensor_write_reg(sensor, 0x0100, 0x00);
+		sensor->streaming = false;
+	}
+
+	return 0;
+}
+
+static const struct v4l2_mbus_framefmt cam57_def_fmt = {
+	.width = 2592,
+	.height = 1946,
+	.code = MEDIA_BUS_FMT_YUYV8_1X16,
+	.field = V4L2_FIELD_NONE,
+	.colorspace = V4L2_COLORSPACE_SRGB,
+	.ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT,
+	.quantization = V4L2_QUANTIZATION_DEFAULT,
+	.xfer_func = V4L2_XFER_FUNC_DEFAULT,
+};
+
+static int cam57_init_state(struct v4l2_subdev *sd,
+			      struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_route routes[] = {
+		{
+			.sink_pad = 0,
+			.sink_stream = 0,
+			.source_pad = 0,
+			.source_stream = 0,
+			.flags = V4L2_SUBDEV_ROUTE_FL_ACTIVE,
+		},
+		{
+			.sink_pad = 0,
+			.sink_stream = 1,
+			.source_pad = 0,
+			.source_stream = 1,
+			.flags = V4L2_SUBDEV_ROUTE_FL_ACTIVE,
+		},
+	};
+	struct v4l2_subdev_krouting routing = {
+		.num_routes = ARRAY_SIZE(routes),
+		.routes = routes,
+	};
+
+	return v4l2_subdev_set_routing_with_fmt(sd, state, &routing,
+						&cam57_def_fmt);
+}
+
+static int cam57_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct cam57_dev *sensor =
+		container_of(ctrl->handler, struct cam57_dev, ctrls);
+	int ret = 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_SATURATION:
+		ret = cam57_set_saturation(sensor, ctrl->val);
+		break;
+	case V4L2_CID_SHARPNESS:
+		ret = cam57_set_sharpness(sensor, ctrl->val);
+		break;
+	case V4L2_CID_CONTRAST:
+		ret = cam57_set_contrast(sensor, ctrl->val);
+		break;
+	case V4L2_CID_BRIGHTNESS:
+		ret = cam57_set_brightness(sensor, ctrl->val);
+		break;
+	case V4L2_CID_EXPOSURE_AUTO:
+		ret = cam57_set_exposure_rgb(sensor, true, 0, 0);
+		break;
+	case V4L2_CID_EXPOSURE_ABSOLUTE:
+		ret = cam57_set_exposure_rgb(sensor, false, ctrl->val, sensor->gain);
+		break;
+	case V4L2_CID_CUSTOM_EXPOSURE_AUTO_IR:
+		ret = cam57_set_exposure_ir(sensor, true, 0, 0);
+		break;
+	case V4L2_CID_CUSTOM_EXPOSURE_ABSOLUTE_IR:
+		ret = cam57_set_exposure_ir(sensor, false, ctrl->val, sensor->gain_ir);
+		break;
+	case V4L2_CID_GAIN:
+		sensor->gain = ctrl->val;
+		break;
+	case V4L2_CID_CUSTOM_GAIN_IR:
+		sensor->gain_ir = ctrl->val;
+		break;
+	case V4L2_CID_POWER_LINE_FREQUENCY:
+		ret = cam57_set_power_line_freq(sensor, ctrl->val);
+		break;
+	case V4L2_CID_HFLIP:
+		ret = cam57_set_hflip(sensor, ctrl->val);
+		break;
+	case V4L2_CID_VFLIP:
+		ret = cam57_set_vflip(sensor, ctrl->val);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops cam57_ctrl_ops = {
+	.s_ctrl = cam57_s_ctrl,
+};
+
+static const struct v4l2_ctrl_config custom_ctrls[] = {
+	{
+		.ops = &cam57_ctrl_ops,
+		.id = V4L2_CID_CUSTOM_EXPOSURE_AUTO_IR,
+		.name = "IR Auto Exposure",
+		.type = V4L2_CTRL_TYPE_BOOLEAN,
+		.min = 0,
+		.max = 1,
+		.step = 1,
+		.def = 1,
+	},
+	{
+		.ops = &cam57_ctrl_ops,
+		.id = V4L2_CID_CUSTOM_EXPOSURE_ABSOLUTE_IR,
+		.name = "IR Exposure Absolute",
+		.type = V4L2_CTRL_TYPE_INTEGER,
+		.min = 1,
+		.max = 0xFFFF,
+		.step = 1,
+		.def = 100,
+	},
+	{
+		.ops = &cam57_ctrl_ops,
+		.id = V4L2_CID_CUSTOM_GAIN_IR,
+		.name = "IR Global Gain",
+		.type = V4L2_CTRL_TYPE_INTEGER,
+		.min = 0,
+		.max = 255,
+		.step = 1,
+		.def = 16,
+	},
+};
+
+static int cam57_init_controls(struct cam57_dev *sensor)
+{
+	struct v4l2_ctrl_handler *hdl = &sensor->ctrls;
+	int i, ret;
+
+	v4l2_ctrl_handler_init(hdl, 12);
+
+	/* Standard V4L2 Camera Controls */
+	v4l2_ctrl_new_std(hdl, &cam57_ctrl_ops, V4L2_CID_SATURATION,
+			  0, 255, 1, 128);
+	v4l2_ctrl_new_std(hdl, &cam57_ctrl_ops, V4L2_CID_SHARPNESS,
+			  0, 255, 1, 128);
+	v4l2_ctrl_new_std(hdl, &cam57_ctrl_ops, V4L2_CID_BRIGHTNESS,
+			  0, 255, 1, 128);
+	v4l2_ctrl_new_std(hdl, &cam57_ctrl_ops, V4L2_CID_CONTRAST,
+			  0, 255, 1, 128);
+	v4l2_ctrl_new_std(hdl, &cam57_ctrl_ops, V4L2_CID_GAIN,
+			  0, 255, 1, 16);
+
+	v4l2_ctrl_new_std_menu(hdl, &cam57_ctrl_ops, V4L2_CID_EXPOSURE_AUTO,
+			       V4L2_EXPOSURE_MANUAL, 0, V4L2_EXPOSURE_AUTO);
+	v4l2_ctrl_new_std(hdl, &cam57_ctrl_ops, V4L2_CID_EXPOSURE_ABSOLUTE,
+			  1, 0xFFFF, 1, 100);
+
+	v4l2_ctrl_new_std_menu(hdl, &cam57_ctrl_ops, V4L2_CID_POWER_LINE_FREQUENCY,
+			       V4L2_CID_POWER_LINE_FREQUENCY_AUTO, 0,
+			       V4L2_CID_POWER_LINE_FREQUENCY_AUTO);
+
+	v4l2_ctrl_new_std(hdl, &cam57_ctrl_ops, V4L2_CID_HFLIP, 0, 1, 1, 0);
+	v4l2_ctrl_new_std(hdl, &cam57_ctrl_ops, V4L2_CID_VFLIP, 0, 1, 1, 0);
+
+	/* Add Custom RGB-IR & FSync Controls */
+	for (i = 0; i < ARRAY_SIZE(custom_ctrls); i++)
+		v4l2_ctrl_new_custom(hdl, &custom_ctrls[i], NULL);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		v4l2_ctrl_handler_free(hdl);
+		return ret;
+	}
+
+	sensor->sd.ctrl_handler = hdl;
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops cam57_video_ops = {
+	.s_stream = cam57_s_stream,
+};
+
+static const struct v4l2_subdev_pad_ops cam57_pad_ops = {
+	.enum_mbus_code = cam57_enum_mbus_code,
+	.enum_frame_size = cam57_enum_frame_size,
+	.get_fmt = cam57_get_fmt,
+	.set_fmt = cam57_set_fmt,
+        .get_frame_desc = cam57_get_frame_desc,
+	.enable_streams = cam57_enable_streams,
+	.disable_streams = cam57_disable_streams,
+};
+
+static const struct v4l2_subdev_ops cam57_subdev_ops = {
+	.video = &cam57_video_ops,
+	.pad = &cam57_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops cam57_internal_ops = {
+	.init_state = cam57_init_state,
+};
+
+/* -----------------------------------------------------------------------------
+ * Driver Probe & Runtime PM
+ * -----------------------------------------------------------------------------
+ */
+
+static const struct regmap_config cam57_regmap_config = {
+	.reg_bits = 16,
+	.val_bits = 8,
+	.max_register = 0xffff,
+};
+
+static int cam57_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct cam57_dev *sensor;
+	struct fwnode_handle *endpoint;
+        struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY
+	};
+        int ret;
+
+        ret = cam57_enable_i2c_switch(client);
+	if (ret)
+		return ret;
+
+	sensor = devm_kzalloc(dev, sizeof(*sensor), GFP_KERNEL);
+	if (!sensor)
+		return -ENOMEM;
+
+	sensor->client  = client;
+	sensor->gain    = 16;
+	sensor->gain_ir = 16;
+
+	endpoint = fwnode_graph_get_endpoint_by_id(dev_fwnode(dev), 0, 0, 0);
+	if (!endpoint) {
+		dev_err(dev, "Failed to find endpoint fwnode in Device Tree\n");
+		return -ENODEV;
+	}
+	dev_info(dev, "found endpoint at %pfwf\n", endpoint);
+
+	ret = v4l2_fwnode_endpoint_parse(endpoint, &bus_cfg);
+	if (ret) {
+		dev_err(dev, "Failed to parse endpoint fwnode: %d\n", ret);
+		return ret;
+	}
+
+	sensor->regmap = devm_regmap_init_i2c(client, &cam57_regmap_config);
+	if (IS_ERR(sensor->regmap))
+		return PTR_ERR(sensor->regmap);
+
+	sensor->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(sensor->reset_gpio)) {
+		ret = dev_err_probe(dev, PTR_ERR(sensor->reset_gpio),
+				    "Failed to get reset GPIO\n");
+		return ret;
+	}
+
+        ret = oax4000_power_on(sensor);
+        if (ret)
+		return ret;
+
+	v4l2_i2c_subdev_init(&sensor->sd, client, &cam57_subdev_ops);
+	sensor->sd.internal_ops = &cam57_internal_ops;
+	sensor->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE | V4L2_SUBDEV_FL_STREAMS;
+	sensor->pad.flags = MEDIA_PAD_FL_SOURCE;
+	sensor->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+
+	ret = cam57_init_controls(sensor);
+        if (ret) {
+		dev_err(dev, "Failed to initialize V4L2 controls: %d\n", ret);
+		goto err_entity_cleanup;
+	}
+
+	/* Bind control handler to subdevice */
+	sensor->sd.ctrl_handler = &sensor->ctrls;
+
+	ret = media_entity_pads_init(&sensor->sd.entity, 1, &sensor->pad);
+	if (ret)
+		goto err_power_off;
+
+	ret = v4l2_subdev_init_finalize(&sensor->sd);
+	if (ret)
+		goto err_power_off;
+
+	ret = v4l2_async_register_subdev(&sensor->sd);
+	if (ret)
+		goto err_subdev_cleanup;
+
+	dev_info(dev, "CAM57 ISP / STURDeCAM57 probed successfully\n");
+	return 0;
+
+err_subdev_cleanup:
+	v4l2_subdev_cleanup(&sensor->sd);
+err_power_off:
+	oax4000_power_off(sensor);
+err_entity_cleanup:
+	media_entity_cleanup(&sensor->sd.entity);
+	return ret;
+}
+
+static void cam57_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct cam57_dev *sensor = to_cam57(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	oax4000_power_off(sensor);
+	media_entity_cleanup(&sd->entity);
+}
+
+static const struct of_device_id cam57_of_match[] = {
+	{ .compatible = "econ,cam57" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, cam57_of_match);
+
+static struct i2c_driver cam57_i2c_driver = {
+	.driver = {
+		.name = "econ-cam57",
+		.of_match_table = cam57_of_match,
+	},
+	.probe = cam57_probe,
+	.remove = cam57_remove,
+};
+module_i2c_driver(cam57_i2c_driver);
