+static int cam57_set_resolution(struct cam57_dev *cam)
+{
+	struct i2c_client *client = cam->client;
+
+	dev_info(&client->dev, "Configuring ISP for %dx%d resolution\n",
+		 cam->current_mode->width, cam->current_mode->height);
+
+	return oax4000_send_mailbox_cmd(cam, cam->current_mode->payload, sizeof(cam->current_mode->payload));
+}
+
+static int cam57_set_saturation(struct cam57_dev *cam, s32 val)
+{
+	static const u8 init_9644[4] = { 0x00, 0x90, 0x1C, 0x80 };
+	const struct saturation_entry *entry;
+	int ret, i;
+
+	if (val < 0 || val > 10)
+		return -EINVAL;
+
+	for (i = 0; i < 4; i++) {
+		ret = regmap_write(cam->regmap, 0x9644 + i, init_9644[i]);
+		if (ret)
+			return ret;
+	}
+
+	entry = &saturation_lut[val];
+
+	for (i = 0; i < 4; i++) {
+		ret = regmap_write(cam->regmap, 0x0CF4 + (i * 2), entry->reg_0cf4[i]);
+		if (ret)
+			return ret;
+	}
+
+	for (i = 0; i < 4; i++) {
+		ret = regmap_write(cam->regmap, 0x0D0E + i, entry->reg_0d0e[i]);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int cam57_set_sharpness(struct cam57_dev *cam, s32 val)
+{
+	u8 buf[8] = {0};
+
+	if (val < 0 || val > 255)
+		return -EINVAL;
+
+	buf[3] = 0x43;
+	buf[5] = 0x05;
+	buf[6] = 0x10;
+	buf[7] = val & 0xFF;
+
+	return oax4000_send_mailbox_cmd(cam, buf, sizeof(buf));
+}
+
+static int cam57_set_contrast(struct cam57_dev *cam, s32 val)
+{
+	u8 buf[9] = {0};
+
+	if (val < 0 || val > 255)
+		return -EINVAL;
+
+	buf[3] = 0x4D;
+	buf[5] = 0x09;
+	buf[6] = 0x10;
+	buf[7] = 0x0A;
+	buf[8] = 0x00;
+
+	return oax4000_send_mailbox_cmd(cam, buf, sizeof(buf));
+}
+
+static int cam57_set_brightness(struct cam57_dev *cam, u8 brightness)
+{
+	u8 buf[9] = {0};
+
+	buf[3] = 0x40;
+	buf[5] = 0x06;
+	buf[6] = 0x10;
+	buf[8] = brightness;
+
+	return oax4000_send_mailbox_cmd(cam, buf, sizeof(buf));
+}
+
+static int cam57_set_exposure_rgb(struct cam57_dev *cam, bool auto_exp, u16 exp_val, u16 gain_val)
+{
+	u8 buf[24] = {0};
+
+	buf[3] = 0x44;
+	buf[5] = 0x45;
+	buf[6] = 0x10;
+	buf[7] = auto_exp ? 0x00 : 0x01;
+
+	if (!auto_exp) {
+		buf[8]  = buf[10] = buf[12] = buf[14] = (exp_val >> 8) & 0xFF;
+		buf[9]  = buf[11] = buf[13] = buf[15] = exp_val & 0xFF;
+		buf[16] = buf[18] = buf[20] = buf[22] = (gain_val >> 8) & 0xFF;
+		buf[17] = buf[19] = buf[21] = buf[23] = gain_val & 0xFF;
+	}
+
+	return oax4000_send_mailbox_cmd(cam, buf, auto_exp ? 8 : sizeof(buf));
+}
+
+static int cam57_set_exposure_ir(struct cam57_dev *cam, bool auto_exp, u16 exp_val, u16 gain_val)
+{
+	u8 buf[75] = {0};
+
+	buf[3] = 0x44;
+	buf[5] = 0x45;
+	buf[6] = 0x80;
+	buf[7] = 0x00;
+
+	if (!auto_exp) {
+		buf[58] = 0x01;
+		buf[59] = buf[61] = buf[63] = buf[65] = (exp_val >> 8) & 0xFF;
+		buf[60] = buf[62] = buf[64] = buf[66] = exp_val & 0xFF;
+		buf[67] = buf[69] = buf[71] = buf[73] = (gain_val >> 8) & 0xFF;
+		buf[68] = buf[70] = buf[72] = buf[74] = gain_val & 0xFF;
+	}
+
+	return oax4000_send_mailbox_cmd(cam, buf, auto_exp ? 8 : sizeof(buf));
+}
+
+static int cam57_set_power_line_freq(struct cam57_dev *cam, u8 freq_mode)
+{
+	u8 buf[7] = {0};
+
+	buf[3] = 0x54;
+	buf[5] = 0x01;
+	buf[6] = (freq_mode == 2) ? 0x33 : 0x30;
+
+	return oax4000_send_mailbox_cmd(cam, buf, sizeof(buf));
+}
+
+static int cam57_set_hflip(struct cam57_dev *cam, s32 val)
+{
+	u8 reg_val = 0;
+	int ret;
+
+	ret = cam57_sensor_rw(cam, 0x3013, &reg_val, 1, false);
+	if (ret)
+		return ret;
+
+	if (val)
+		reg_val |= BIT(0);
+	else
+		reg_val &= ~BIT(0);
+
+	return cam57_sensor_rw(cam, 0x3013, &reg_val, 1, true);
+}
+
+static int cam57_set_vflip(struct cam57_dev *cam, s32 val)
+{
+	u8 reg_val = 0;
+	int ret;
+
+	ret = cam57_sensor_rw(cam, 0x3012, &reg_val, 1, false);
+	if (ret)
+		return ret;
+
+	if (val)
+		reg_val |= BIT(0);
+	else
+		reg_val &= ~BIT(0);
+
+	return cam57_sensor_rw(cam, 0x3012, &reg_val, 1, true);
+}
